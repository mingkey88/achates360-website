---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import { loadExtras } from '../lib/extras';
import { projectCategories } from '../lib/categories';
import { withBase } from '../lib/paths';
import { itemListLd } from '../lib/seo';
import { projectIndex } from '../lib/project-index';
// The projects overview (direction B): every listed project, in the homepage list's order, with the
// categories as filters (each also a link to its own page, /projects/<slug>) and a grid or catalogue view.
// Titles, clients and pictures are the homepage gallery's; category headings the supplied sections', verbatim.
const d = (await getEntry('projectsIndex', 'projects'))!.data;
const site = (await getEntry('site', 'site'))!.data;
const { text } = await loadExtras();
// The page heading is the site menu's own PROJECTS label, verbatim (shown in sentence case).
const heading = site.menu?.find((m) => m.href === '/projects')?.label ?? d.sections[0].heading;
const cats = projectCategories(d.sections);
const home = (await getEntry('home', 'home'))!.data;
const projects = new Map((await getCollection('projects')).map((e) => [e.id, e.data]));
const entries = projectIndex(home.allProjects.items, projects, d.sections);
const abs = (p: string) => new URL(withBase(p), Astro.site).href;
// Structured data: every listed case study, in the homepage list's order.
const jsonLd = [itemListLd('Projects', entries.map((e) => ({ name: projects.get(e.slug)!.title, url: abs(e.href) })))];
const labels = {
  nav: text('nav-categories'), view: text('index-view'), grid: text('view-grid'), catalogue: text('view-catalogue'), count: text('index-count'),
  no: text('col-no'), project: text('col-project'), client: text('col-client'), discipline: text('col-discipline'), year: text('col-year'),
};
// Old /projects#<section> links (Wix's in-page chips) forward to the category page.
const redirects = Object.fromEntries([['top', cats[0].href], ...cats.map((c) => [c.id, c.href])].map(([k, v]) => [k, withBase(v)]));
---
<Base title={d.seo.title} description={d.seo.description} ogImage={d.seo.ogImage} jsonLd={jsonLd} page="projects">
  <script is:inline define:vars={{ redirects }}>
    { const to = redirects[location.hash.slice(1)]; if (to) location.replace(to); }
  </script>
  <header class="wrap pi-head">
    <h1 class="display h1 sc" data-split>{heading}</h1>
    <span class="pi-total" aria-hidden="true">{entries.length}</span>
  </header>
  <section class="wrap pi-body" aria-label={heading}>
    <ProjectIndex entries={entries} categories={cats} all={text('next-fallback')} labels={labels} />
  </section>
</Base>
<style>
  .pi-head { display: flex; align-items: flex-start; gap: var(--s-3); padding-block: var(--s-8) var(--s-5); }
  .pi-head h1 { margin: 0; }
  /* The count sits up by the heading like a folio. */
  .pi-total { padding-top: .4em; font-size: var(--fs-small); font-variant-numeric: tabular-nums; color: var(--text-2); }
  .pi-body { padding-bottom: var(--section-y); }
</style>
<script>
  import { run } from '../scripts/motion/index';
  import { reveal } from '../scripts/motion/reveal';
  import { tilt } from '../scripts/motion/tilt';
  run(reveal, tilt);
</script>
