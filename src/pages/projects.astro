---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CategoryPicker from '../components/CategoryPicker.astro';
import { loadExtras } from '../lib/extras';
import { projectCategories } from '../lib/categories';
import { withBase } from '../lib/paths';
// The projects overview (direction B): the category dropdown, then one tile per category leading to
// its own page (/projects/<slug>). Headings and images are the supplied sections', verbatim.
const d = (await getEntry('projectsIndex', 'projects'))!.data;
const site = (await getEntry('site', 'site'))!.data;
const { text } = await loadExtras();
// The page heading is the site menu's own PROJECTS label, verbatim (shown in sentence case).
const heading = site.menu?.find((m) => m.href === '/projects')?.label ?? d.sections[0].heading;
const cats = projectCategories(d.sections);
const picker = cats.map((c) => ({ heading: c.heading, href: c.href, count: c.items.length }));
// Old /projects#<section> links (Wix's in-page chips) forward to the category page.
const redirects = Object.fromEntries([['top', cats[0].href], ...cats.map((c) => [c.id, c.href])].map(([k, v]) => [k, withBase(v)]));
---
<Base title={d.seo.title} description={d.seo.description} ogImage={d.seo.ogImage} page="projects">
  <script is:inline define:vars={{ redirects }}>
    { const to = redirects[location.hash.slice(1)]; if (to) location.replace(to); }
  </script>
  <header class="wrap pi-head">
    <h1 class="display h1 sc" data-split>{heading}</h1>
    <CategoryPicker label={text('category-label')} current={text('next-fallback').text} all={{ label: text('next-fallback'), href: '/projects' }} categories={picker} path="/projects" />
  </header>
  <section class="wrap pi-cats" aria-labelledby="pi-cats-title">
    <h2 id="pi-cats-title" class="sr-only">{text('nav-categories').text}</h2>
    <ul class="tiles">
      {cats.map((c, i) => (
        <li>
          <a class="tile" href={withBase(c.href)} data-reveal>
            <span class="tile-media"><Image src={c.items[0].thumb} alt="" widths={[480, 800, 1200]} sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1023px) 50vw, 33vw" loading={i < 3 ? 'eager' : 'lazy'} /></span>
            <span class="tile-text"><span class="tile-name">{c.heading}</span><span class="tile-count">{c.items.length}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .pi-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--s-6); padding-block: var(--s-8) var(--s-7); border-bottom: 1px solid var(--line); }
  .pi-head h1 { margin: 0; }
  .pi-cats { padding-block: var(--s-7) var(--section-y); }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-7) var(--s-5); }
  .tile { display: grid; gap: var(--s-3); color: inherit; text-decoration: none; }
  .tile-media { display: block; position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--stone); }
  .tile-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .tile-media::after { content: ''; position: absolute; inset: 0; background: var(--grain); opacity: .14; mix-blend-mode: overlay; pointer-events: none; }
  .tile:hover .tile-media :global(img) { transform: scale(1.04); }
  .tile-text { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-4); padding-top: var(--s-2); border-top: 1px solid var(--line); }
  .tile-name { font: 400 var(--fs-h3)/1.3 var(--font-display); }
  .tile:hover .tile-name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .tile-count { font-size: var(--fs-small); color: var(--text-2); font-variant-numeric: tabular-nums; }
  @media (min-width: 640px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .tile-media :global(img) { transition: none; } }
</style>
<script>
  import { run } from '../scripts/motion/index';
  import { reveal } from '../scripts/motion/reveal';
  import { tilt } from '../scripts/motion/tilt';
  run(reveal, tilt);
</script>
