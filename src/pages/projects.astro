---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AnchorMenu from '../components/AnchorMenu.astro';
import Gallery from '../components/Gallery.astro';
const d = (await getEntry('projectsIndex', 'projects'))!.data;
// Wix's mobile layout lists the categories as links above the galleries; the footer item is
// desktop-menu only.
const mobileItems = d.menu.filter((i) => i.target !== 'footer');
---
<Base title={d.seo.title} description={d.seo.description} ogImage={d.seo.ogImage} bodyClass="page-projects">
  <AnchorMenu items={d.menu} variant="dots" />
  <div class="index">
    <AnchorMenu items={mobileItems} variant="list" />
    {d.sections.map((s) => (
      <section id={s.id} class="category">
        <h2>{s.heading}</h2>
        <Gallery items={s.items} layout="grid" />
      </section>
    ))}
  </div>
</Base>
<style>
  /*
   * Measured on the live /projects at 1440x900: grey page (#adadac) with a 980px #fafafa column
   * centred from the 4px header strip down to the footer; headings and galleries start 13px into
   * it (x=243), galleries 956 wide. First heading top at y=81; each 28px h2 (34px box) sits 25px
   * above its 3-column gallery; Wix places sections 23-66px apart (45 here); the footer follows
   * the last gallery after 10px.
   * Mobile (Wix 320px layout, lengths x --m): #fafafa page; the category links at x=53 from
   * y~115; first gallery 28 below them. Each heading runs vertically (writing-mode vertical-rl,
   * 25px) in a 300px-tall box at x~17, level with its gallery's top; galleries are one column at
   * x=53, 256.84 wide; sections 15-64 apart (42 here); the footer follows the last gallery.
   * scroll-margin-top lands a section's heading where the first one sits at the top of the page.
   */
  :global(body.page-projects) { background: var(--color-page-grey); }
  .index {
    width: min(980px, 100%); margin-inline: auto; padding: 77px 11px 10px 13px;
    background: var(--color-page-column);
  }
  .category + .category { margin-top: 45px; }
  .category { scroll-margin-top: 81px; }
  .category h2 { margin: 0; }
  .category :global(.gallery) { margin-top: 25px; }

  @media (max-width: 767px) {
    :global(body.page-projects) { background: var(--color-page-column); }
    .index { width: auto; padding: calc(21 * var(--m)) 0 0; }
    .index > :global(.list) { margin-left: calc(53 * var(--m)); }
    .category { position: relative; scroll-margin-top: calc(14 * var(--m)); }
    .index > :global(.list) + .category { margin-top: calc(28 * var(--m)); }
    .category + .category { margin-top: calc(42 * var(--m)); }
    .category h2 {
      position: absolute; left: calc(17 * var(--m)); top: 0; height: calc(300 * var(--m));
      writing-mode: vertical-rl; font-size: calc(25 * var(--m));
    }
    .category :global(.gallery) { width: calc(256.84 * var(--m)); margin: 0 0 0 calc(53 * var(--m)); }
  }
</style>
