---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import T from '../components/ui/T.astro';
import { loadExtras } from '../lib/extras';
import { projectCategories } from '../lib/categories';
import { withBase } from '../lib/paths';
import { getCollection } from 'astro:content';
import { catalogueOf } from '../lib/catalogue';
import PaperCut from '../components/ui/PaperCut.astro';
// Not found (GitHub Pages serves this for any missing path under the site). Before showing it, an
// inline script sends two kinds of old address on: a trailing slash ("/about/" → "/about", which Wix
// redirects too) and Wix addresses that moved (/joseph → the card built at /joseph-chan).
const site = (await getEntry('site', 'site'))!.data;
const projectsIndex = (await getEntry('projectsIndex', 'projects'))!.data;
const { text } = await loadExtras();
const label = (href: string) => site.menu?.find((m) => m.href === href)?.label ?? href;
const cats = projectCategories(projectsIndex.sections);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const moved: Record<string, string> = { '/joseph': '/joseph-chan' };
const title = text('notfound-title');
// "404" cut through a sheet of paper (ui/PaperCut), a project's picture under it: 'Nothing is Impossible'
// (its comic-book burst suits a page that went missing), or the first card if that one is ever unlisted.
const home = (await getEntry('home', 'home'))!.data;
const catalogue = catalogueOf(home.allProjects.items, new Map((await getCollection('projects')).map((e) => [e.id, e.data])));
const plate = catalogue.find((e) => /nothing is impossible/i.test(e.title)) ?? catalogue[0];
---
<Base title={`${title.text} | Achates 360`} page="page" noindex>
  <script is:inline define:vars={{ base, moved }}>
    (function () {
      var p = location.pathname;
      if (base && p.indexOf(base) === 0) p = p.slice(base.length) || '/';
      var to = null;
      if (p.length > 1 && p.slice(-1) === '/') to = p.replace(/\/+$/, '');
      else if (moved[p]) to = moved[p];
      if (to !== null) location.replace(base + to + location.search + location.hash);
    })();
  </script>
  <section class="wrap nf">
    <PaperCut text="404" image={plate.thumb} position={plate.position} class="nf-cut" scale={1.5} />
    <h1 class="display h1"><T s={title} /></h1>
    <p class="nf-body"><T s={text('notfound-body')} /></p>
    <ul class="nf-links">
      <li><a href={withBase('/')}><span class="sc">{label('/')}</span></a></li>
      <li><a href={withBase('/projects')}><span class="sc">{label('/projects')}</span></a></li>
      {cats.map((c) => <li class="nf-cat"><a href={withBase(c.href)}>{c.heading}</a></li>)}
      <li><a href={withBase('/contact')}><span class="sc">{label('/#contact')}</span></a></li>
    </ul>
  </section>
</Base>
<style>
  .nf { padding-block: var(--s-9) var(--section-y); display: grid; gap: var(--s-5); }
  .nf h1 { margin: 0; }
  .nf > :global(.nf-cut) { max-width: 760px; margin-bottom: var(--s-4); }
  .nf-body { margin: 0; max-width: 52ch; font-size: var(--fs-lead); color: var(--text-2); }
  .nf-links { list-style: none; margin: var(--s-4) 0 0; padding: 0; display: grid; gap: 0; max-width: 560px; border-top: 1px solid var(--line); }
  .nf-links li { border-bottom: 1px solid var(--line); }
  .nf-links a { display: block; padding: 14px 0; color: inherit; text-decoration: none; }
  .nf-links a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .nf-cat a { padding-left: var(--s-5); font-size: var(--fs-small); color: var(--text-2); }
</style>
