---
import { catalogueOf } from '../lib/catalogue';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import VideoHero from '../components/VideoHero.astro';
import RunningHead from '../components/ui/RunningHead.astro';
import Pill from '../components/ui/Pill.astro';
import T from '../components/ui/T.astro';
import heroPoster from '../assets/hero-loop-poster.jpg';
import ServiceIndex from '../components/ServiceIndex.astro';
import WorkStack from '../components/WorkStack.astro';
import Credentials from '../components/Credentials.astro';
import ScatterCTA from '../components/ScatterCTA.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { loadExtras } from '../lib/extras';
import { sentenceStarting } from '../lib/copy';
import { withLinks } from '../lib/categories';
import { withBase } from '../lib/paths';
import { getImage } from 'astro:assets';
import { organizationLd, websiteLd } from '../lib/seo';
import ogDefault from '../assets/og-default.jpg';
import { serviceCount } from '../lib/service-counts';
import { ABOUT_ACCENTS } from '../lib/accents';

const d = (await getEntry('home', 'home'))!.data;
const about = (await getEntry('basic', 'about'))!.data;
const x = await loadExtras();
const { text } = x;
const aboutMd = about.blocks.filter((b) => b.type === 'text').map((b: any) => b.md).join('\n\n');
const intro = sentenceStarting(aboutMd, 'The name Achates 360');
if (!intro) throw new Error('Homepage intro: no About paragraph starts with "The name Achates 360" (spec §4.1)');
// After nationalgallery.sg: the sentence in ink with its key phrase in orange (display only; the phrase
// is About's, lib/accents.ts).
const KEY = ABOUT_ACCENTS.companion;
const at = intro.indexOf(KEY);
const [introBefore, introKey, introAfter] = at < 0 ? [intro, '', ''] : [intro.slice(0, at), KEY, intro.slice(at + KEY.length)];
const projects = new Map((await getCollection('projects')).map((e) => [e.id, e.data]));
const listedCount = [...projects.values()].filter((p) => p.listed).length;
const catalogue = catalogueOf(d.allProjects.items, projects);
// The work after the hero (WorkStack, after wearecollins.com): seven projects across the disciplines,
// films first: packaging, campaign content, branding, advertising, campaigns, brand and packaging, events.
const WORK = ['starwars-luzerne', 'samsung-connected-home', 'idm-venture-capital', 'dxv', 'grohe-quarterly-campaigns', 'notter', 'alstom-r151-last-train-handover'];
// The closing scatter: nine pieces of printed work (books, magazines, guides, kits), calm paper and ink to
// end on. The first six are the ones phones show.
const SCATTER = ['the-art-of-tan-ping-chiang', 'socialspace', 'mosaic-magazine', 'the-ritz-kids-programme-guide', 'little-thoughts-thinking-out-loud', 'journal-of-aviation-management', 'singapore-conference-hall-sg5050', 'national-theatre-pop-up-kit', 'changi-airport-group'];
const scatter = SCATTER.map((slug) => {
  const it = catalogue.find((e) => e.slug === slug);
  if (!it) throw new Error(`Homepage scatter: "${slug}" is not a listed project in the gallery`);
  return it;
});
// The homepage: hero (the studio's showreel full-screen, with the way to all the work and the film
// with sound; after aesop.com, client 21 Oct 2026), the work (seven projects as large moving tiles), the
// point of view, the service index, the imprint (clients, awards, figures), one testimonial
// (only once the client has supplied a real one), contact. The full project list lives on /projects.
// (Selected work, five featured projects with a film cover, was replaced by the showreel, and the lens
// of project cards by the showreel as the hero: client, 21 Oct 2026. The lens is tag lens-hero-v1.)
// The service contents: each service's number of listed projects, counted as on /services.
const sections = withLinks((await getEntry('projectsIndex', 'projects'))!.data.sections);
const listed = new Set([...projects].filter(([, p]) => p.listed).map(([id]) => id));
const services = x.services.map((s: any) => ({ ...s, count: serviceCount(s.tags, sections, listed) }));
// The draft testimonial ("[Draft] A short client testimonial goes here…") is not shown: the band
// appears once the client supplies a real quotation (CONTENT-QUERIES 10).
const quote = x.testimonials.find((t: any) => !t.placeholder);
// The closing call to action's line is the footer's own intro sentence (site.md), verbatim.
const site = (await getEntry('site', 'site'))!.data;
const footerIntro = String((site.footer as any[]).find((b) => b.type === 'text')?.md ?? '').replace(/^#+\s*/, '');
// Structured data: the studio, from the footer's own links (email, social profiles).
const footerMd = site.footer.filter((b: any) => b.type === 'text').map((b: any) => b.md).join('\n');
const email = footerMd.match(/mailto:([^)\s]+)/)?.[1];
const sameAs = site.footer.filter((b: any) => b.type === 'image' && /^https?:/.test(b.href ?? '')).map((b: any) => b.href);
const homeUrl = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/'), Astro.site).href;
const logoUrl = new URL((await getImage({ src: ogDefault, width: 1200, format: 'jpg' })).src, Astro.site).href;
// The About page's own first sentence describes the studio; its fields are the project categories.
const description = sentenceStarting(aboutMd, 'We are an integrated creative agency') ?? undefined;
const knowsAbout = [...new Set([...projects.values()].filter((p) => p.listed).flatMap((p) => p.categories))].sort();
const jsonLd = [organizationLd({ url: homeUrl, logo: logoUrl, email, sameAs, description, knowsAbout }), websiteLd(homeUrl)];
---
<Base title={d.seo.title} description={d.seo.description} ogImage={d.seo.ogImage} jsonLd={jsonLd} page="home" overHero>
  <script is:inline define:vars={{ contactPage: withBase('/contact') }}>
    // Old links to the homepage form (/#contact) go to the contact page.
    if (location.hash === '#contact') location.replace(contactPage);
  </script>
  <VideoHero name={text('wordmark')} tagline={text('hero-tagline')} blurb={d.seo.description} label={text('showreel-label')} playLabel={text('showreel-play')} closeLabel={text('showreel-close').text} contact={text('hero-contact-cta')} src="media/video/achates360-showreel.mp4" preview="media/video/achates360-hero-loop.mp4" phonePreview="media/video/achates360-hero-loop-phone.mp4" poster={heroPoster} />

  <WorkStack slugs={WORK} eyebrow={text('work-eyebrow')} cta={text('selected-cta')} count={listedCount} />

  <section class="h-intro wrap section" aria-labelledby="intro-title">
    <RunningHead as="p" s={text('intro-eyebrow')} />
    <h2 id="intro-title" class="display two-tone">{introBefore}{introKey && <span class="hl">{introKey}</span>}{introAfter}</h2>
    <Pill href="/about"><T s={text('intro-cta')} /></Pill>
  </section>

  <ServiceIndex services={services} eyebrow={text('services-eyebrow')} cta={text('services-cta')} countLabel={text('contents-count')} />

  <Credentials stats={x.stats} listedCount={listedCount} clients={x.clients} eyebrow={text('clients-eyebrow')} awards={text('awards-line')} awardsLabel={text('meta-recognition')} />

  {quote && <QuoteBand id="quote-title" eyebrow={text('testimonials-eyebrow')} quote={quote} />}

  <ScatterCTA items={scatter} heading={text('contact-heading')} blurb={footerIntro} cta={text('connect-cta')} href="/contact" />
</Base>
<style>
  /* The studio's sentence as an opening statement, set left on the page's grid under its running head. */
  .h-intro { padding-block: var(--s-9) var(--s-9); display: grid; justify-items: start; }
  .two-tone { max-width: 30ch; margin-block: var(--s-7) var(--s-6); font-size: clamp(1.625rem, 1.25rem + 1.6vw, 2.75rem); line-height: 1.25; text-wrap: pretty; }
  @media (min-width: 1024px) { .two-tone { margin-left: calc((100% - 11 * var(--s-5)) / 12 * 2 + 2 * var(--s-5)); } .h-intro :global(.pill) { margin-left: calc((100% - 11 * var(--s-5)) / 12 * 2 + 2 * var(--s-5)); } }
  .h-intro > :global(.rh) { justify-self: stretch; }
</style>
<script>
  import { run } from '../scripts/motion/index';
  import { reveal } from '../scripts/motion/reveal';
  import { counters } from '../scripts/motion/counters';
  import { scatter } from '../scripts/motion/scatter';
  run(reveal, counters, scatter);
</script>
