---
import { getCollection, type CollectionEntry } from 'astro:content';
import { assertUniqueSlugs } from '../lib/routes';
import Project from '../layouts/Project.astro';
import Card from '../layouts/Card.astro';
import About from '../layouts/About.astro';
import JoinUs from '../layouts/JoinUs.astro';
import Categories from '../layouts/Categories.astro';
import Page from '../layouts/Page.astro';

type Props =
  | { kind: 'project'; entry: CollectionEntry<'projects'> }
  | { kind: 'card'; entry: CollectionEntry<'cards'> }
  | { kind: 'basic'; entry: CollectionEntry<'basic'> };

export async function getStaticPaths() {
  const [projects, cards, basic] = await Promise.all([
    getCollection('projects'), getCollection('cards'), getCollection('basic'),
  ]);
  assertUniqueSlugs({
    projects: projects.map((e) => e.id),
    cards: cards.map((e) => e.id),
    basic: basic.map((e) => e.id),
  });
  return [
    ...projects.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'project' as const, entry } })),
    ...cards.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'card' as const, entry } })),
    ...basic.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'basic' as const, entry } })),
  ];
}

const props = Astro.props as Props;
---
{props.kind === 'project' && <Project entry={props.entry} />}
{props.kind === 'card' && <Card entry={props.entry} />}
{props.kind === 'basic' && (
  props.entry.id === 'about' ? <About entry={props.entry} />
  : props.entry.id === 'joinus' ? <JoinUs entry={props.entry} />
  : props.entry.id === 'copy-of-projects' ? <Categories entry={props.entry} />
  : <Page entry={props.entry} />
)}
