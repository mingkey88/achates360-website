---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { SITE_ENV } from 'astro:env/server';
import { robotsMeta } from '../lib/seo';
import { pagePath } from '../lib/paths';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import SiteMenu from '../components/SiteMenu.astro';
import MobileMenu from '../components/MobileMenu.astro';
import BackToTop from '../components/BackToTop.astro';
import '../styles/tokens.css';
import '../styles/base.css';

// background: the page's Wix background colour, when it is not the default white (exported as
// pageBackground).
interface Props { title: string; description?: string; ogImage?: ImageMetadata; bodyClass?: string; background?: string }
const { title, description, ogImage, bodyClass, background } = Astro.props;
const site = (await getEntry('site', 'site'))!.data;
const robots = robotsMeta(SITE_ENV);
const og = ogImage ? new URL((await getImage({ src: ogImage, width: 1200, format: 'jpg' })).src, Astro.site).href : undefined;
// build.format 'file' reports /x.html and /index.html; the live URLs are /x and /.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, ''), Astro.site).href;
const path = pagePath(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {og && <meta property="og:image" content={og} />}
    <meta property="og:site_name" content="Achates 360" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class={bodyClass} style={background ? `background: ${background}` : undefined}>
    <Logo logo={site.logo} />
    {site.menu && <SiteMenu menu={site.menu} social={site.menuSocial} path={path} />}
    {site.mobileMenu && <MobileMenu menu={site.mobileMenu} path={path} />}
    <main id="top"><slot /></main>
    <Footer blocks={site.footer} />
    <BackToTop />
  </body>
</html>
