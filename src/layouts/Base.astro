---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { SITE_ENV, PUBLIC_CF_ANALYTICS_TOKEN } from 'astro:env/server';
import { robotsMeta, canonicalUrl, CANONICAL_ALIASES, tidy, ldJson } from '../lib/seo';
import ogDefault from '../assets/og-default.jpg';
import { meta } from '../lib/img';
import { pagePath } from '../lib/paths';
import { loadExtras } from '../lib/extras';
import { withServices, withCategories, withContactPage } from '../lib/menu';
import { projectCategories } from '../lib/categories';
import type { PageKind } from '../lib/page-kind';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
// Direction B (after Aesop): one quiet grotesk throughout, Hanken Grotesk (a free relative of Aesop's
// Suisse). Cormorant Garamond only for the quotation set alone on the homepage.
import hankenLatin from '@fontsource/hanken-grotesk/files/hanken-grotesk-latin-400-normal.woff2?url';
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/500.css';
import '@fontsource/hanken-grotesk/latin-800.css'; // cut-out lettering only
import '@fontsource/cormorant-garamond/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/type.css';

// overHero: the page opens with a full-bleed hero, so the header starts transparent over it.
// ogImage: the page's share picture (a project passes its hero); ogAlt describes it. jsonLd: structured
// data for search engines (schema.org objects), inlined as one ld+json script.
interface Props {
  title: string; description?: string; ogImage?: ImageMetadata; ogAlt?: string; ogType?: 'website' | 'article';
  page: PageKind; overHero?: boolean; jsonLd?: Record<string, unknown>[]; noindex?: boolean;
}
const { ogImage, ogAlt, ogType = 'website', page, overHero = false, jsonLd = [], noindex = false } = Astro.props;
const title = tidy(Astro.props.title);
const description = Astro.props.description ? tidy(Astro.props.description) : undefined;
const site = (await getEntry('site', 'site'))!.data;
const { text } = await loadExtras();
// noindex: pages that must never be indexed (the 404), on any host.
const robots = noindex ? 'noindex, nofollow' : robotsMeta(SITE_ENV);
// Share image, cropped to the 1200x630 card every network shows. Transparent PNGs (the export's
// shared logo) would flatten to black as JPG, so they give way to the paper-and-logo default.
const shareSrc = ogImage && meta(ogImage).format !== 'png' ? ogImage : ogDefault;
const OG_W = 1200, OG_H = 630;
const og = new URL((await getImage({ src: shareSrc, width: OG_W, height: OG_H, fit: 'cover', format: 'jpg' })).src, Astro.site).href;
const ogImageAlt = shareSrc === ogDefault ? 'Achates 360' : (ogAlt ?? title);
const path = pagePath(Astro.url.pathname);
// A Wix duplicate kept at its permanent URL names the page it copies as canonical.
const alias = CANONICAL_ALIASES[path];
const canonical = alias
  ? canonicalUrl(import.meta.env.BASE_URL.replace(/\/$/, '') + alias + '.html', Astro.site!, import.meta.env.BASE_URL)
  : canonicalUrl(Astro.url.pathname, Astro.site!, import.meta.env.BASE_URL);
const icon = async (w: number) => site.favicon && (await getImage({ src: site.favicon.src, width: w, height: w, format: 'png' })).src;
const [icon32, icon192, icon180] = await Promise.all([icon(32), icon(192), icon(180)]);
const projectsIndex = (await getEntry('projectsIndex', 'projects'))!.data;
const categories = projectCategories(projectsIndex.sections).map((c) => ({ label: c.heading, href: c.href }));
const menu = withContactPage(withCategories(withServices(site.menu ?? [], text('menu-services').text), categories));
// The main pages (menu labels, verbatim) for the footer: the homepage's signoff row, and every other page's.
const pageLinks = menu.filter((m) => m.href !== '/').map((m) => ({ label: m.label, href: m.href }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={hankenLatin} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    {icon32 && <link rel="icon" href={icon32} sizes="32x32" type="image/png" />}
    {icon192 && <link rel="icon" href={icon192} sizes="192x192" type="image/png" />}
    {icon180 && <link rel="apple-touch-icon" href={icon180} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_SG" />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content={String(OG_W)} />
    <meta property="og:image:height" content={String(OG_H)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Achates 360" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fffef2" />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={ldJson(jsonLd.length === 1 ? jsonLd[0] : jsonLd)} />}
    {/* `js` gates hidden-until-revealed styles; motion-ready lifts them. If the motion bundle never
        arrives, the timeout lifts them after 3s so nothing stays invisible (Review Focus 1). */}
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){document.documentElement.classList.add('motion-ready')},3000);</script>
    {/* Cloudflare Web Analytics: cookieless page counts, only when a token is set at build time. */}
    {PUBLIC_CF_ANALYTICS_TOKEN && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: PUBLIC_CF_ANALYTICS_TOKEN })}></script>}
  </head>
  <body data-page={page} data-over-hero={overHero ? '' : undefined}>
    <a class="skip-link" href="#main" data-placeholder={text('skip-link').placeholder ? '' : undefined}>{text('skip-link').text}</a>
    <Header menu={menu} path={path} overHero={overHero} wordmark={text('wordmark')} menuLabel={text('menu-open')} navLabel={text('nav-label')} subLabel={text('nav-categories')} />
    <Menu menu={menu} social={site.menuSocial ?? []} path={path} menuLabel={text('menu-open')} closeLabel={text('menu-close')} navLabel={text('nav-label')} />
    <main id="main"><slot /></main>
    {/* The homepage closes with the footer's own intro line (ScatterCTA), so the footer skips it there. */}
    <Footer blocks={site.footer} hideIntro={page === 'home'} signoff={page === 'home' ? { line: text('hero-tagline').text, links: pageLinks } : undefined} links={pageLinks} top={text('back-to-top')} />
  </body>
</html>
