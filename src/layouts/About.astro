---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Block from '../components/Block.astro';
import Timeline from '../components/Timeline.astro';
import Credentials from '../components/Credentials.astro';
import QuoteBand from '../components/QuoteBand.astro';
import CloseCTA from '../components/CloseCTA.astro';
import { loadExtras } from '../lib/extras';
import { firstYear } from '../lib/meta';
import { withBase } from '../lib/paths';
import { aboutPageLd } from '../lib/seo';
// /about in direction B: the existing About blocks verbatim in an editorial column on the paper, then
// the homepage's own pieces: the numbers, clients and awards band, the story, one quotation, and the
// quiet close to the contact page.
interface Props { entry: CollectionEntry<'basic'> }
const d = Astro.props.entry.data;
const x = await loadExtras();
const { text } = x;
const site = (await getEntry('site', 'site'))!.data;
const heading = site.menu?.find((m) => m.href === '/about')?.label ?? 'About';
const all = await getCollection('projects');
const projects = new Map(all.map((e) => [e.id, e.data]));
const listedCount = all.filter((e) => e.data.listed).length;
const timeline = x.timeline.map((t: any) => {
  const p = projects.get(t.project);
  if (!p) throw new Error(`timeline/${t.id}: unknown project "${t.project}"`);
  const year = firstYear(p.copyright);
  if (!year || !p.hero) throw new Error(`timeline/${t.id}: project "${t.project}" needs a copyright year and a hero`);
  const image = p.hero.type === 'image' ? p.hero.src : p.hero.poster;
  const alt = p.hero.type === 'image' ? p.hero.alt : '';
  return { id: t.id, year, label: p.title, body: t.body, image, alt, placeholder: t.placeholder };
});
// The Wix About page carried a "Back to projects" link (a leftover of its page template); it leads
// nowhere useful from About, so it is not shown here (the record keeps it).
const blocks = d.blocks.filter((b: any) => !(b.type === 'link' && /back to projects/i.test(String(b.label))));
// A different quotation from the homepage's, where there is one.
const quote = x.testimonials[1] ?? x.testimonials[0];
const abs = (p: string) => new URL(withBase(p), Astro.site).href;
const jsonLd = [aboutPageLd('AboutPage', { url: abs('/about'), name: heading, homeUrl: abs('/') })];
---
<Base title={d.seo.title} description={d.seo.description} ogImage={d.seo.ogImage} jsonLd={jsonLd} page="about">
  <section class="wrap ab-intro">
    <h1 class="display h1 sc" data-split>{heading}</h1>
    <div class="ab-blocks">{blocks.map((b: any) => <Block block={b} pageTitle={d.seo.title} />)}</div>
  </section>
  <Credentials stats={x.stats} listedCount={listedCount} clients={x.clients} eyebrow={text('about-stats-eyebrow')} awards={text('awards-line')} />
  <Timeline items={timeline} heading={text('timeline-heading')} />
  {quote && <QuoteBand id="ab-quote" eyebrow={text('testimonials-eyebrow')} quote={quote} />}
  <CloseCTA heading={text('contact-heading')} cta={text('connect-cta')} href="/contact" />
</Base>
<style>
  /* Editorial: the page title in the left columns, the studio's own words in a reading column. */
  .ab-intro { display: grid; gap: var(--s-7); padding-block: var(--s-8) var(--section-y); border-bottom: 1px solid var(--line); }
  .ab-intro h1 { margin: 0; }
  .ab-blocks { display: grid; gap: var(--s-6); max-width: 60ch; }
  .ab-blocks :global(.block-text) { font-size: var(--fs-lead); line-height: 1.55; }
  .ab-blocks :global(.block-text p:first-child) { font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem); line-height: 1.35; }
  .ab-blocks :global(.block-image) { overflow: hidden; }
  .ab-blocks :global(.block-img) { width: 100%; height: auto; }
  @media (min-width: 1024px) {
    .ab-intro { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s-5); align-items: start; }
    .ab-intro h1 { grid-column: 1 / 5; position: sticky; top: calc(var(--header-h) + var(--s-6)); }
    .ab-blocks { grid-column: 6 / 12; }
  }
</style>
<script>
  import { run } from '../scripts/motion/index';
  import { reveal } from '../scripts/motion/reveal';
  import { timeline } from '../scripts/motion/timeline';
  import { counters } from '../scripts/motion/counters';
  run(reveal, timeline, counters);
</script>
