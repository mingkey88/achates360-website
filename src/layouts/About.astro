---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Chronology from '../components/Chronology.astro';
import RunningHead from '../components/ui/RunningHead.astro';
import T from '../components/ui/T.astro';
import Pic from '../components/ui/Pic.astro';
import { renderMd } from '../lib/markdown';
import { STILLS } from '../lib/stills';
import awardsSpread from '../assets/awards-spread.jpg';
import lobby from '../assets/office/lobby.jpg';
import meetingRoom from '../assets/office/meeting-room.jpg';
import studio from '../assets/office/studio.jpg';
import logo from '../assets/logo-stacked-parts.svg?raw';
import Credentials from '../components/Credentials.astro';
import QuoteBand from '../components/QuoteBand.astro';
import CloseCTA from '../components/CloseCTA.astro';
import { loadExtras } from '../lib/extras';
import { firstYear } from '../lib/meta';
import { withBase } from '../lib/paths';
import { aboutPageLd, altOr } from '../lib/seo';
import { ABOUT_ACCENTS } from '../lib/accents';
// /about: the About text verbatim, its first sentence as
// the page's statement in display type and the rest as the foreword in two columns, the studio's photo
// as a plate; then the numbers, clients and awards; the story as a chronology (one ruled row per
// milestone); one quotation once the client supplies it; the quiet close to the contact page. (The
// catalogue range, colour bar and colophon were removed with the print devices, 21 Oct 2026.)
interface Props { entry: CollectionEntry<'basic'> }
const d = Astro.props.entry.data;
const x = await loadExtras();
const { text } = x;
const site = (await getEntry('site', 'site'))!.data;
const heading = site.menu?.find((m) => m.href === '/about')?.label ?? 'About';
const all = await getCollection('projects');
const projects = new Map(all.map((e) => [e.id, e.data]));
const listedCount = all.filter((e) => e.data.listed).length;
const timeline = x.timeline.map((t: any) => {
  const p = projects.get(t.project);
  if (!p) throw new Error(`timeline/${t.id}: unknown project "${t.project}"`);
  const year = firstYear(p.copyright);
  if (!year || !p.hero) throw new Error(`timeline/${t.id}: project "${t.project}" needs a copyright year and a hero`);
  const image = STILLS[t.project] ?? (p.hero.type === 'image' ? p.hero.src : p.hero.poster);
  const alt = p.hero.type === 'image' ? p.hero.alt : '';
  return { id: t.id, year, label: p.title, body: t.body, image, alt, href: `/${t.project}`, placeholder: t.placeholder };
});
// The Wix About page carried a "Back to projects" link (a leftover of its page template); it leads
// nowhere useful from About, so it is not shown here (the record keeps it).
const blocks = d.blocks.filter((b: any) => !(b.type === 'link' && /back to projects/i.test(String(b.label))));
// The About text, verbatim: its first paragraph is the statement, the others the foreword. Pictures
// follow as plates. (Any other block would be dropped silently, so the build stops on one.)
const paras = blocks.filter((b: any) => b.type === 'text').flatMap((b: any) => String(b.md).split(/\n\s*\n/).map((x: string) => x.trim()).filter(Boolean));
const [statement, ...foreword] = paras;
// The foreword told as chapters (motion/story.ts): "Since starting in 2001…" with the founding year and the
// studio's photo; "The name Achates 360 reflects…" with the logo's five figures joining hands; "Believing
// that design is thinking made visual…" inking in from pencil. A paragraph that fits none joins the first.
const pick = (re: RegExp) => foreword.find((x) => re.test(x));
const companion = pick(/Achates 360 reflects/);
const visual = pick(/^Believing/);
const since = foreword.filter((x) => x !== companion && x !== visual);
const founded = x.stats.find((s: any) => s.id === 'founded')?.value;
// Each chapter's key phrase in orange (lib/accents.ts; display only, the words unchanged).
const keyed = (md: string, phrase: string) => renderMd(md).replace(phrase, `<span class="hl">${phrase}</span>`);
// "Thinking made visual" word by word, so each word can ink in (plain text only; Markdown keeps its form);
// the words of its key phrase ink in orange.
const visualWords = visual && !/[*_\[\]#`<>]/.test(visual) ? visual.split(/\s+/) : null;
const keyStart = visualWords ? visualWords.join(' ').indexOf(ABOUT_ACCENTS.visual) : -1;
const keyWord = (i: number) => {
  if (!visualWords || keyStart < 0) return false;
  const at = visualWords.slice(0, i).join(' ').length + (i > 0 ? 1 : 0);
  return at >= keyStart && at < keyStart + ABOUT_ACCENTS.visual.length;
};
const figs = [...(logo.match(/<g class="lg-mark">(.*?)<\/g><g class="lg-word">/)?.[1] ?? '').matchAll(/<g class="lg-fig"[^>]*>(.*?)<\/g>/g)].map((m) => m[1]);
const plates = blocks.filter((b: any) => b.type === 'image');
const other = blocks.find((b: any) => b.type !== 'text' && b.type !== 'image');
if (!statement) throw new Error('About: no text to set as the statement');
if (other) throw new Error(`About: a "${other.type}" block has no place in the layout`);
// The office photographs (Achates360_Office.pdf), each captioned with the PDF's own label.
const office = [
  { src: lobby, alt: 'The lobby: the Achates 360 logo on the wall, award trophies on a wooden sideboard, patchwork sofas', caption: text('office-lobby') },
  { src: meetingRoom, alt: 'The meeting room: a glass table, wire chairs in blue and red, a painting and a round curio shelf', caption: text('office-meeting') },
  { src: studio, alt: 'The studio floor from the mezzanine stairs: desks by tall windows, shelves of work, prints on the walls', caption: text('office-studio') },
];
// A different quotation from the homepage's, where there is one. Draft quotations are not shown (the
// band appears once the client supplies real ones, CONTENT-QUERIES 10).
const quotes = x.testimonials.filter((t: any) => !t.placeholder);
const quote = quotes[1] ?? quotes[0];
const abs = (p: string) => new URL(withBase(p), Astro.site).href;
const jsonLd = [aboutPageLd('AboutPage', { url: abs('/about'), name: heading, homeUrl: abs('/') })];
---
<Base title={d.seo.title} description={d.seo.description} ogImage={d.seo.ogImage} jsonLd={jsonLd} page="about">
  <section class="wrap ab-intro">
    <header class="ab-head">
      <h1 class="ab-h1 sc">{heading}</h1>
    </header>
    <div class="ab-statement" set:html={keyed(statement, ABOUT_ACCENTS.statement)} />
  </section>
  {/* Chapter: since the founding year. */}
  <section class="wrap ab-since">
    {founded && <p class="ab-year" aria-hidden="true">{founded}</p>}
    <div class="ab-since-text">{since.map((p) => <div class="ab-p" set:html={renderMd(p)} />)}</div>
    {plates.map((b: any) => (
      <figure class="ab-plate crop" data-rise><Pic src={b.src} alt={altOr(b.alt, '')} widths={[640, 960, 1440, 1920]} sizes="(max-width: 1023px) 100vw, 50vw" /></figure>
    ))}
  </section>
  <Chronology items={timeline} heading={text('timeline-heading')} />
  {/* Chapter: the name. The logo's five figures join hands as the chapter scrolls into view. */}
  {companion && (
    <section class="wrap ab-companion" data-gather>
      <svg class="ab-figs" viewBox="44 -8 106 113" aria-hidden="true" focusable="false">
        {figs.map((f, i) => <g class="st-fig" style={`--i: ${i}`} set:html={f} />)}
      </svg>
      <div class="ab-companion-text" set:html={keyed(companion, ABOUT_ACCENTS.companion)} />
    </section>
  )}
  {/* Chapter: thinking made visual. The sentence starts in pencil outline and inks in word by word. */}
  {visual && (
    <section class="wrap ab-visual" data-ink>
      {visualWords ? <p class="ab-visual-text">{visualWords.map((w, i) => <>{i > 0 && ' '}<span class:list={['w', { o: keyWord(i) }]}>{w}</span></>)}</p> : <div class="ab-visual-text" set:html={renderMd(visual)} />}
    </section>
  )}
  {/* Chapter: inside the studio. The office's lobby (its awards on the sideboard), meeting room and studio
      floor, from Achates360_Office.pdf, captioned with its own labels. */}
  <section class="wrap ab-office" aria-labelledby="ab-office-title">
    <RunningHead id="ab-office-title" s={text('intro-eyebrow')} aside="1 Irving Place, #05-02" />
    <div class="ab-office-plates">
      {office.map((o) => <figure class="ab-office-plate crop" data-rise><Pic src={o.src} alt={altOr(o.alt, '')} crop={4 / 3} widths={[480, 640, 912]} sizes="(max-width: 767px) 100vw, 31vw" /><figcaption><T s={o.caption} /></figcaption></figure>)}
    </div>
  </section>
  {/* Chapter: the recognition. The deck's photograph of the award annuals and the Straits Times report on
      'Building Memories', its line as the heading; the awards themselves follow in the imprint below. */}
  <section class="wrap ab-mark" aria-labelledby="ab-mark-title">
    <h2 id="ab-mark-title" class="ab-mark-title"><T s={text('awards-chapter')} /></h2>
    <figure class="ab-mark-plate crop" data-rise><Pic src={awardsSpread} alt="The award annuals the studio's work appears in (Singapore Book Awards 2017, A' Design Award & Competition, HOW, The Paperweight Awards 2014, GDUSA) and The Straits Times report “Book on S'pore's iconic buildings wins big at awards”" widths={[640, 960, 1440, 1920, 2383]} sizes="(max-width: 1023px) 100vw, 92vw" /></figure>
  </section>
  <Credentials stats={x.stats} listedCount={listedCount} clients={x.clients} eyebrow={text('about-stats-eyebrow')} awards={text('awards-line')} awardsLabel={text('meta-recognition')} clientsLabel={text('clients-eyebrow')} orangeFigures />
  {quote && <QuoteBand id="ab-quote" eyebrow={text('testimonials-eyebrow')} quote={quote} />}
  <CloseCTA heading={text('contact-heading')} cta={text('connect-cta')} href="/contact" />
</Base>
<style>
  /* A narrative in chapters (motion/story.ts adds the movement; without it every chapter simply reads). */
  .ab-intro { display: grid; gap: var(--s-7); padding-block: var(--s-7) var(--section-y); }
  .ab-head { display: flex; align-items: start; justify-content: space-between; gap: var(--s-5); padding-bottom: var(--s-3); border-bottom: 1px solid var(--ink); }
  .ab-h1 { position: relative; align-self: stretch; margin: 0; font: 400 var(--fs-small)/1.3 var(--font-text); color: var(--text-2); }
  /* The page's name marked as the running heads are: a thick orange bar on the hairline under it. */
  .ab-h1::after { content: ''; position: absolute; left: 0; right: 0; bottom: calc(-1 * var(--s-3) - 1px); height: 4px; background: var(--accent); }
  .ab-statement :global(.hl) { font-weight: inherit; }
  .ab-statement :global(p) { margin: 0; max-width: 24ch; font: 400 clamp(2rem, 1rem + 4vw, 4.5rem)/1.06 var(--font-display); letter-spacing: -.03em; text-wrap: balance; }
  .ab-p :global(p) { margin: 0; }

  /* Since: the founding year drawn large in outline, the paragraph over it, the studio as a plate. */
  .ab-since { position: relative; display: grid; gap: var(--s-7); padding-block: var(--s-8) var(--section-y); }
  .ab-year { margin: 0; font: 800 clamp(7rem, 3rem + 18vw, 20rem)/.8 var(--font-display); letter-spacing: -.05em; color: transparent; -webkit-text-stroke: 2px var(--accent); }
  .ab-since-text { display: grid; gap: var(--s-4); max-width: 46ch; font-size: var(--fs-lead); line-height: 1.6; }
  .ab-plate { position: relative; margin: 0; }
  .ab-plate :global(img) { display: block; width: 100%; height: auto; }

  /* The name: the five figures large, the sentence beside them. */
  .ab-companion { display: grid; gap: var(--s-7); align-items: center; padding-block: var(--section-y); border-top: 1px solid var(--line); }
  .ab-figs { width: min(100%, 440px); justify-self: center; overflow: visible; fill: var(--ink); }
  .ab-companion-text :global(p) { margin: 0; max-width: 30ch; font: 400 clamp(1.5rem, 1rem + 1.8vw, 2.5rem)/1.3 var(--font-display); letter-spacing: -.015em; text-wrap: pretty; }

  /* Thinking made visual: the sentence in display type; --k inks each word (1 = inked, the default). */
  .ab-visual { padding-block: var(--section-y); border-top: 1px solid var(--line); }
  .ab-visual-text { margin: 0; max-width: 26ch; font: 400 clamp(2rem, 1rem + 3.4vw, 4rem)/1.12 var(--font-display); letter-spacing: -.025em; }
  .ab-visual-text .w { --k: 1; --c: var(--ink); color: color-mix(in srgb, var(--c) calc(var(--k) * 100%), transparent); -webkit-text-stroke: 1px color-mix(in srgb, var(--text-2) calc((1 - var(--k)) * 70%), transparent); }
  .ab-visual-text .w.o { --c: var(--accent-text); font-weight: 500; }


  @media (min-width: 1024px) {
    .ab-intro { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s-5); row-gap: var(--s-8); }
    .ab-head, .ab-statement { grid-column: 1 / -1; }
    .ab-since { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s-5); align-items: end; }
    .ab-year { grid-column: 1 / 8; grid-row: 1; }
    .ab-since-text { grid-column: 1 / 7; grid-row: 2; }
    .ab-plate { grid-column: 8 / 13; grid-row: 1 / 3; align-self: center; }
    .ab-companion { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s-5); }
    .ab-figs { grid-column: 1 / 6; }
    .ab-companion-text { grid-column: 7 / 13; }
    .ab-visual-text { margin-left: calc((100% - 11 * var(--s-5)) / 12 * 2 + 2 * var(--s-5)); }
  }
  /* Inside the studio: three plates of the office in a row, captioned. */
  .ab-office { display: grid; gap: var(--s-6); padding-block: var(--section-y) 0; }
  .ab-office-plates { display: grid; gap: var(--s-6) var(--s-5); }
  .ab-office-plate { position: relative; margin: 0; display: grid; gap: var(--s-3); }
  .ab-office-plate :global(img) { display: block; width: 100%; height: auto; }
  .ab-office-plate figcaption { font-size: var(--fs-small); color: var(--text-2); }
  @media (min-width: 768px) { .ab-office-plates { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* The recognition: the line set large, the photograph across the page in crop marks. */
  .ab-mark { display: grid; gap: var(--s-6); padding-block: var(--section-y) var(--s-8); border-top: 1px solid var(--line); }
  .ab-mark-title { margin: 0; max-width: 18ch; font: 400 clamp(2rem, 1rem + 3.4vw, 4rem)/1.08 var(--font-display); letter-spacing: -.025em; text-wrap: balance; }
  .ab-mark-plate { position: relative; margin: 0; }
  .ab-mark-plate :global(img) { display: block; width: 100%; height: auto; }

</style>
<script>
  import { run } from '../scripts/motion/index';
  import { reveal } from '../scripts/motion/reveal';
  import { counters } from '../scripts/motion/counters';
  import { story } from '../scripts/motion/story';
  import { stamp } from '../scripts/motion/stamp';
  run(reveal, counters, story, stamp);
</script>
