---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Blocks from '../components/Blocks.astro';
import BgVideo from '../components/BgVideo.astro';
import { withBase, backLinkHref } from '../lib/paths';
interface Props { entry: CollectionEntry<'projects'> }
const d = Astro.props.entry.data;
// Case studies Wix shows on a #f2f2f2 page instead of white (sampled from docs/reference/<slug>/
// desktop.png and mobile.png); the export does not record the page background.
const ALT_BACKGROUND = new Set([
  'building-memories-artbook', 'changi-airport-group', 'dxv', 'journal-of-aviation-management', 'kaplan',
  'moving-memories', 'national-theatre-pop-up-kit', 'nokia', 'samsung-tablets-tactical-campaigns',
  'singapore-aviation-academy', 'singapore-conference-hall-sg5050', 'socialspace',
  'the-art-of-tan-ping-chiang', 'the-ritz-kids-programme-guide', 'the-skyline',
]);
const bodyClass = ALT_BACKGROUND.has(Astro.props.entry.id) ? 'page-project page-alt' : 'page-project';
const external = (href: string) => /^https?:\/\//.test(href);
---
<Base title={d.seo.title} description={d.seo.description} ogImage={d.seo.ogImage} bodyClass={bodyClass}>
  {d.hero && (
    <div class="hero">
      {d.hero.type === 'video'
        ? <BgVideo src={d.hero.src} poster={d.hero.poster} class="hero-media" />
        : <Image class="hero-media" src={d.hero.src} alt={d.hero.alt} widths={[768, 1440, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" />}
      {d.badges.length > 0 && (
        <div class="badges">
          {d.badges.map((b) => {
            const img = <Image src={b.src} alt={b.alt} width={112} height={110} densities={[1, 2]} />;
            return b.href
              ? <a href={withBase(b.href)} {...(external(b.href) ? { target: '_blank', rel: 'noreferrer noopener' } : {})}>{img}</a>
              : img;
          })}
        </div>
      )}
      {d.heroCaption && <p class="sr-only">{d.heroCaption}</p>}
    </div>
  )}
  <article class="wrap project">
    {d.backLink && <p class="back"><a href={withBase(backLinkHref(d.backLink.href))}>{d.backLink.label}</a></p>}
    <h2 class="title">{d.title}</h2>
    {d.client && <p class="client">{d.client}</p>}
    <div class="blocks"><Blocks blocks={d.blocks} gallery="stack" /></div>
    {d.copyright && <p class="copyright">{d.copyright}</p>}
  </article>
</Base>
<style>
  /*
   * Geometry measured on the live site at 1440 (notter, dbs-discretionary-portfolio-management,
   * dxv, the-v-edit-e-zine, bumitama-annual-report; Wix positions every element absolutely, so
   * spacing between blocks varies a little per page — these are the common values):
   *   hero: a 900px-tall cover box whose visible part ends at y=791 (top 7px and bottom ~102px
   *     cropped); badges 112x110 at the content column's right edge, 13px above the hero bottom.
   *   back link: right-aligned to the content column, top 24px below the hero.
   *   title h2 top at 872, client at 913, first block at ~990; text boxes ~640px wide.
   *   between images / galleries / players: 10px; around text: ~30px; copyright ~30px after the
   *   last block; ~40px to the footer.
   * Mobile (Wix 320px layout, lengths x --m per Ruling 21): no hero; title 30 below the header
   * band, client 10 below it, first block ~40 below that, 10 between media, the copyright and then
   * the back link (a 280x78 box, text centred) come last.
   */
  :global(body.page-alt) { background: var(--color-page-alt); }
  .hero { position: relative; height: 787px; overflow: hidden; }
  .hero :global(.hero-media) { position: absolute; left: 0; top: -11px; width: 100%; height: 900px; max-width: none; object-fit: cover; }
  .badges { position: absolute; right: max(var(--gutter), calc(50% - 462px)); bottom: 13px; display: flex; gap: 12px; }
  .badges a { display: block; line-height: 0; }
  .badges :global(img) { width: 112px; height: 110px; object-fit: cover; }

  /* Wix's column sits ~10px left of centre (x=237..250 for text and images on a 1440 page). */
  .project { padding-bottom: 40px; margin-left: max(var(--gutter), calc(50% - 480px)); }
  .back { margin: 24px 0 0; text-align: right; font: var(--weight-light) var(--size-ui) / var(--leading-ui) var(--font-ui); }
  .back a { color: var(--color-link); text-decoration: none; }
  .back a:hover { text-decoration: underline; }
  .title { margin: 37px 0 0; }
  .client, .copyright { color: var(--color-muted); line-height: 21px; letter-spacing: 0.15px; }
  .client { margin: 7px 0 0; }
  .copyright { margin: 30px 0 0; }
  /* Wix colours the © in the body grey and the year in the muted grey. */
  .copyright::first-letter { color: var(--color-text); }

  .blocks { margin-top: 56px; }
  .blocks > :global(* + *) { margin-top: 30px; }
  .blocks > :global(:is(.block-image, .gallery, .embed, .bgvideo) + :is(.block-image, .gallery, .embed, .bgvideo)) { margin-top: 10px; }
  .blocks :global(.block-image) { display: block; line-height: 0; }
  .blocks :global(.block-text) { max-width: 640px; line-height: var(--leading-copy); }
  .blocks :global(.block-text :is(p, ul, ol, h5)) { margin: 0 0 var(--leading-copy); }
  .blocks :global(.block-text > :last-child) { margin-bottom: 0; }
  .blocks :global(.block-text h5) { color: var(--color-text); line-height: normal; }
  .blocks :global(.block-text :is(ul, ol)) { padding-left: 27px; }
  .blocks :global(.block-text li p) { margin: 0; }
  /* Wix renders content link blocks as its dark text button. */
  .blocks :global(.block-link) { margin-bottom: 0; }
  .blocks :global(.block-link a) {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 194px; height: 40px; padding: 0 20px; margin-left: -7px;
    background: var(--color-button); color: #fff; text-decoration: none;
    font: var(--weight-light) var(--size-body) / normal var(--font-ui); letter-spacing: 0.75px;
  }

  @media (max-width: 767px) {
    .hero { display: none; }
    .project { display: flex; flex-direction: column; width: calc(280 * var(--m)); margin-inline: auto; padding-bottom: 0; }
    .back { order: 1; margin: calc(-3 * var(--m)) 0 0; height: calc(78 * var(--m)); display: flex; align-items: center; justify-content: center; font-size: var(--size-ui-m); line-height: var(--leading-ui-m); }
    .title { margin-top: calc(30 * var(--m)); }
    .client, .copyright { line-height: calc(19.6 * var(--m)); letter-spacing: calc(0.14 * var(--m)); }
    .client { margin-top: calc(10 * var(--m)); }
    .copyright { margin-top: calc(20 * var(--m)); }
    .blocks { margin-top: calc(40 * var(--m)); }
    .blocks > :global(* + *) { margin-top: calc(30 * var(--m)); }
    .blocks > :global(:is(.block-text, .block-link) + :is(.block-image, .gallery, .embed, .bgvideo)) { margin-top: calc(10 * var(--m)); }
    .blocks > :global(:is(.block-image, .gallery, .embed, .bgvideo) + :is(.block-image, .gallery, .embed, .bgvideo)) { margin-top: calc(10 * var(--m)); }
    .blocks :global(.block-text) { max-width: none; line-height: var(--leading-copy-m); }
    .blocks :global(.block-text :is(p, ul, ol, h5)) { margin-bottom: var(--leading-copy-m); }
    .blocks :global(.block-text h5) { font-size: calc(21 * var(--m)); }
    .blocks :global(.block-text :is(ul, ol)) { padding-left: calc(25 * var(--m)); }
    .blocks :global(.block-link) { text-align: center; }
    .blocks :global(.block-link a) { min-width: calc(200 * var(--m)); height: calc(42 * var(--m)); padding: 0 calc(20 * var(--m)); margin-left: 0; font-size: calc(15 * var(--m)); letter-spacing: calc(0.75 * var(--m)); }
  }
</style>
