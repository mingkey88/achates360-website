---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import HeroMedia from '../components/ui/HeroMedia.astro';
import Sticker from '../components/ui/Sticker.astro';
import MetaStrip from '../components/MetaStrip.astro';
import ArtRows from '../components/ArtRows.astro';
import { autoArt } from '../lib/art';
import { meta } from '../lib/img';
import NextProject from '../components/NextProject.astro';
import { loadExtras } from '../lib/extras';
import { backLinkHref, withBase } from '../lib/paths';
import { nextProject, slugOf } from '../lib/next-project';
import { categorySlug } from '../lib/categories';
import { creativeWorkLd, breadcrumbLd } from '../lib/seo';
import { firstYear } from '../lib/meta';
import { visibleBlocks } from '../lib/visibility';
import { HELD_FROM_SEARCH } from '../lib/seo';
interface Props { entry: CollectionEntry<'projects'> }
const { id, data: d } = Astro.props.entry;
const { text } = await loadExtras();
const home = (await getEntry('home', 'home'))!.data;
const built = new Set((await getCollection('projects')).map((e) => e.id));
const order = home.allProjects.items.map((i) => slugOf(i.href)).filter((s): s is string => s !== null);
const next = nextProject(id, order, (s) => built.has(s));
const nextTitle = next ? (await getEntry('projects', next))!.data.title : text('next-fallback');
// The case study in the standard template (lib/art.ts autoArt), or a hand-made layout for this project
// if one has been made (src/content/art/<slug>.yaml). Pictures are arranged by their shape; films and
// embedded players count as 16:9.
const body = visibleBlocks(d.blocks, d.pageBackground);
const art = (await getEntry('art', id))?.data ?? autoArt(body, (m) => {
  if (m.kind !== 'image') return 16 / 9;
  const { width, height } = meta(m.src);
  return width / height;
});
const labels = { client: text('meta-client'), year: text('meta-year'), services: text('meta-services'), recognition: text('meta-recognition') };
// Share picture and structured data: the project's own hero, the case study, and where it sits
// (Projects › its first category › the project).
const shareImage = d.hero ? (d.hero.type === 'image' ? d.hero.src : d.hero.poster) : undefined;
const abs = (p: string) => new URL(withBase(p), Astro.site).href;
const cat = d.categories[0];
const jsonLd = [
  creativeWorkLd({ name: d.title, url: abs(`/${id}`), client: d.client, year: firstYear(d.copyright) ?? undefined, description: d.seo.description, categories: d.categories, publisherUrl: abs('/') }),
  breadcrumbLd([['Projects', abs('/projects')], ...(cat ? [[cat, abs(`/projects/${categorySlug(cat)}`)] as [string, string]] : []), [d.title, abs(`/${id}`)]]),
];
---
<Base title={d.seo.title} description={d.seo.description} ogImage={shareImage ?? d.seo.ogImage} ogAlt={d.title} ogType="article" jsonLd={jsonLd} page="project" noindex={HELD_FROM_SEARCH.has(`/${id}`)} overHero={!!d.hero}>
  <section class:list={['p-hero', { 'p-hero-plain': !d.hero }]}>
    {d.hero && <HeroMedia media={d.hero} fallbackAlt={d.title} />}
    <div class="p-hero-text wrap">
      {d.categories[0] && <Sticker>{d.categories[0]}</Sticker>}
      <h1 class="display h1" data-split>{d.title}</h1>
    </div>
  </section>
  {d.heroCaption && <p class="sr-only">{d.heroCaption}</p>}
  {/* Editorial layout (after Aesop and nationalgallery.sg articles): on wide screens the project's
      facts sit in a narrow column that stays in view, the story and pictures fill the rest. */}
  <div class="wrap p-layout">
    <aside class="p-meta"><MetaStrip client={d.client} copyright={d.copyright} categories={d.categories} badges={d.badges} labels={labels} /></aside>
    <article class="p-body"><ArtRows blocks={body} art={art} pageTitle={d.title} slug={id} /></article>
  </div>
  {d.backLink && (() => { const m = d.backLink.label.match(/^(←\s*)?(.*)$/)!; return <p class="wrap p-back"><a class="p-back-link" href={withBase(backLinkHref(d.backLink.href))}>{m[1] && <span aria-hidden="true">← </span>}<span class="sc">{m[2]}</span></a></p>; })()}
  <NextProject href={next ? `/${next}` : '/projects'} title={nextTitle} label={text('next-project')} discuss={{ label: text('discuss-cta'), href: '/contact' }} />
</Base>
<style>
  .p-hero { position: relative; display: flex; align-items: flex-end; min-height: 60svh; color: var(--white); isolation: isolate; }
  /* A darker shade at the top keeps the white header legible over light photographs. */
  .p-hero::after { content: ''; position: absolute; inset: 0; z-index: 0; background: linear-gradient(180deg, rgb(0 0 0 / .55), rgb(0 0 0 / 0) 30%, rgb(0 0 0 / 0) 55%, rgb(0 0 0 / .6)); pointer-events: none; }
  .p-hero-text { position: relative; z-index: 1; display: grid; justify-items: start; gap: var(--s-4); padding-block: var(--s-9) var(--s-7); }
  .p-hero-plain { min-height: 0; background: var(--teal-ink); color: var(--on-dark); }
  .p-hero-plain::after { display: none; }
  .p-layout { display: grid; gap: 0; }
  /* The strip is its own .wrap elsewhere; inside the layout's wrap it must not add the margins again. */
  .p-meta :global(.meta.wrap) { width: 100%; }
  .p-body { padding-block: var(--s-7) var(--s-8); min-width: 0; }
  @media (min-width: 1024px) {
    .p-layout { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); column-gap: var(--s-8); align-items: start; }
    .p-meta { position: sticky; top: calc(var(--header-h) + var(--s-6)); padding-block: var(--s-7); }
    .p-meta :global(.meta) { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); padding-block: 0; border-bottom: 0; }
    .p-meta :global(.meta-col) { padding-top: var(--s-4); border-top: 1px solid var(--line); }
  }
  .p-back { margin-block: 0; padding-bottom: var(--s-8); }
  @media (min-width: 768px) { .p-hero { min-height: 85svh; } }
  /* The supplied label is capitals (verbatim); shown in sentence case, after Aesop. */
  .p-back-link { display: inline-flex; align-items: center; gap: .4em; min-height: 44px; font-size: var(--fs-small); color: inherit; text-underline-offset: 4px; }
</style>
<script>
  import { run } from '../scripts/motion/index';
  import { reveal } from '../scripts/motion/reveal';
  run(reveal);
</script>
