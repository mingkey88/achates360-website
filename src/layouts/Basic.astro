---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Blocks from '../components/Blocks.astro';
interface Props { entry: CollectionEntry<'basic'> }
const { id, data: d } = Astro.props.entry;
---
<Base title={d.seo.title} description={d.seo.description} ogImage={d.seo.ogImage} bodyClass={`page-basic page-${id}`}>
  <div class="basic"><Blocks blocks={d.blocks} gallery="grid" pageTitle={d.seo.title} /></div>
</Base>
<style>
  /*
   * Each basic page is a one-off Wix layout; geometry measured on the live site at 1440 and on
   * iPhone 13 (Wix 320px mobile layout, lengths x --m per Ruling 21). The page-specific rules key
   * off the block order of the exported content.
   */
  .basic { width: min(var(--page-max), 100% - 2 * var(--gutter)); margin-inline: auto; padding: 120px 0 80px; }
  .basic :global(.block-image) { display: block; line-height: 0; }
  .basic :global(.block-text > :last-child) { margin-bottom: 0; }

  /*
   * /about: page background #2f2e2e. Back link top 157, right edge x=1047; text column x=329,
   * 518 wide, top 218, 20px with 25px lines (each paragraph ends in a blank line); photo
   * 798x446 at x=328, top 780; 65px to the footer.
   * Mobile: text 20/144, 280 wide, 14px; then the back link (280x78, centred); photo 25 below.
   */
  :global(body.page-about) { background: var(--color-page-dark); }
  :global(.page-about) .basic { width: min(798px, 100% - 2 * var(--gutter)); margin-left: max(var(--gutter), calc(50% - 392px)); padding: 153px 0 65px; }
  :global(.page-about) .basic :global(.block-link) { margin: 0; padding-right: 79px; text-align: right; font: var(--weight-light) var(--size-ui) / var(--leading-ui) var(--font-ui); }
  :global(.page-about) .basic :global(.block-link a) { color: #fff; text-decoration: none; }
  :global(.page-about) .basic :global(.block-text) { width: min(518px, 100%); margin: 41px 0 0 1px; color: var(--color-on-dark); font-size: 20px; line-height: 25px; }
  :global(.page-about) .basic :global(.block-text p) { margin: 0; }
  :global(.page-about) .basic :global(.block-image) { margin-top: 37px; }

  /*
   * /joinus: page background #f2f2f2. "Join us" 56px Helvetica Bold at x=183, top 136; the image
   * 452x452 below it (top 211); the job text column starts at x=618 (Wix lets the image overlap
   * it by 17px), 544 wide, top 211: h4 28px/39.2px bold orange, copy 15px/21px with a blank line
   * after each paragraph except bold labels; "Apply Now" is a 117x42 white pill with a 2px
   * #c74300 border; 100px to the footer.
   * Mobile: everything stacked at x=10: title 31px (top 100), image 280x280, text 26px heading,
   * "Apply Now" 160x42 centred.
   */
  :global(body.page-joinus) { background: var(--color-page-alt); }
  :global(.page-joinus) .basic {
    display: grid; grid-template-columns: minmax(0, 435fr) minmax(0, 544fr); align-items: start;
    width: min(979px, 100% - 2 * var(--gutter)); margin-left: max(var(--gutter), calc(50% - 537px)); padding: 132px 0 100px;
  }
  :global(.page-joinus) .basic > :global(:nth-child(1)) { grid-area: 1 / 1 / 2 / 3; }
  :global(.page-joinus) .basic > :global(:nth-child(2)) { grid-area: 2 / 1 / 4 / 2; position: relative; z-index: 1; width: calc(100% + 17px); margin-top: 8px; }
  :global(.page-joinus) .basic > :global(:nth-child(3)) { grid-area: 2 / 2; margin-top: 8px; }
  :global(.page-joinus) .basic > :global(:nth-child(4)) { grid-area: 3 / 2; }
  :global(.page-joinus) .basic :global(h1) { margin: 0; font-size: 56px; font-weight: 700; line-height: normal; }
  :global(.page-joinus) .basic :global(h4) { margin: 0 0 21px; color: var(--color-orange); font-size: 28px; line-height: 39.2px; }
  :global(.page-joinus) .basic :global(.block-text) { line-height: 21px; }
  :global(.page-joinus) .basic :global(.block-text p) { margin: 0 0 21px; }
  :global(.page-joinus) .basic :global(.block-text p:has(> strong:only-child)) { margin-bottom: 0; }
  :global(.page-joinus) .basic :global(.block-text ul) { margin: 0 0 21px; padding-left: 27px; }
  :global(.page-joinus) .basic :global(.block-text li p) { margin: 0; }
  :global(.page-joinus) .basic :global(.block-link) { margin: 0; }
  :global(.page-joinus) .basic :global(.block-link a) {
    display: inline-flex; align-items: center; justify-content: center; width: 117px; height: 42px;
    border: 2px solid var(--color-orange-dark); border-radius: 50px; background: #fff;
    color: var(--color-orange-dark); text-decoration: none;
    font: var(--weight-light) 16px / normal var(--font-ui); letter-spacing: 0.8px;
  }

  /*
   * /copy-of-projects (a duplicate of /projects): page background #f2f2f2; 956px column; each
   * section heading is a 28px h2, the 3-column gallery 25px below it.
   */
  :global(body.page-copy-of-projects) { background: var(--color-page-alt); }
  :global(.page-copy-of-projects) .basic { width: min(956px, 100% - 2 * var(--gutter)); padding: 77px 0 60px; }
  :global(.page-copy-of-projects) .basic :global(.block-text) { margin-bottom: 25px; }
  :global(.page-copy-of-projects) .basic :global(h2) { margin: 0; }
  :global(.page-copy-of-projects) .basic :global(.gallery) { margin-bottom: 30px; }

  @media (max-width: 767px) {
    .basic { width: calc(280 * var(--m)); padding: calc(30 * var(--m)) 0 calc(40 * var(--m)); }

    :global(.page-about) .basic { display: flex; flex-direction: column; width: calc(280 * var(--m)); margin-inline: auto; padding: calc(54 * var(--m)) 0 calc(20 * var(--m)); }
    :global(.page-about) .basic :global(.block-text) { order: 0; width: auto; margin: 0; font-size: calc(14 * var(--m)); line-height: calc(17.5 * var(--m)); }
    :global(.page-about) .basic :global(.block-link) { order: 1; display: flex; align-items: center; justify-content: center; height: calc(78 * var(--m)); margin-top: calc(8 * var(--m)); padding: 0; font-size: var(--size-ui-m); line-height: var(--leading-ui-m); }
    :global(.page-about) .basic :global(.block-image) { order: 2; margin-top: calc(25 * var(--m)); }

    :global(.page-joinus) .basic { display: block; width: calc(300 * var(--m)); margin-inline: auto; padding: calc(10 * var(--m)) 0 calc(40 * var(--m)); }
    :global(.page-joinus) .basic > :global(:nth-child(2)) { width: calc(280 * var(--m)); margin-top: calc(20 * var(--m)); }
    :global(.page-joinus) .basic > :global(:nth-child(3)) { margin-top: calc(20 * var(--m)); }
    :global(.page-joinus) .basic :global(h1) { font-size: calc(31 * var(--m)); }
    :global(.page-joinus) .basic :global(h4) { margin-bottom: calc(21 * var(--m)); font-size: calc(26 * var(--m)); line-height: calc(36.4 * var(--m)); }
    :global(.page-joinus) .basic :global(.block-text) { font-size: calc(15 * var(--m)); line-height: calc(21 * var(--m)); }
    :global(.page-joinus) .basic :global(.block-text :is(p, ul)) { margin-bottom: calc(21 * var(--m)); }
    :global(.page-joinus) .basic :global(.block-text ul) { padding-left: calc(27 * var(--m)); }
    :global(.page-joinus) .basic :global(.block-link) { text-align: center; }
    :global(.page-joinus) .basic :global(.block-link a) { width: calc(160 * var(--m)); height: calc(42 * var(--m)); font-size: calc(16 * var(--m)); letter-spacing: calc(0.8 * var(--m)); }

    :global(.page-copy-of-projects) .basic { width: calc(280 * var(--m)); padding-top: calc(25 * var(--m)); }
    :global(.page-copy-of-projects) .basic :global(.block-text) { margin-bottom: calc(17 * var(--m)); }
    :global(.page-copy-of-projects) .basic :global(h2) { font-size: calc(25 * var(--m)); }
    :global(.page-copy-of-projects) .basic :global(.gallery) { margin-bottom: calc(30 * var(--m)); }
  }
</style>
