---
/*
 * The home page enquiry section, as observed on the live site (Playwright, 1440x900 and iPhone 13).
 *
 * Desktop: a 781px white section. The heading (Helvetica Bold 45px, #605e5e) sits 8px left of
 *   the 980px grid and 287px down, 393px wide. The form box is 448px wide at grid+574, 13px down;
 *   its fields run 59px in, 347px wide:
 *   - Name / Company / Email: label Helvetica Light 20px/20px #2f2e2e with Wix's " *", input 29px
 *     below (Avenir Light 14px/19.6px, 1px #2f2e2e underline, padding 3 3 3 7), a 90px pitch;
 *   - the two checkbox groups side by side (second at +160): legend 20px black in a 40px box,
 *     options on a 27px pitch, an 18px white box with a 1px black border, text Helvetica Light
 *     15px black 26px in. Wix colours the second group's legend ("Selection 2") white on the
 *     white page, so only screen readers get it;
 *   - the message box (347x106, 1px black border, white, padding 11.25 10 3 7, placeholder grey);
 *   - Submit: 347x40, #adadac with a 1px rgb(48,189,255) border, label Avenir Light 20px white;
 *   - "Thanks for submitting!" (Avenir Light 14px #605e5e, centred) under it, hidden until sent.
 *   An empty submit outlines every missing field in #df3131 (Wix shows no message text).
 * Mobile (Wix's 320px layout, lengths x --m): a 1033px section; heading 23px, centred, at
 *   (17, 71) 287 wide; form at (10, 169) 300 wide, fields 20 in and 260 wide on a 77px pitch,
 *   inputs 38 tall at 15px; the two groups stack (options 10 in, 27 pitch, the second group's
 *   blank legend takes no room); message box 260x42; Submit 260x35, label 18.67px.
 *
 * Field names: Wix's message box has no name, so it posts as `message`; the checkbox groups post
 * as group-1 / group-2 (Wix's comp-… ids mean nothing to a form backend). Labels and placeholders
 * are verbatim.
 */
import { renderMd } from '../lib/markdown';
interface Field { name: string; type: string; label: string; required: boolean; placeholder?: string }
interface Group { name: string; label: string; required: boolean; options: string[] }
interface Props { md: string[]; form: { fields: Field[]; groups: Group[]; submitLabel: string } }
const { md, form } = Astro.props;
const success = md.find((m) => m.startsWith('Thanks for submitting'));
const intro = md.filter((m) => m !== success);
// Wix lays the single-line fields out first, then the checkbox groups, then the message box.
const lines = form.fields.filter((f) => f.type !== 'textarea');
const boxes = form.fields.filter((f) => f.type === 'textarea');
// The record's types are HTML input types (text, email).
const inputType = (f: Field) => f.type as astroHTML.JSX.HTMLInputTypeAttribute;
const autocomplete = (f: Field) => ({ name: 'name', company: 'organization', email: 'email' } as Record<string, string>)[f.name];
const fieldName = (f: Field) => f.name || (f.type === 'textarea' ? 'message' : 'field');
---
<section id="contact" class="contact">
  <div class="intro">
    {intro.map((m) => <div set:html={renderMd(m)} />)}
  </div>
  <form class="enquiry" novalidate>
    {lines.map((f) => (
      <label class="field">
        <span class="label">{f.label}{f.required && <span class="req" aria-hidden="true"> *</span>}</span>
        <input type={inputType(f)} name={fieldName(f)} required={f.required} placeholder={f.placeholder} autocomplete={autocomplete(f)} />
      </label>
    ))}
    <div class="groups">
      {form.groups.map((g, i) => (
        <fieldset class="group" data-required={g.required ? 'true' : 'false'} aria-describedby={g.required ? `group-error-${i + 1}` : undefined}>
          <legend>{g.label}{g.required && <span class="req" aria-hidden="true"> *</span>}{g.required && <span class="sr-only"> Required</span>}</legend>
          {g.options.map((o) => (
            <label class="option"><input type="checkbox" name={`group-${i + 1}`} value={o} /><span>{o}</span></label>
          ))}
          {/* An alert region, always rendered so screen readers announce the text when it is set. */}
          {g.required && <p class="group-error" id={`group-error-${i + 1}`} role="alert" data-message="Please choose at least one."></p>}
        </fieldset>
      ))}
    </div>
    {boxes.map((f) => (
      f.label
        ? <label class="field box"><span class="label">{f.label}</span><textarea name={fieldName(f)} required={f.required} placeholder={f.placeholder}></textarea></label>
        /* Wix's message box has no label: its placeholder (verbatim) names it for screen readers. */
        : <textarea class="box" name={fieldName(f)} required={f.required} placeholder={f.placeholder} aria-label={f.placeholder || undefined}></textarea>
    ))}
    <button type="submit">{form.submitLabel}</button>
    <p class="status" role="status" aria-live="polite"></p>
    {success && <div class="success" hidden set:html={renderMd(success)} />}
  </form>
</section>
<script>
  import { PUBLIC_FORM_ENDPOINT } from 'astro:env/client';
  for (const form of document.querySelectorAll<HTMLFormElement>('form.enquiry')) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const groups = [...form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-required="true"]')];
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const success = form.querySelector<HTMLElement>('.success');
    const checkGroup = (fs: HTMLFieldSetElement) => {
      const any = fs.querySelector('input:checked') !== null;
      const error = fs.querySelector<HTMLElement>('.group-error')!;
      const text = any ? '' : error.dataset.message!;
      if (error.textContent !== text) error.textContent = text;
      fs.classList.toggle('invalid', !any);
      return any;
    };
    // Once a submit has been tried, keep the error state in step with what the visitor fixes.
    form.addEventListener('change', (e) => {
      const fs = (e.target as Element).closest<HTMLFieldSetElement>('fieldset[data-required="true"]');
      if (fs && form.classList.contains('tried')) checkGroup(fs);
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submit.getAttribute('aria-disabled') === 'true') return; // a post is in flight
      // A new attempt clears the last outcome.
      success?.setAttribute('hidden', '');
      status.textContent = '';
      form.classList.add('tried');
      let ok = form.checkValidity();
      for (const fs of groups) ok = checkGroup(fs) && ok;
      if (!ok) {
        if (!form.checkValidity()) form.reportValidity();
        else groups.find((fs) => fs.classList.contains('invalid'))?.querySelector('input')?.focus();
        return;
      }
      if (!PUBLIC_FORM_ENDPOINT) { status.textContent = 'Form not connected on staging'; return; }
      status.textContent = 'Sending…';
      // No second post while the first is in flight. aria-disabled (not disabled) keeps focus on
      // the button instead of dropping it to <body>.
      submit.setAttribute('aria-disabled', 'true');
      try {
        const res = await fetch(PUBLIC_FORM_ENDPOINT, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        form.classList.remove('tried');
        status.textContent = '';
        success?.removeAttribute('hidden');
      } catch {
        status.textContent = 'Sorry, something went wrong. Please email hello@achates360.com.';
      } finally {
        submit.removeAttribute('aria-disabled');
      }
    });
  }
</script>
<style>
  .contact { background: var(--accent); color: var(--ink); padding-block: var(--section-y); }
  .contact { display: grid; gap: var(--s-7); padding-inline: max(var(--gutter), calc((100% - var(--max)) / 2)); }
  .intro :global(h2) { margin: 0; font: 400 var(--fs-h2)/var(--lh-display) var(--font-display); text-wrap: balance; overflow-wrap: anywhere; }
  .enquiry { display: grid; gap: var(--s-4); }
  .field { display: grid; gap: 6px; }
  .label, legend { font: 500 var(--fs-label)/1.2 var(--font-text); letter-spacing: .1em; text-transform: uppercase; }
  input:not([type='checkbox']), textarea {
    width: 100%; min-height: 48px; padding: 12px 18px; border: 1.5px solid var(--ink); border-radius: var(--r-pill);
    background: rgb(246 241 238 / .9); color: var(--ink); font: 400 var(--fs-body)/1.4 var(--font-text);
  }
  .tried :is(input:not([type='checkbox']), textarea):invalid { border-style: dashed; border-width: 2.5px; }
  .enquiry ::placeholder { color: #5c5757; opacity: 1; }
  textarea { min-height: 140px; border-radius: var(--r-card); resize: vertical; }
  .groups { display: grid; gap: var(--s-4); }
  .group { margin: 0; padding: 0; border: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .group legend { margin-bottom: var(--s-2); }
  .option { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1.5px solid var(--ink); border-radius: var(--r-pill); cursor: pointer; }
  .option input { width: 18px; height: 18px; accent-color: var(--ink); }
  .group.invalid .option { border-style: dashed; }
  .group-error { width: 100%; margin: 0; font-size: var(--fs-small); font-weight: 500; }
  .req { color: inherit; }
  button[type='submit'] {
    justify-self: start; min-height: 52px; padding: 12px 32px 9px; border: 0; border-radius: var(--r-pill);
    background: var(--ink); color: var(--accent); font: 400 1.5rem/1 var(--font-display); letter-spacing: .04em; cursor: pointer;
  }
  button[type='submit'][aria-disabled='true'] { opacity: .6; }
  .status { margin: 0; min-height: 1.5em; font-weight: 500; }
  .success :global(*) { margin: 0; font: 400 var(--fs-h3)/1 var(--font-display); }
  .contact :focus-visible { outline-color: var(--ink); }
  @media (min-width: 1024px) { .contact { grid-template-columns: 1fr 1.2fr; align-items: start; } }
</style>
