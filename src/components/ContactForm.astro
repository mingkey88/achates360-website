---
/*
 * The home page enquiry section. The intro text, field labels, placeholders, checkbox groups and
 * submit label come verbatim from home.md; only the styling is the redesign's (direction B: an
 * form after Aesop: boxed fields with labels above, a grid of square checkboxes, one solid submit).
 *
 * Field names: the message box has no name in the export, so it posts as `message`; the checkbox
 * groups post as group-1 (Wix's overflow group "Selection 2" is joined onto the services list). Submit posts the FormData to PUBLIC_FORM_ENDPOINT (staging
 * without one says so). Each required checkbox group is validated in script, with an alert region
 * per group and a dashed outline once a submit has been tried.
 */
import { renderMd } from '../lib/markdown';
import T from './ui/T.astro';
import LogoSketch from './LogoSketch.astro';
import type { UiString } from '../lib/strings';
import { mergeContinuationGroups } from '../lib/form';
interface Field { name: string; type: string; label: string; required: boolean; placeholder?: string }
interface Group { name: string; label: string; required: boolean; options: string[] }
// heading: a draft replacement for the supplied intro ("Drop us a message…"), pending approval
// (CONTENT-QUERIES 23); the supplied text stays in home.md.
// direct: the studio's email and phone from the footer, offered beside the form for those who would
// rather write or call.
interface Props { md: string[]; form: { fields: Field[]; groups: Group[]; submitLabel: string }; heading?: UiString; direct?: { label: UiString; email?: string; phone?: string } }
const { md, form, heading, direct } = Astro.props;
const success = md.find((m) => m.startsWith('Thanks for submitting'));
const intro = md.filter((m) => m !== success);
// Wix lays the single-line fields out first, then the checkbox groups, then the message box.
const lines = form.fields.filter((f) => f.type !== 'textarea');
const boxes = form.fields.filter((f) => f.type === 'textarea');
// The record's types are HTML input types (text, email).
const inputType = (f: Field) => f.type as astroHTML.JSX.HTMLInputTypeAttribute;
const autocomplete = (f: Field) => ({ name: 'name', company: 'organization', email: 'email' } as Record<string, string>)[f.name];
const fieldName = (f: Field) => f.name || (f.type === 'textarea' ? 'message' : 'field');
// Wix's second "Selection 2" group is the overflow of the services list: shown as one list.
const groups = mergeContinuationGroups(form.groups);
---
<section id="contact" class="contact">
  <LogoSketch id="contact-sketch" class="c-sketch" />
  <div class="inner">
    <div class="intro">
      {heading ? <h2><T s={heading} /></h2> : intro.map((m) => <div set:html={renderMd(m)} />)}
      {direct && (direct.email || direct.phone) && (
        <div class="direct">
          <p class="direct-l"><T s={direct.label} /></p>
          {direct.email && <p><a href={`mailto:${direct.email}`}>{direct.email}</a></p>}
          {direct.phone && <p><a href={`tel:${direct.phone.replace(/\s+/g, '')}`}>{direct.phone}</a></p>}
        </div>
      )}
    </div>
    <form class="enquiry" novalidate>
      <div class="lines">
        {lines.map((f) => (
          <label class:list={['field', { wide: f.type === 'email' }]}>
            <span class="flabel">{f.label}{f.required && <span class="req" aria-hidden="true"> *</span>}</span>
            <input type={inputType(f)} name={fieldName(f)} required={f.required} autocomplete={autocomplete(f)} aria-describedby={f.required ? `err-${fieldName(f)}` : undefined} />
            {f.required && <span class="field-error" id={`err-${fieldName(f)}`}></span>}
          </label>
        ))}
      </div>
      {groups.map((g, i) => (
        <fieldset class="group" data-required={g.required ? 'true' : 'false'} aria-describedby={g.required ? `group-error-${i + 1}` : undefined}>
          <legend class="flabel">{g.label}{g.required && <span class="req" aria-hidden="true"> *</span>}{g.required && <span class="sr-only"> Required</span>}</legend>
          <div class="options">
            {g.options.map((o) => (
              <label class="option"><input type="checkbox" name={`group-${i + 1}`} value={o} /><span class="box" aria-hidden="true"></span><span>{o}</span></label>
            ))}
          </div>
          {/* An alert region, always rendered so screen readers announce the text when it is set. */}
          {g.required && <p class="group-error" id={`group-error-${i + 1}`} role="alert" data-message="Please choose at least one."></p>}
        </fieldset>
      ))}
      {boxes.map((f) => (
        f.label
          ? <label class="field"><span class="flabel">{f.label}{f.required && <span class="req" aria-hidden="true"> *</span>}</span><textarea name={fieldName(f)} required={f.required} placeholder={f.placeholder} rows="6" aria-describedby={f.required ? `err-${fieldName(f)}` : undefined}></textarea>{f.required && <span class="field-error" id={`err-${fieldName(f)}`}></span>}</label>
          /* Wix's message box has no label: its placeholder (verbatim) shows in the box and names it for screen readers. */
          : <div class="field"><textarea name={fieldName(f)} required={f.required} placeholder={f.placeholder} aria-label={f.placeholder || undefined} rows="6" aria-describedby={f.required ? `err-${fieldName(f)}` : undefined}></textarea>{f.required && <span class="field-error" id={`err-${fieldName(f)}`}></span>}</div>
      ))}
      <div class="send-row">
        <button type="submit" class="send">{form.submitLabel}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></button>
        <p class="status" role="status" aria-live="polite"></p>
      </div>
      {success && <div class="success" hidden set:html={renderMd(success)} />}
    </form>
  </div>
</section>
<script>
  import { PUBLIC_FORM_ENDPOINT } from 'astro:env/client';
  for (const form of document.querySelectorAll<HTMLFormElement>('form.enquiry')) {
    const status = form.querySelector<HTMLElement>('.status')!;
    const groups = [...form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-required="true"]')];
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const success = form.querySelector<HTMLElement>('.success');
    const checkGroup = (fs: HTMLFieldSetElement) => {
      const any = fs.querySelector('input:checked') !== null;
      const error = fs.querySelector<HTMLElement>('.group-error')!;
      const text = any ? '' : error.dataset.message!;
      if (error.textContent !== text) error.textContent = text;
      fs.classList.toggle('invalid', !any);
      return any;
    };
    // Text fields: the browser's own validity, shown inline (not as a browser bubble) and
    // announced through aria-invalid + aria-describedby.
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.field :is(input, textarea)[required]')];
    const checkField = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const ok = el.checkValidity();
      const error = document.getElementById(el.getAttribute('aria-describedby') ?? '');
      const text = ok ? '' : el.validity.typeMismatch ? 'Please enter a valid email address.' : 'Please fill in this field.';
      if (error && error.textContent !== text) error.textContent = text;
      if (ok) el.removeAttribute('aria-invalid'); else el.setAttribute('aria-invalid', 'true');
      return ok;
    };
    // Once a submit has been tried, keep the error state in step with what the visitor fixes.
    form.addEventListener('change', (e) => {
      if (!form.classList.contains('tried')) return;
      const fs = (e.target as Element).closest<HTMLFieldSetElement>('fieldset[data-required="true"]');
      if (fs) checkGroup(fs);
    });
    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (form.classList.contains('tried') && fields.includes(el)) checkField(el);
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submit.getAttribute('aria-disabled') === 'true') return; // a post is in flight
      // A new attempt clears the last outcome.
      success?.setAttribute('hidden', '');
      status.textContent = '';
      form.classList.add('tried');
      let ok = true;
      for (const el of fields) ok = checkField(el) && ok;
      for (const fs of groups) ok = checkGroup(fs) && ok;
      if (!ok) {
        // First problem in reading order; scroll-padding keeps it clear of the sticky header.
        const first = fields.find((el) => el.hasAttribute('aria-invalid'))
          ?? groups.find((fs) => fs.classList.contains('invalid'))?.querySelector('input');
        first?.focus();
        return;
      }
      if (!PUBLIC_FORM_ENDPOINT) { status.textContent = 'Form not connected on staging'; return; }
      status.textContent = 'Sending…';
      // No second post while the first is in flight. aria-disabled (not disabled) keeps focus on
      // the button instead of dropping it to <body>.
      submit.setAttribute('aria-disabled', 'true');
      try {
        const res = await fetch(PUBLIC_FORM_ENDPOINT, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        form.classList.remove('tried');
        status.textContent = '';
        success?.removeAttribute('hidden');
      } catch {
        status.textContent = 'Sorry, something went wrong. Please email hello@achates360.com.';
      } finally {
        submit.removeAttribute('aria-disabled');
      }
    });
  }
</script>
<style>
  /* Direction B (after Aesop): one centred column. Boxed fields with small labels above, the service
     choices as an even grid of square checkboxes, a proper message box and one solid button. */
  .contact { position: relative; isolation: isolate; overflow: clip; background: var(--blush); color: var(--ink); padding: var(--section-y) var(--gutter); }
  .contact > :global(.c-sketch) { position: absolute; z-index: -1; left: -6vw; bottom: -4vw; width: clamp(220px, 30vw, 460px); color: rgb(51 51 51 / .12); }
  .inner { max-width: 760px; margin-inline: auto; display: grid; gap: var(--s-7); }
  .intro { text-align: center; display: grid; gap: var(--s-5); align-content: start; }
  .direct { display: grid; gap: 4px; justify-items: center; font-size: var(--fs-lead); }
  .direct p { margin: 0; }
  .direct .direct-l { margin-bottom: 4px; font-size: var(--fs-small); color: var(--text-2); }
  .direct a { color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .direct a:hover { color: var(--accent-deep); }
  .intro :global(h2) { margin: 0 auto; max-width: 22ch; font: 400 var(--fs-h2)/1.25 var(--font-display); text-wrap: balance; }
  /* Wide screens: the invitation and the direct lines beside the form, staying in view while it is filled in. */
  @media (min-width: 1024px) {
    .inner { max-width: 1180px; grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr); column-gap: var(--s-9); align-items: start; }
    .intro { position: sticky; top: calc(var(--header-h) + var(--s-6)); text-align: left; }
    .intro :global(h2) { margin: 0; text-align: left; }
    .direct { justify-items: start; padding-top: var(--s-5); border-top: 1px solid rgb(51 51 51 / .25); }
  }
  .enquiry { display: grid; gap: var(--s-6); }
  .lines { display: grid; gap: var(--s-5); }
  .field { display: grid; gap: var(--s-2); }
  .flabel { padding: 0; font: 400 var(--fs-small)/1.3 var(--font-text); color: var(--ink); }
  .req { color: var(--text-2); }
  .field input, .field textarea {
    width: 100%; min-height: 52px; padding: 14px 16px; border: 1px solid rgb(51 51 51 / .45); border-radius: 0;
    background: var(--paper); color: var(--ink); font: 400 var(--fs-body)/1.4 var(--font-text); transition: border-color .2s;
  }
  .field textarea { min-height: 168px; resize: vertical; }
  .field :is(input, textarea):hover { border-color: var(--ink); }
  .field :is(input, textarea):focus { outline: 2px solid var(--ink); outline-offset: 0; border-color: var(--ink); }
  .field textarea::placeholder { color: var(--text-2); opacity: 1; }
  .tried .field :is(input, textarea):invalid { border-color: var(--accent-deep); box-shadow: inset 0 0 0 1px var(--accent-deep); }

  .group { margin: 0; padding: 0; border: 0; min-width: 0; }
  .group legend { margin-bottom: var(--s-3); }
  .options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid rgb(51 51 51 / .18); }
  .option { position: relative; display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 6px 0; border-bottom: 1px solid rgb(51 51 51 / .18); font-size: var(--fs-small); cursor: pointer; }
  .option input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .box { flex: none; position: relative; width: 18px; height: 18px; border: 1px solid var(--ink); background: var(--paper); transition: background-color .2s; }
  .box::after { content: ''; position: absolute; left: 5px; top: 1px; width: 5px; height: 10px; border: solid var(--paper); border-width: 0 1.5px 1.5px 0; rotate: 45deg; opacity: 0; }
  .option input:checked + .box { background: var(--ink); }
  .option input:checked + .box::after { opacity: 1; }
  .option input:focus-visible + .box { outline: 2px solid var(--ink); outline-offset: 2px; }
  .group.invalid .box { border-color: var(--accent-deep); }
  .field-error { font-size: var(--fs-small); color: var(--accent-deep); }
  .field-error:empty { display: none; }
  .group-error { margin: var(--s-3) 0 0; font-size: var(--fs-small); color: var(--accent-deep); }
  .group-error:empty { display: none; }

  .send-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4); }
  .send {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 40px;
    border: 1px solid var(--ink); border-radius: 0; background: var(--ink); color: var(--paper); cursor: pointer;
    font: 400 var(--fs-body)/1 var(--font-text); transition: background-color .3s, color .3s;
  }
  .send svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.4; transition: transform .4s var(--ease-out); }
  .send:is(:hover, :focus-visible) { background: transparent; color: var(--ink); }
  .send:is(:hover, :focus-visible) svg { transform: translateX(4px); }
  .send[aria-disabled='true'] { opacity: .5; }
  .status { margin: 0; min-height: 1.5em; font-size: var(--fs-small); }
  .success { padding: var(--s-6); background: var(--paper); text-align: center; }
  .success :global(*) { margin: 0; font: 400 var(--fs-h3)/1.3 var(--font-display); }
  .contact :focus-visible { outline-color: var(--ink); }

  @media (min-width: 640px) {
    .lines { grid-template-columns: 1fr 1fr; }
    .field.wide { grid-column: 1 / -1; }
    .options { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--s-5); }
  }
  @media (max-width: 479px) { .send { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .send, .send svg, .box, .field :is(input, textarea) { transition: none; } }
</style>
