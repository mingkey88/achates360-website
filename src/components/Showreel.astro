---
import BgVideo from './BgVideo.astro';
import FilmDialog from './ui/FilmDialog.astro';
import { loadExtras } from '../lib/extras';
// The studio's showreel on the Services page: a silent cut (24 s of the film, no sound) looping in place
// while it is on screen, within the page's margins. "Play with sound" opens the full film (FilmDialog).
// Swap the files in public/media/video to update the reel; the poster is a still from it. (The homepage
// shows the same loop full-screen as its hero, VideoHero.astro.)
interface Props { label: string; playLabel: string; closeLabel: string; draft: boolean; src: string; preview: string; poster: ImageMetadata; duration: string }
const { label, playLabel, closeLabel, draft, src, preview, poster, duration } = Astro.props;
const { text: t } = await loadExtras();
---
<section class="sr wrap" aria-label={label}>
  <div class="sr-head">
    <p class="sr-label" data-placeholder={draft ? '' : undefined}>{label}</p>
    <p class="sr-dur">{duration}</p>
  </div>
  <div class="sr-frame">
    <BgVideo src={preview} poster={poster} class="sr-loop" pauseLabel={t('video-pause').text} playLabel={t('video-play').text} draft={t('video-pause').placeholder} />
  </div>
  {/* Beneath the film, not on it: the reel carries its own captions at its foot (review, 24 Oct 2026). */}
  <button class="sr-play" type="button" data-film="showreel-film" data-placeholder={draft ? '' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg>
    <span>{playLabel}</span>
  </button>
  <FilmDialog id="showreel-film" label={label} closeLabel={closeLabel} src={src} poster={poster} />
</section>
<style>
  .sr { padding-block: 0 var(--s-8); }
  .sr-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: var(--s-3); margin-bottom: var(--s-5); border-bottom: 1px solid var(--line); font-size: var(--fs-small); }
  .sr-head p { margin: 0; }
  .sr-dur { color: var(--text-2); font-variant-numeric: tabular-nums; }
  .sr-frame { position: relative; aspect-ratio: 16 / 9; background: var(--ink); }
  .sr-frame :global(.sr-loop), .sr-frame :global(.sr-loop video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sr-frame :global(.bv-toggle) { z-index: 2; top: auto; bottom: var(--s-5); right: var(--s-5); }
  .sr-play {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-top: var(--s-4);
    padding: 12px 20px 12px 16px; border: 1px solid var(--ink); background: var(--paper); color: var(--ink); cursor: pointer; font: 400 var(--fs-small)/1 var(--font-text);
    transition: background-color .25s, color .25s;
  }
  .sr-play:hover { background: var(--ink); color: var(--paper); }
  .sr-play svg { width: 14px; height: 14px; fill: currentColor; }
  @media (max-width: 767px) {
    .sr-frame :global(.bv-toggle) { bottom: var(--s-3); right: var(--s-3); }
  }
</style>
