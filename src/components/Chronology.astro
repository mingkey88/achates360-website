---
import Pic from './ui/Pic.astro';
import RunningHead from './ui/RunningHead.astro';
import DraftTag from './ui/DraftTag.astro';
import { withBase } from '../lib/paths';
import type { UiString } from '../lib/strings';
// The studio's story on /about. Without motion (and on phones) a book's chronology: one ruled row per
// milestone, the year set large, the project and its line, a small plate; each row opens the case study.
// With motion on wide screens (motion/story.ts) the same rows become one stage that holds still while
// you scroll: the year rolls over to the next, the project's plate and line change beside it, and a
// ruler of the years along the foot marks where you are. Years and titles come from the projects (spec
// §6.2); only the lines are new copy.
interface Item { id: string; year: string; label: string; body: string; image: ImageMetadata; alt: string; href: string; placeholder: boolean }
interface Props { items: Item[]; heading: UiString }
const { items, heading } = Astro.props;
const years = items.map((i) => i.year).sort();
const span = years.length ? `${years[0]} – ${years[years.length - 1]}` : '';
---
<section class="chron wrap section" aria-labelledby="chron-title" data-chron>
  <RunningHead id="chron-title" s={heading} folio={span} />
  <ol class="chron-list">
    {items.map((it, i) => (
      <li class="chron-item" data-i={i} data-placeholder={it.placeholder ? '' : undefined}>
        <a class="chron-row" href={withBase(it.href)}>
          <span class="chron-year">{it.year}</span>
          <span class="chron-text">
            <span class="chron-title">{it.label}</span>
            <span class="chron-body">{it.body}<DraftTag when={it.placeholder} /></span>
            <span class="chron-more" aria-hidden="true">→</span>
          </span>
          <span class="chron-plate crop" aria-hidden="true"><Pic src={it.image} alt="" crop={4 / 3} widths={[240, 480, 720, 960]} sizes="(max-width: 767px) 30vw, (max-width: 1023px) 200px, 40vw" loading="lazy" /></span>
        </a>
      </li>
    ))}
  </ol>
  {/* The ruler of years (story mode only): a tick per milestone, the current one inked. */}
  <ol class="chron-ruler" aria-hidden="true">
    {items.map((it, i) => <li data-tick={i}><span>{it.year}</span></li>)}
  </ol>
</section>
<style>
  .chron-list { list-style: none; margin: 0; padding: 0; }
  .chron-row {
    display: grid; grid-template-columns: 5.5rem minmax(0, 1fr) 30vw; align-items: start; gap: var(--s-4);
    padding-block: var(--s-5); border-bottom: 1px solid var(--line); color: inherit; text-decoration: none;
  }
  .chron-year { font: 400 clamp(1.75rem, 1.2rem + 2.4vw, 3.5rem)/.95 var(--font-display); letter-spacing: -.03em; font-variant-numeric: lining-nums tabular-nums; }
  .chron-text { display: grid; gap: var(--s-2); align-content: start; padding-top: .3em; }
  .chron-title { font: 400 var(--fs-h3)/1.25 var(--font-display); text-wrap: balance; }
  .chron-body { font-size: var(--fs-small); line-height: 1.55; color: var(--text-2); max-width: 46ch; }
  .chron-more { display: none; }
  .chron-plate { position: relative; display: block; --cm-len: 8px; --cm-gap: 4px; }
  .chron-plate :global(img) { display: block; width: 100%; height: auto; }
  .chron-row:hover .chron-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .chron-ruler { display: none; }
  @media (min-width: 768px) {
    .chron-row { grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr); column-gap: var(--s-5); padding-block: var(--s-6); }
    .chron-plate { width: min(100%, 200px); justify-self: end; }
  }

  /* Story mode (motion/story.ts, wide screens): one stage, a screen tall, held while the milestones turn. */
  /* The held stage's own paper and grid, the full page width (the stage itself is the narrower .wrap), so
     the background stands still with it (motion/story.ts sets --grid-y and --page-w). */
  .chron.is-story { position: relative; isolation: isolate; }
  .chron.is-story::before {
    content: ''; position: absolute; top: 0; bottom: 0; left: calc(50% - var(--page-w, 100vw) / 2); width: var(--page-w, 100vw); z-index: -1;
    background: var(--paper-tex), var(--grid), var(--paper);
    background-position: 0 var(--grid-y, 0), 50% var(--grid-y, 0), 50% var(--grid-y, 0), 50% var(--grid-y, 0), 50% var(--grid-y, 0);
  }
  .chron.is-story { height: 100svh; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; padding-block: calc(var(--header-h) + var(--s-5)) var(--s-6); }
  .is-story .chron-list { position: relative; min-height: 0; }
  .is-story .chron-item { position: absolute; inset: 0; pointer-events: none; }
  .is-story .chron-item.is-on { pointer-events: auto; }
  .is-story .chron-row { height: 100%; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: auto 1fr; column-gap: var(--s-8); align-items: center; border: 0; padding: var(--s-7) 0 var(--s-5); }
  .is-story .chron-year { grid-column: 1; grid-row: 1; align-self: end; font-size: clamp(6rem, 3rem + 9vw, 13rem); line-height: .8; letter-spacing: -.05em; }
  .is-story .chron-text { grid-column: 1; grid-row: 2; align-self: start; padding-top: var(--s-5); border-top: 1px solid var(--ink); margin-top: var(--s-5); }
  .is-story .chron-title { font-size: var(--fs-h2); }
  .is-story .chron-body { font-size: var(--fs-body, 1rem); }
  .is-story .chron-more { display: block; font-size: var(--fs-lead); }
  .is-story .chron-plate { grid-column: 2; grid-row: 1 / 3; width: 100%; max-width: 760px; justify-self: end; align-self: center; --cm-len: 10px; --cm-gap: 6px; }
  /* Each milestone's parts arrive in turn: the year rolls up into place, the line follows, the plate
     settles; the one before leaves upwards. */
  .is-story :is(.chron-year, .chron-text, .chron-plate) { opacity: 0; transform: translateY(18%); transition: opacity .5s var(--ease-out), transform .7s var(--ease-out); }
  .is-story .chron-plate { transform: translateY(4%) scale(.97); }
  .is-story .is-on :is(.chron-year, .chron-text, .chron-plate) { opacity: 1; transform: none; }
  .is-story .is-on .chron-text { transition-delay: .08s; }
  .is-story .is-on .chron-plate { transition-delay: .12s; }
  .is-story .is-past :is(.chron-year, .chron-text) { transform: translateY(-18%); }
  .is-story .is-past .chron-plate { transform: translateY(-4%) scale(.97); }
  .is-story .chron-ruler { display: flex; justify-content: space-between; gap: var(--s-3); margin: 0; padding: var(--s-3) 0 0; list-style: none; border-top: 1px solid var(--line); }
  .is-story .chron-ruler li { position: relative; flex: 1; font-size: var(--fs-small); font-variant-numeric: tabular-nums; color: var(--text-2); transition: color .3s; }
  .is-story .chron-ruler li::before { content: ''; position: absolute; left: 0; top: calc(-1 * var(--s-3) - 1px); width: 100%; height: 2px; background: var(--ink); transform: scaleX(0); transform-origin: left; transition: transform .5s var(--ease-out); }
  .is-story .chron-ruler li.is-done::before, .is-story .chron-ruler li.is-on::before { transform: scaleX(1); }
  .is-story .chron-ruler li.is-on { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { .is-story * { transition: none !important; } }
</style>
