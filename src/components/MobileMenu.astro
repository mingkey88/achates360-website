---
/*
 * Mobile site menu, as observed on the live site (Playwright, iPhone 13; Wix's 320px layout,
 * lengths x --m).
 *
 * The menu button sits in the 90px header band at (254, 10), 50x53: three white bars, 20 wide and
 * 3 thick, 8 apart, starting 15 in and 18.5 down. It opens a full-screen overlay,
 * rgba(47,46,46,.75), over the page and header; the button turns into a white "X" (two 3px bars
 * crossing at its centre). The list starts 80px down, centred: items Helvetica Bold 20px/28px,
 * letter-spacing 2px, white (the current page #f2f2f2), 20px either side and 10px above and
 * below (48px rows). An item with a sub-menu has a +/- toggle 36px wide just left of its label (no
 * left padding on that label);
 * the sub-menu is open when it holds the current page. Sub-items are 18px/28px, at most 280px
 * wide (they wrap). The overlay scrolls when the list is longer than the screen.
 *
 * Accessibility: a modal <dialog> (Escape closes; focus returns to the menu button); toggles are
 * buttons with aria-expanded / aria-controls, labelled like Wix's desktop toggle ("More X pages").
 */
import { withBase, menuCurrent } from '../lib/paths';
interface Link { label: string; href: string }
interface Props { menu: (Link & { items?: Link[] })[]; path: string }
const { menu, path } = Astro.props;
---
<button class="mmenu-open" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
  <svg viewBox="0 0 50 53" aria-hidden="true"><path d="M15 18.5h20M15 26.5h20M15 34.5h20" /></svg>
</button>
<dialog id="mobile-menu" class="mobile-menu" aria-label="Menu">
  <nav aria-label="Site">
    <ul class="items">
      {menu.map((it, i) => {
        const current = menuCurrent(it, path);
        const link = <a href={withBase(it.href)} aria-current={current === 'page' ? 'page' : undefined}>{it.label}</a>;
        return (
          <li class:list={['item', { current: current === 'page' }]}>
            {it.items
              ? (
                <>
                  <div class="row">
                    <button class="sub-toggle" type="button" aria-expanded={current === 'parent' ? 'true' : 'false'} aria-controls={`mobile-menu-sub-${i}`} aria-label={`More ${it.label} pages`}></button>
                    {link}
                  </div>
                  <ul class="sub" id={`mobile-menu-sub-${i}`} hidden={current !== 'parent'}>
                    {it.items.map((s) => (
                      <li class:list={{ current: s.href === path }}><a href={withBase(s.href)} aria-current={s.href === path ? 'page' : undefined}>{s.label}</a></li>
                    ))}
                  </ul>
                </>
              )
              : link}
          </li>
        );
      })}
    </ul>
  </nav>
  <button class="mmenu-close" type="button" aria-label="Back to site">
    <svg viewBox="0 0 50 53" aria-hidden="true"><path d="M19 20.5l12 12M31 20.5l-12 12" /></svg>
  </button>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const opener = document.querySelector<HTMLButtonElement>('.mmenu-open');
  if (dialog && opener) {
    opener.addEventListener('click', () => {
      dialog.showModal();
      opener.setAttribute('aria-expanded', 'true');
    });
    dialog.querySelector('.mmenu-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      opener.setAttribute('aria-expanded', 'false');
      opener.focus();
    });
    for (const t of dialog.querySelectorAll<HTMLButtonElement>('.sub-toggle')) {
      t.addEventListener('click', () => {
        const open = t.getAttribute('aria-expanded') !== 'true';
        t.setAttribute('aria-expanded', String(open));
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !open;
      });
    }
    // The menu belongs to Wix's mobile layout: close it if the window grows past it.
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches && dialog.open) dialog.close(); });
  }
</script>
<style>
  .mmenu-open, .mobile-menu { display: none; }
  @media (max-width: 767px) {
    .mmenu-open, .mmenu-close {
      display: block; position: absolute; top: calc(10 * var(--m)); left: calc(254 * var(--m)); z-index: 56;
      width: calc(50 * var(--m)); height: calc(53 * var(--m)); padding: 0; border: 0; background: none; cursor: pointer;
    }
    /* The X stays put while the list scrolls under it. */
    .mmenu-close { position: fixed; }
    .mmenu-open svg, .mmenu-close svg { display: block; width: 100%; height: 100%; fill: none; stroke: #fff; stroke-width: 3; }
    .mmenu-open:focus-visible, .mobile-menu :focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

    .mobile-menu[open] {
      display: block; position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
      margin: 0; padding: 0 0 calc(40 * var(--m)); border: 0; overflow-y: auto; overscroll-behavior: contain;
      background: rgb(47 46 46 / 0.75); color: #fff;
    }
    .mobile-menu::backdrop { background: transparent; }

    .items, .sub { margin: 0; padding: 0; list-style: none; text-align: center; }
    .items { margin-top: calc(80 * var(--m)); }
    .item a, .sub a {
      display: inline-block; max-width: calc(280 * var(--m)); padding: calc(10 * var(--m)) calc(20 * var(--m));
      color: #fff; text-decoration: none; letter-spacing: calc(2 * var(--m));
      font: 700 calc(20 * var(--m)) / calc(28 * var(--m)) var(--font-heading);
    }
    .sub a { font-size: calc(18 * var(--m)); }
    .item.current > a, .row a[aria-current], .sub .current a { color: #f2f2f2; }
    .row { display: flex; justify-content: center; }
    .row a { padding-left: 0; }
    /* The button turns into the X: the dialog's own close button takes its place. */
    .mmenu-open[aria-expanded='true'] { visibility: hidden; }
    /* The +/- glyph: 13 wide, 1.5 thick, at the toggle's left edge. */
    .sub-toggle {
      position: relative; flex: none; width: calc(36 * var(--m)); padding: 0; border: 0; background: none; cursor: pointer;
    }
    .sub-toggle::before, .sub-toggle::after {
      content: ''; position: absolute; top: 50%; left: calc(1.5 * var(--m));
      width: calc(13 * var(--m)); height: calc(1.5 * var(--m)); margin-top: calc(-0.75 * var(--m)); background: #fff;
    }
    .sub-toggle::after { transform: rotate(90deg); }
    .sub-toggle[aria-expanded='true']::after { display: none; }
  }
</style>
