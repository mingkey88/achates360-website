---
import Pic from './Pic.astro';
import { cutLines, cutSize } from '../../lib/cut-lines';
// A paper-cut panel (direction B, after the die-cut dove in 'Building Memories', as the homepage's Selected
// work cover): a sheet of the page's paper with words cut clean through it in heavy capitals, and a
// picture lying under the sheet that shows only through the cut. The cut edges cast a little shadow onto
// the picture. It holds still and never covers the page: it is a panel in the flow, not a cover.
// Decorative (aria-hidden): the words are said in text beside it. Two compositions, as the covers have:
// wide screens set the words on as few lines as fit, phones break them shorter and larger.
// text: the words to cut (set in capitals). image: the picture under the sheet. scale: how much larger
// than usual the capitals may grow (short words, such as "404"); short words are centred on the sheet.
interface Props { text: string; image: ImageMetadata; position?: string; sizes?: string; class?: string; scale?: number }
const { text, image, position = 'center', sizes = '(max-width: 767px) calc(100vw - 32px), min(1320px, 100vw - 120px)', class: cls, scale = 1 } = Astro.props;
// One composition: the lines left-aligned from a margin, sized so the longest fills the width (capped),
// and the sheet just tall enough for them. Units are the SVG's own; .72 is the capitals' height in ems.
const compose = (k: string, w: number, max: number, cap: number, pad: number) => {
  const lines = cutLines(text.toUpperCase(), max);
  const size = cutSize(lines, w - 2 * pad, Math.round(cap * scale));
  const lead = Math.round(size * .92);
  const h = Math.round(2 * pad + size * .72 + (lines.length - 1) * lead);
  // Short words (six characters or fewer, as "404") are centred; longer ones set from the left margin.
  const centre = Math.max(...lines.map((l) => l.length)) <= 6;
  return { k, w, h, size, lines: lines.map((t, i) => ({ t, y: Math.round(pad + size * .72 + i * lead) })), x: centre ? w / 2 : pad, anchor: centre ? 'middle' : 'start' };
};
const cuts = [compose('w', 1000, 16, 300, 44), compose('n', 460, 8, 200, 24)];
const B = 400;
// Ids for the cut's mask and shadow, unique to its words.
const uid = `pcut-${[...text].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) >>> 0, 7).toString(36)}`;
---
<div class:list={['pcut', 'crop', cls]} aria-hidden="true" style={cuts.map((c) => `--ar-${c.k}: ${c.w} / ${c.h};`).join(' ')}>
  <span class="pcut-pic"><Pic src={image} alt="" widths={[640, 960, 1280, 1920]} sizes={sizes} position={position} loading="lazy" /></span>
  {cuts.map((c) => (
    <svg class={`pcut-svg pcut-${c.k}`} viewBox={`0 0 ${c.w} ${c.h}`} preserveAspectRatio="xMidYMid meet" focusable="false">
      <defs>
        <mask id={`${uid}-${c.k}-m`} maskUnits="userSpaceOnUse" x={-B} y={-B} width={c.w + 2 * B} height={c.h + 2 * B}>
          <rect x={-B} y={-B} width={c.w + 2 * B} height={c.h + 2 * B} fill="#fff" />
          {c.lines.map((l) => <text x={c.x} y={l.y} font-size={c.size} text-anchor={c.anchor}>{l.t}</text>)}
        </mask>
        <filter id={`${uid}-${c.k}-f`} filterUnits="userSpaceOnUse" x={-B} y={-B} width={c.w + 2 * B} height={c.h + 2 * B}>
          <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#000" flood-opacity=".3" />
        </filter>
      </defs>
      <rect class="pcut-paper" x={-B} y={-B} width={c.w + 2 * B} height={c.h + 2 * B} mask={`url(#${uid}-${c.k}-m)`} filter={`url(#${uid}-${c.k}-f)`} />
    </svg>
  ))}
</div>
<style>
  .pcut { position: relative; display: block; aspect-ratio: var(--ar-w); overflow: visible; box-shadow: 0 18px 30px -18px rgb(0 0 0 / .35); }
  .pcut-pic { position: absolute; inset: 0; overflow: hidden; background: var(--stone); }
  .pcut-pic :global(picture) { display: block; height: 100%; }
  .pcut-pic :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: scale 1.4s var(--ease-out); }
  .pcut-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden; }
  .pcut-svg text { font-family: var(--font-display); font-weight: 800; letter-spacing: -.035em; }
  .pcut-paper { fill: var(--paper); }
  .pcut-n { display: none; }
  @media (max-width: 767px) {
    .pcut { aspect-ratio: var(--ar-n); }
    .pcut-w { display: none; }
    .pcut-n { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { .pcut-pic :global(img) { transition: none; } }
</style>
