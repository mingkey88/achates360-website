---
// A section's ground (Rebecca, 26 Oct 2026: "a kind of texture or background behind"): a few large,
// soft washes of the brand's orange and turquoise on the stone, under a fine film grain. Pure CSS, so
// nothing loads; decorative, it fills its positioned parent and sits behind the content. The washes keep
// clear of the words they sit behind (the orange words stay at least 3:1): each variant places them
// for its section.
interface Props { variant?: 'statement' | 'close'; class?: string }
const { variant = 'statement', class: cls } = Astro.props;
---
<div class:list={['field', `field-${variant}`, cls]} aria-hidden="true"></div>
<style>
  .field { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; background: var(--stone); }
  .field::before { content: ''; position: absolute; inset: -10%; filter: blur(40px); }
  /* The studio's sentence sits left: the orange glows at the right, the turquoise low at the left. */
  .field-statement::before {
    background:
      radial-gradient(38% 55% at 88% 28%, rgb(255 144 21 / .38), transparent 70%),
      radial-gradient(30% 40% at 70% 92%, rgb(247 236 221 / .9), transparent 70%),
      radial-gradient(42% 60% at 6% 96%, rgb(153 217 217 / .58), transparent 70%);
  }
  /* Write to us sits centred: the colour gathers at the corners, a warm light behind the message. */
  .field-close::before {
    background:
      radial-gradient(34% 48% at 92% 12%, rgb(153 217 217 / .6), transparent 70%),
      radial-gradient(40% 52% at 8% 90%, rgb(255 144 21 / .34), transparent 70%),
      radial-gradient(36% 44% at 50% 50%, rgb(255 254 242 / .85), transparent 75%);
  }
  /* The grain over the colour, so the ground reads as a surface rather than a flat fill. */
  .field::after { content: ''; position: absolute; inset: 0; background: var(--grain); opacity: .16; mix-blend-mode: multiply; }
</style>
