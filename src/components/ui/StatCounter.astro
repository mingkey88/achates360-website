---
import DraftTag from './DraftTag.astro';
// The final number is in the HTML; motion (Task 11) counts up to it. Years and other values of
// 1000 or more are shown as they are, without counting, and so are placeholder figures (a draft number
// is not dramatised).
interface Props { value: number; suffix?: string; label: string; placeholder: boolean }
const { value, suffix, label, placeholder } = Astro.props;
---
<div class="stat" data-placeholder={placeholder ? '' : undefined}>
  <p class="stat-num"><span data-count={!placeholder && Number.isInteger(value) && value < 1000 ? value : undefined}>{value}</span>{suffix}</p>
  <p class="stat-label">{label}<DraftTag when={placeholder} /></p>
</div>
<style>
  .stat-num { margin: 0; font: 400 clamp(2.25rem, 1.8rem + 1.6vw, 3.25rem)/1 var(--font-display); color: var(--stat-color, var(--accent)); font-variant-numeric: lining-nums tabular-nums; }
  .stat-label { margin: var(--s-2) 0 0; font-size: var(--fs-small); color: var(--text-2); }
</style>
