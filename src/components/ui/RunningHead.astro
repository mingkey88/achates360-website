---
import T from './T.astro';
import type { UiString } from '../../lib/strings';
// A book's running head over a homepage section: the section's name at the left (its heading, or a
// label when the section's heading is something else), its folio at the right, on a hairline. Under the
// name, a thick bar of the brand orange sits on the hairline, as a selected tab's marker (after
// nationalgallery.sg); where the browser supports scroll-driven animation it draws in as the head arrives.
interface Props { s: UiString; folio: string; as?: 'h2' | 'p'; id?: string }
const { s, folio, as: Tag = 'h2', id } = Astro.props;
---
<div class="rh">
  <Tag class="rh-name" id={id}><T s={s} /></Tag>
  <span class="rh-folio" aria-hidden="true">{folio}</span>
</div>
<style>
  .rh { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-5); padding-bottom: var(--s-3); border-bottom: 1px solid var(--ink); }
  .rh-name { position: relative; margin: 0; font: 400 var(--fs-small)/1.3 var(--font-text); color: var(--text-2); }
  .rh-name::after { content: ''; position: absolute; left: 0; right: 0; bottom: calc(-1 * var(--s-3) - 1px); height: 4px; background: var(--accent); transform-origin: left; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rh-name::after { animation: rh-draw linear both; animation-timeline: view(); animation-range: entry 10% cover 30%; }
    }
  }
  @keyframes rh-draw { from { transform: scaleX(0); } }
  .rh-folio { font-size: var(--fs-small); font-variant-numeric: tabular-nums; letter-spacing: .04em; color: var(--text-2); }
</style>
