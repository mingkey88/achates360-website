---
interface Props { as?: 'p' | 'h2' | 'h3'; id?: string }
const { as: Tag = 'p', id } = Astro.props;
---
<Tag class="eyebrow" id={id}><span class="dot" aria-hidden="true"></span><slot /></Tag>
<style>
  .eyebrow { display: flex; align-items: center; gap: 8px; margin: 0 0 var(--s-4); font: 400 var(--fs-small)/1.3 var(--font-text); color: var(--text-2); }
  .dot { display: none; }
</style>
