---
// A section's texture, after the studio's name: Achates is the old name for agate, the stone of fine
// nested bands (Rebecca, 26 Oct 2026: "a kind of texture or background behind"). Hairline rings in ink,
// every few an orange band, drawn once at build time from a fixed seed so the page never shifts. Purely
// decorative; it fills its positioned parent and sits behind the content.
interface Props { seed?: number; cx?: number; cy?: number; class?: string }
const { seed = 7, cx = 720, cy = 520, class: cls } = Astro.props;

// A small seeded random, so each seed always draws the same stone.
let s = seed;
const rand = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const phase = [rand(), rand(), rand(), rand()].map((v) => v * Math.PI * 2);

const RINGS = 34;
const POINTS = 56;
const rings = Array.from({ length: RINGS }, (_, k) => {
  const r = 26 + k * 21 + rand() * 6;
  // The harmonics drift a little from ring to ring, so the bands follow each other but never repeat.
  const a = [0.16 + k * 0.004, 0.07 + rand() * 0.02, 0.035, 0.018];
  const pts = Array.from({ length: POINTS }, (_, i) => {
    const t = (i / POINTS) * Math.PI * 2;
    const w = 1 + a[0] * Math.sin(2 * t + phase[0] + k * 0.05) + a[1] * Math.sin(3 * t + phase[1] - k * 0.04)
      + a[2] * Math.sin(5 * t + phase[2]) + a[3] * Math.sin(9 * t + phase[3] + k * 0.3);
    return [cx + Math.cos(t) * r * w * 1.25, cy + Math.sin(t) * r * w];
  });
  // A closed Catmull-Rom curve through the points, as cubic Béziers.
  const p = (i: number) => pts[(i + POINTS) % POINTS];
  let d = `M${p(0)[0].toFixed(1)} ${p(0)[1].toFixed(1)}`;
  for (let i = 0; i < POINTS; i++) {
    const [p0, p1, p2, p3] = [p(i - 1), p(i), p(i + 1), p(i + 2)];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }
  return { d: d + 'Z', band: k % 7 === 4 };
});
---
<div class:list={['agate', cls]} aria-hidden="true">
  <svg viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
    {rings.map((r) => <path d={r.d} class:list={{ band: r.band }} />)}
  </svg>
</div>
<style>
  .agate { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .agate svg { display: block; width: 100%; height: 100%; }
  .agate path { fill: none; stroke: var(--ink); stroke-opacity: .11; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .agate path.band { stroke: var(--accent); stroke-opacity: .32; stroke-width: 6; }
  /* A paper grain over the bands, so the ground reads as a surface, not a flat fill. */
  .agate::after { content: ''; position: absolute; inset: 0; background: var(--grain); opacity: .09; mix-blend-mode: multiply; }
</style>
