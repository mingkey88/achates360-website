---
// A small outlined label; with href it is a link (e.g. a case study's category → its category page).
import { withBase } from '../../lib/paths';
interface Props { href?: string }
const { href } = Astro.props;
---
{href ? <a class="chip" href={withBase(href)}><slot /></a> : <span class="chip"><slot /></span>}
<style>
  .chip {
    display: inline-block; padding: 5px 11px; border-radius: 0; background: transparent; box-shadow: inset 0 0 0 1px var(--line); color: var(--ink);
    font: 500 var(--fs-label)/1.2 var(--font-text); letter-spacing: 0; text-decoration: none; transition: background-color .2s;
  }
  a.chip:hover { background: var(--stone); }
  /* Touch screens: the link's tap area reaches 44px tall without the chip itself growing. */
  @media (pointer: coarse) { a.chip { position: relative; } a.chip::after { content: ''; position: absolute; inset: -9px 0; } }
  @media (prefers-reduced-motion: reduce) { .chip { transition: none; } }
</style>
