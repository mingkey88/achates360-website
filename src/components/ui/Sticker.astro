---
// data-* attributes pass through (e.g. data-hero-sticker for the hero motion).
interface Props { tilt?: number; tone?: 'accent' | 'turquoise' | 'lime' | 'ink'; class?: string; [key: `data-${string}`]: string | boolean | undefined }
const { tilt = -5, tone = 'accent', class: cls, ...rest } = Astro.props;
---
<span class:list={['sticker', `sticker-${tone}`, cls]} style={`--tilt: ${tilt}deg`} {...rest}><slot /></span>
<style>
  /* Direction B: a quiet label (small tracked capitals, no colour block, no tilt). */
  .sticker { display: inline-block; font: 500 var(--fs-label)/1.2 var(--font-text); letter-spacing: .2em; text-transform: uppercase; }
</style>
