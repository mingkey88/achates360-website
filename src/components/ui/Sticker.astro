---
// data-* attributes pass through (e.g. data-hero-sticker for the hero motion).
interface Props { tilt?: number; tone?: 'accent' | 'turquoise' | 'lime' | 'ink'; class?: string; [key: `data-${string}`]: string | boolean | undefined }
const { tilt = -5, tone = 'accent', class: cls, ...rest } = Astro.props;
---
<span class:list={['sticker', `sticker-${tone}`, cls]} style={`--tilt: ${tilt}deg`} {...rest}><slot /></span>
<style>
  .sticker {
    display: inline-block; padding: 4px 10px 1px; transform: rotate(var(--tilt));
    font: 500 .75rem/1.2 var(--font-display); letter-spacing: .1em; text-transform: uppercase;
  }
  .sticker-accent { background: var(--accent); color: var(--ink); }
  .sticker-turquoise { background: var(--turquoise); color: var(--ink); }
  .sticker-lime { background: var(--lime); color: var(--ink); }
  .sticker-ink { background: var(--ink); color: var(--turquoise); }
</style>
