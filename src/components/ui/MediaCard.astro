---
import Pic from './Pic.astro';
import { withBase, mediaUrl, linkAttrs } from '../../lib/paths';
import Sticker from './Sticker.astro';
// An image card. previewVideo: a muted preview that plays on hover, only on hover-capable pointers and
// without reduced motion (Review Focus 5). wipe: the image is unveiled on scroll (motion/reveal.ts).
// Linked cards get a soft follow-the-pointer arrow on fine pointers (direction B).
// reveal: false for cards on the first screen, which should paint at once (largest-paint candidates).
// duplicateLink: the same page is linked by a named title next to the card, so the picture link stays
// clickable but is left out of the tab order and the accessibility tree (no unnamed repeat stop).
interface Props {
  image: ImageMetadata; alt: string; href?: string; title?: string; subtitle?: string; sticker?: string; tag?: string; position?: string;
  previewVideo?: string; ratio?: string; sizes: string; widths?: number[]; tilt?: boolean; eager?: boolean; wipe?: boolean; duplicateLink?: boolean; reveal?: boolean;
}
const { image, alt, href, title, subtitle, sticker, tag, position, previewVideo, ratio = '4 / 3', sizes, widths = [480, 720, 960, 1280], tilt = false, eager = false, wipe = false, duplicateLink = false, reveal = true } = Astro.props;
// A fixed frame ("5 / 4") is cropped at build time; "auto" keeps the picture's own shape.
const m = /^\s*([\d.]+)\s*\/\s*([\d.]+)\s*$/.exec(ratio);
const crop = m ? Number(m[1]) / Number(m[2]) : undefined;
const Wrap = href ? 'a' : 'div';
const wrapAttrs = href ? { href: withBase(href), ...linkAttrs(href), ...(duplicateLink ? { tabindex: -1, 'aria-hidden': 'true' } : {}) } : {};
---
<Wrap class="media-card" {...wrapAttrs} data-tilt={tilt ? '' : undefined} data-preview={previewVideo ? '' : undefined} data-reveal={reveal ? '' : undefined}>
  <div class="mc-media" style={`aspect-ratio: ${ratio}`} data-wipe={wipe ? '' : undefined}>
    <Pic src={image} alt={alt} crop={crop} widths={widths} sizes={sizes} position={position} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
    {previewVideo && <video class="mc-preview" data-src={mediaUrl(previewVideo)} muted loop playsinline preload="none" aria-hidden="true"></video>}
    {sticker && <Sticker class="mc-sticker" tilt={4}>{sticker}</Sticker>}
  </div>
  {(title || subtitle) && (
    <div class="mc-text">
      {title && <p class="mc-title">{title}</p>}
      {subtitle && <p class="mc-sub">{subtitle}</p>}
      {tag && <p class="mc-tag">{tag}</p>}
    </div>
  )}
</Wrap>
<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hover = window.matchMedia('(hover: hover)');
  for (const card of document.querySelectorAll<HTMLElement>('.media-card[data-preview]')) {
    const v = card.querySelector<HTMLVideoElement>('.mc-preview')!;
    card.addEventListener('pointerenter', () => {
      if (reduce.matches || !hover.matches) return;
      if (!v.getAttribute('src')) v.src = v.dataset.src!;
      card.classList.add('is-playing');
      v.play().catch(() => card.classList.remove('is-playing'));
    });
    card.addEventListener('pointerleave', () => { card.classList.remove('is-playing'); v.pause(); });
  }

  // A small circle with an arrow follows the pointer over linked cards, easing behind it.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const links = document.querySelectorAll<HTMLElement>('a.media-card');
  if (links.length && fine.matches && !reduce.matches) {
    const dot = document.createElement('div');
    dot.className = 'mc-cursor';
    dot.setAttribute('aria-hidden', 'true');
    dot.innerHTML = '<svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg>';
    document.body.append(dot);
    // The disc stands in for the pointer over linked cards (the browser's hand is hidden there).
    document.documentElement.classList.add('has-mc-cursor');
    let x = 0, y = 0, tx = 0, ty = 0, raf = 0, idle = 0;
    const tick = () => {
      x += (tx - x) * .55; y += (ty - y) * .55;
      dot.style.translate = `${x}px ${y}px`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > .3 ? requestAnimationFrame(tick) : 0;
    };
    const follow = (e: PointerEvent) => { tx = e.clientX; ty = e.clientY; if (!raf) raf = requestAnimationFrame(tick); };
    for (const a of links) {
      a.addEventListener('pointerenter', (e) => {
        clearTimeout(idle);
        if (!dot.classList.contains('is-on')) { x = tx = e.clientX; y = ty = e.clientY; dot.style.translate = `${x}px ${y}px`; }
        dot.classList.add('is-on');
      });
      a.addEventListener('pointermove', follow);
      a.addEventListener('pointerleave', () => { idle = window.setTimeout(() => dot.classList.remove('is-on'), 40); });
    }
  }
</script>
<style>
  .media-card { display: block; color: inherit; text-decoration: none; }
  .mc-media { position: relative; overflow: hidden; border-radius: var(--r-card); background: var(--stone); }
  .mc-media :global(img), .mc-preview { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .mc-preview { position: absolute; inset: 0; opacity: 0; transition: opacity .25s; }
  .mc-media::after { content: ''; position: absolute; inset: 0; z-index: 1; background: var(--grain); opacity: .14; mix-blend-mode: overlay; pointer-events: none; }
  .is-playing .mc-preview { opacity: 1; }
  a.media-card:hover .mc-media :global(img) { transform: scale(1.04); }
  .mc-media :global(.mc-sticker) { position: absolute; top: var(--s-3); right: var(--s-3); }
  .mc-text { padding-top: var(--s-3); }
  .mc-title { margin: 0; font: 500 clamp(1rem, .95rem + .25vw, 1.1875rem)/1.25 var(--font-title); letter-spacing: -.01em; overflow-wrap: anywhere; }
  .mc-sub { margin: 4px 0 0; font-size: var(--fs-small); color: var(--text-2); }
  /* A small label under the caption (an award the gallery notes): ink in a hairline box, like a stamp. */
  .mc-tag { display: inline-block; margin: var(--s-2) 0 0; padding: 2px 7px; border: 1px solid currentColor; font: 500 .6875rem/1.4 var(--font-text); letter-spacing: .06em; text-transform: uppercase; color: var(--accent-deep); }
  /* A small hairline circle with an arrow that replaces the pointer over linked cards: centred on the
     pointer, following it closely; the browser's hand is hidden there so only one shows. */
  :global(.mc-cursor) {
    position: fixed; left: 0; top: 0; z-index: 60; width: 34px; height: 34px; margin: -17px 0 0 -17px; border-radius: 50%;
    display: grid; place-items: center; background: var(--paper); color: var(--ink); border: 1px solid rgb(51 51 51 / .35); pointer-events: none;
    scale: 0; transition: scale .35s var(--ease-out);
  }
  :global(.mc-cursor.is-on) { scale: 1; }
  :global(.has-mc-cursor) a.media-card, :global(.has-mc-cursor) a.media-card :global(*) { cursor: none; }
  :global(.mc-cursor svg) { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  @media (prefers-reduced-motion: reduce) { .mc-media :global(img) { transition: none; } }
</style>
