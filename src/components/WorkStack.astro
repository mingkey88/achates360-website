---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BgVideo from './BgVideo.astro';
import RunningHead from './ui/RunningHead.astro';
import Pill from './ui/Pill.astro';
import T from './ui/T.astro';
import { withBase } from '../lib/paths';
import { STILLS } from '../lib/stills';
import { morphName } from '../lib/morph';
import { loadExtras } from '../lib/extras';
import type { UiString } from '../lib/strings';
// The homepage's work, after wearecollins.com (direction "quiet frame, moving work", 21 Oct 2026): a
// stack of large project tiles straight after the hero, set full-width and in pairs (1, 2, 1, 2, 1), each
// the project's own film looping silently where it has one, else its picture, with its name, client and
// disciplines beneath. The order mixes the studio's disciplines (packaging, campaigns, branding,
// content, events) so no one medium leads. A tile's film is, in order: the homepage slide's film for
// that project, the project's hero film, its first film in the story; films load on wide screens only,
// near the viewport (phones show the still). The whole card opens the case study; the View label follows
// the pointer (scripts/cursor.ts).
// Scrollytelling homepage (client, 2 Nov 2026, after yaas-energy.com): the projects are full-screen cards
// that stack as you scroll, each sliding up over the last while the last recedes (motion/cards.ts), and
// only the card in front plays its film. At rest (no motion) they are simply full-screen cards one after
// another.
// Phones held upright (10 Nov 2026): a landscape picture stretched over a tall screen showed only its
// middle third (DXV's title read "RY OF TIME"; IDM's website was an unreadable slice). There each card is
// the picture cut 4:3, the site's card shape, with its name beneath on the card's dark ground: the work
// shown whole and captioned, as everywhere else. The cards are then shorter than the screen; the
// button to all projects is held with them ([data-workstack-pin]), in view beneath while they stack.
interface Props { slugs: string[]; eyebrow: UiString; cta: UiString; count: number }
const { slugs, eyebrow, cta, count } = Astro.props;
const { text } = await loadExtras();
const home = (await getEntry('home', 'home'))!.data;
const tiles = await Promise.all(slugs.map(async (slug) => {
  const entry = await getEntry('projects', slug);
  if (!entry?.data.listed) throw new Error(`Work stack: "${slug}" is not a listed project`);
  const p = entry.data;
  const slide = home.slides.find((s) => s.cta?.href === `/${slug}` && s.media.type === 'video');
  const block = p.blocks.find((b) => b.type === 'video');
  const film = slide?.media.type === 'video' ? slide.media : p.hero?.type === 'video' ? p.hero : block?.type === 'video' ? block : undefined;
  // A hand-picked still first (lib/stills: DXV's exported frame catches its title mid-animation).
  const still = STILLS[slug] ?? film?.poster ?? (p.hero?.type === 'image' ? p.hero.src : undefined);
  if (!still) throw new Error(`Work stack: "${slug}" has no film or hero picture`);
  return {
    slug, title: p.title, client: p.client, categories: p.categories, still,
    video: film?.src,
  };
}));
const videoDraft = text('video-pause').placeholder || text('video-play').placeholder;
---
<section class="ws" aria-labelledby="ws-title" data-workstack>
  <div class="wrap ws-head"><RunningHead s={eyebrow} id="ws-title" /></div>
  {/* Held together while the cards stack (motion/cards.ts), so the button stays under the cards. */}
  <div data-workstack-pin>
  <div class="ws-stage" data-workstack-stage>
    <ul class="ws-cards">
      {tiles.map((t, i) => (
        <li class="ws-card" style={`--i: ${i}`} data-cursor={text('cursor-view').text}>
          <div class="ws-media" data-bgvideo-viewport style={`view-transition-name: ${morphName(t.slug)}`}>
            <Image class="ws-still" src={t.still} alt="" widths={[640, 960, 1440, 1920, 2560]} sizes="100vw" />
            {t.video && <BgVideo src={t.video} poster={t.still} desktopOnly posterless class="ws-video" pauseLabel={`${text('video-pause').text}: ${t.title}`} playLabel={`${text('video-play').text}: ${t.title}`} draft={videoDraft} />}
          </div>
          <span class="ws-dim" aria-hidden="true"></span>
          <div class="ws-band">
            <p class="ws-num" aria-hidden="true">{String(i + 1).padStart(2, '0')} <span>/ {String(tiles.length).padStart(2, '0')}</span></p>
            <h3 class="ws-title"><a class="ws-link" href={withBase(`/${t.slug}`)}>{t.title}</a></h3>
            <p class="ws-meta">{t.client && <span>{t.client}</span>}<span>{t.categories.join(', ')}</span></p>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <div class="ws-cta wrap"><Pill href="/projects" variant="fill"><T s={cta} /><span class="ws-count">({count})</span></Pill></div>
  </div>
</section>
<script>
  import { viewCursor } from '../scripts/cursor';
  viewCursor();
</script>
<style>
  .ws { padding-block: var(--section-y); }
  .ws-head { margin-bottom: var(--s-6); }
  /* At rest: full-screen cards one after another. */
  .ws-cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .ws-card { position: relative; height: calc(100svh - var(--header-h)); min-height: 420px; overflow: hidden; background: var(--black); color: var(--white); }
  .ws-media { position: absolute; inset: 0; }
  .ws-media > :global(*) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ws-media :global(.ws-video video) { width: 100%; height: 100%; object-fit: cover; }
  /* A dark veil the card behind fades under as the next one covers it (motion/cards.ts). */
  .ws-dim { position: absolute; inset: 0; z-index: 4; background: var(--black); opacity: 0; pointer-events: none; }
  .ws-media :global(.bv-toggle) { z-index: 3; top: var(--s-4); bottom: auto; right: var(--gutter); }
  /* The name in a band at the card's foot, on a shade that keeps it legible over any frame. */
  .ws-band {
    position: absolute; inset: auto 0 0; z-index: 2; display: grid; gap: var(--s-2); justify-items: start;
    padding: var(--s-9) var(--gutter) var(--s-6); background: linear-gradient(180deg, rgb(0 0 0 / 0), rgb(0 0 0 / .65));
  }
  .ws-num { margin: 0; font: 500 var(--fs-small)/1 var(--font-text); font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  .ws-num span { opacity: .6; }
  .ws-title { margin: 0; max-width: 24ch; font: 400 clamp(1.75rem, 1.2rem + 2.4vw, 3.5rem)/1.05 var(--font-display); letter-spacing: -.02em; text-wrap: balance; }
  .ws-link { color: inherit; text-decoration: none; }
  /* The whole card is the link; the pause key sits above it. */
  .ws-link::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .ws-link:focus-visible { outline: none; }
  .ws-card:has(.ws-link:focus-visible) { outline: 3px solid var(--accent); outline-offset: -3px; }
  .ws-meta { margin: 0; display: flex; flex-wrap: wrap; gap: 0 var(--s-4); font-size: var(--fs-small); color: rgb(255 255 255 / .85); }
  .ws-cta { display: flex; justify-content: center; margin-top: var(--s-7); }
  .ws-count { font-variant-numeric: tabular-nums; }
  /* Phones show only the still (the films load on wide screens), so no pause key there. */
  @media (max-width: 767px) { .ws-media :global(.bv-toggle) { display: none; } }
  /* Stacking (motion running): one screen-high stage the page holds while the cards slide up over each
     other (motion/cards.ts). */
  :global(html.motion-live) .ws-stage { position: relative; height: calc(100svh - var(--header-h)); min-height: 420px; overflow: hidden; }
  :global(html.motion-live) .ws-cards { display: block; height: 100%; }
  :global(html.motion-live) .ws-card { position: absolute; inset: 0; height: auto; min-height: 0; z-index: var(--i); will-change: transform; }
  /* Phones held upright: the picture whole at 4:3 with its name beneath, not stretched over the screen.
     --ws-h is the card's height: the picture, then room for a three-line name and its details. */
  @media (max-width: 767px) and (orientation: portrait) {
    .ws { --ws-h: min(calc(100svh - var(--header-h)), calc(75vw + 15.5rem)); }
    .ws-card { display: grid; grid-template-rows: auto 1fr; height: var(--ws-h); min-height: 0; }
    .ws-media { position: relative; inset: auto; aspect-ratio: 4 / 3; overflow: hidden; }
    .ws-band { position: relative; inset: auto; align-content: start; padding: var(--s-5) var(--gutter) var(--s-6); background: var(--black); }
    :global(html.motion-live) .ws-stage { height: var(--ws-h); min-height: 0; }
  }
</style>
