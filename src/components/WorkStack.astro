---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BgVideo from './BgVideo.astro';
import RunningHead from './ui/RunningHead.astro';
import Pill from './ui/Pill.astro';
import T from './ui/T.astro';
import { withBase } from '../lib/paths';
import { loadExtras } from '../lib/extras';
import type { UiString } from '../lib/strings';
// The homepage's work, after wearecollins.com (direction "quiet frame, moving work", 21 Oct 2026): a
// stack of large project tiles straight after the hero, set full-width and in pairs (1, 2, 1, 2, 1), each
// the project's own film looping silently where it has one, else its picture, with its name, client and
// disciplines beneath. The order mixes the studio's disciplines (packaging, campaigns, branding,
// content, events) so no one medium leads. A tile's film is, in order: the homepage slide's film for
// that project, the project's hero film, its first film in the story; films load on wide screens only,
// near the viewport (phones show the still). The whole tile opens the case study.
interface Props { slugs: string[]; eyebrow: UiString; cta: UiString; count: number }
const { slugs, eyebrow, cta, count } = Astro.props;
const { text } = await loadExtras();
// Films with a smaller portrait cut for phones (made for the old Selected work cover); others show
// their still on phones.
const PHONE_CUTS: Record<string, string> = {
  'media/video/9766c0_dc0766bd21f24857af77b62c8b872cab.mp4': 'media/video/9766c0_dc0766bd21f24857af77b62c8b872cab-phone.mp4',
};
const home = (await getEntry('home', 'home'))!.data;
const tiles = await Promise.all(slugs.map(async (slug) => {
  const entry = await getEntry('projects', slug);
  if (!entry?.data.listed) throw new Error(`Work stack: "${slug}" is not a listed project`);
  const p = entry.data;
  const slide = home.slides.find((s) => s.cta?.href === `/${slug}` && s.media.type === 'video');
  const block = p.blocks.find((b) => b.type === 'video');
  const film = slide?.media.type === 'video' ? slide.media : p.hero?.type === 'video' ? p.hero : block?.type === 'video' ? block : undefined;
  const still = film?.poster ?? (p.hero?.type === 'image' ? p.hero.src : undefined);
  if (!still) throw new Error(`Work stack: "${slug}" has no film or hero picture`);
  return {
    slug, title: p.title, client: p.client, categories: p.categories, still,
    video: film?.src,
    phoneVideo: film && PHONE_CUTS[film.src],
  };
}));
// 1, 2, 1, 2, 1: a full-width tile, then a pair, alternating.
const wide = (i: number) => i % 3 === 0;
const videoDraft = text('video-pause').placeholder || text('video-play').placeholder;
---
<section class="ws section" aria-labelledby="ws-title">
  <div class="wrap"><RunningHead s={eyebrow} id="ws-title" /></div>
  <ul class="ws-grid wrap">
    {tiles.map((t, i) => (
      <li class:list={['ws-item', wide(i) ? 'is-wide' : 'is-pair']}>
        <div class:list={['ws-media', { 'still-on-phones': t.video && !t.phoneVideo }]} data-bgvideo-viewport>
          <Image class="ws-still" src={t.still} alt="" widths={[480, 960, 1440, 1920]} sizes={wide(i) ? '(max-width: 1440px) 92vw, 1320px' : '(max-width: 767px) 92vw, 46vw'} />
          {t.video && <BgVideo src={t.video} phoneSrc={t.phoneVideo} poster={t.still} desktopOnly class="ws-video" pauseLabel={text('video-pause').text} playLabel={text('video-play').text} draft={videoDraft} />}
        </div>
        <div class="ws-cap">
          <h3 class="ws-title"><a class="ws-link" href={withBase(`/${t.slug}`)}>{t.title}</a></h3>
          <p class="ws-meta">{t.client && <span>{t.client}</span>}<span>{t.categories.join(', ')}</span></p>
        </div>
      </li>
    ))}
  </ul>
  <div class="ws-cta wrap"><Pill href="/projects" variant="fill"><T s={cta} /><span class="ws-count">({count})</span></Pill></div>
</section>
<style>
  .ws { display: grid; gap: var(--s-7); }
  .ws-grid { list-style: none; margin-block: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: var(--s-8) var(--s-5); }
  .ws-item { position: relative; display: grid; gap: var(--s-4); align-content: start; }
  .ws-media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--stone); }
  .ws-media > :global(*) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ws-media :global(.ws-video video) { width: 100%; height: 100%; object-fit: cover; }
  .ws-still, .ws-media :global(.ws-video) { transition: transform 1.2s var(--ease-out); }
  .ws-item:hover :is(.ws-still, :global(.ws-video)) { transform: scale(1.025); }
  .ws-media :global(.bv-toggle) { z-index: 3; right: var(--s-3); bottom: var(--s-3); }
  .ws-cap { display: grid; gap: 4px; }
  .ws-title { margin: 0; font: 400 clamp(1.125rem, 1rem + .5vw, 1.5rem)/1.2 var(--font-display); letter-spacing: -.01em; }
  .ws-link { color: inherit; text-decoration: none; }
  /* The whole tile is the link; the pause key sits above it. */
  .ws-link::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .ws-link:focus-visible { outline: none; }
  .ws-item:has(.ws-link:focus-visible) { outline: 2px solid var(--ink); outline-offset: 6px; }
  .ws-item:hover .ws-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .ws-meta { margin: 0; display: flex; flex-wrap: wrap; gap: 0 var(--s-4); font-size: var(--fs-small); color: var(--text-2); }
  .ws-cta { display: flex; justify-content: center; }
  .ws-count { font-variant-numeric: tabular-nums; }
  /* Phones show only the still where there is no phone cut, so no pause key there. */
  @media (max-width: 767px) { .still-on-phones :global(.bv-toggle) { display: none; } }
  @media (min-width: 768px) {
    .ws-grid { grid-template-columns: 1fr 1fr; }
    .is-wide { grid-column: 1 / -1; }
    .is-wide .ws-media { aspect-ratio: 16 / 9; max-height: 86svh; width: 100%; }
    /* The pair's second tile sits lower, so the two don't read as a table row. */
    .is-pair + .is-pair { margin-top: var(--s-9); }
  }
  @media (prefers-reduced-motion: reduce) { .ws-still, .ws-media :global(.ws-video) { transition: none; } }
</style>
