---
import Pic from './ui/Pic.astro';
import { renderMd } from '../lib/markdown';
import { withBase, backLinkHref, linkAttrs } from '../lib/paths';
import BgVideo from './BgVideo.astro';
import Embed from './Embed.astro';
import Player from './Player.astro';
import MediaCard from './ui/MediaCard.astro';
import { loadExtras } from '../lib/extras';
import { altOr, isFileNameAlt } from '../lib/seo';
import { meta } from '../lib/img';
// One exported content block in the new design. Copy is rendered verbatim; the clone's per-block
// colours (b.color) belonged to Wix's layout and are not used.
interface Props { block: any; pageTitle?: string; altFallback?: string; lead?: boolean; sizes?: string; demote?: number }
const { block: b, pageTitle, altFallback = '', lead = false, sizes = '(max-width: 767px) 100vw, (max-width: 1440px) 92vw, 1320px', demote = 0 } = Astro.props;
const { text } = await loadExtras();
const label = pageTitle ? `${pageTitle} video` : undefined;
---
{b.type === 'text' && <div class:list={['block-text', 'prose', { lead }]} data-reveal set:html={renderMd(b.md, undefined, { demote })} />}
{b.type === 'link' && (() => { const m = String(b.label).match(/^(←\s*)?(.*)$/)!; return <p class="block-link"><a class="back-link" href={withBase(backLinkHref(b.href))}>{m[1] && <span aria-hidden="true">← </span>}<span class="sc">{m[2]}</span></a></p>; })()}
{b.type === 'image' && (b.href
  ? <a class="block-image" href={withBase(b.href)} {...linkAttrs(b.href)} style={`--nat: ${meta(b.src).width}px`} data-reveal><Pic class="block-img" src={b.src} alt={altOr(b.alt, altFallback)} widths={[480, 960, 1440, 1920, 2560]} sizes={sizes} /></a>
  : <div class="block-image" style={`--nat: ${meta(b.src).width}px`} data-reveal><Pic class="block-img" src={b.src} alt={altOr(b.alt, altFallback)} widths={[480, 960, 1440, 1920, 2560]} sizes={sizes} /></div>)}
{b.type === 'gallery' && (
  <ul class="block-gallery">
    {b.items.map((it: any) => <li><MediaCard image={it.thumb} alt={isFileNameAlt(it.alt) ? (it.href && it.title ? '' : altFallback) : it.alt} href={it.href} title={it.href ? it.title : undefined} previewVideo={it.video} ratio="auto" sizes="(max-width: 767px) calc(100vw - 32px), 45vw" /></li>)}
  </ul>
)}
{b.type === 'video' && (b.controls
  ? <Player src={b.src} poster={b.poster} label={label} />
  : <BgVideo src={b.src} poster={b.poster} class="block-video" pauseLabel={text('video-pause').text} playLabel={text('video-play').text} draft={text('video-pause').placeholder || text('video-play').placeholder} />)}
{b.type === 'embed' && <Embed provider={b.provider} id={b.id} hash={b.hash} title={label} />}
<style>
  .back-link { display: inline-flex; align-items: center; gap: .4em; min-height: 44px; font-size: var(--fs-small); color: inherit; text-underline-offset: 4px; }
</style>
