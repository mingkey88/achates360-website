---
import { Image } from 'astro:assets';
import { renderMd } from '../lib/markdown';
import { withBase, backLinkHref } from '../lib/paths';
import BgVideo from './BgVideo.astro';
import Embed from './Embed.astro';
import Gallery from './Gallery.astro';
import Player from './Player.astro';
// One content block. `width` is its desktop display width in px when Wix's layout box is known
// (Blocks.astro), so images ask for a fitting size.
interface Props { block: any; gallery?: 'stack' | 'grid'; pageTitle?: string; width?: number }
const { block: b, gallery = 'grid', pageTitle, width } = Astro.props;
const sizes = width ? `(max-width: 767px) 100vw, ${width}px` : '(max-width: 980px) 100vw, 980px';
const label = pageTitle ? `${pageTitle} video` : undefined;
---
{b.type === 'text' && <div class="block-text" style={b.color ? `color: ${b.color}` : undefined} set:html={renderMd(b.md)} />}
{/* The only content link to the home page is Wix's "← BACK TO PROJECTS", whose data-anchor
    scrolls home to the All Projects section. */}
{b.type === 'link' && <p class="block-link"><a href={withBase(backLinkHref(b.href))}>{b.label}</a></p>}
{b.type === 'image' && (() => {
  // GIFs too: Astro's sharp service keeps every frame (animated WebP), sized to the slot.
  const img = <Image src={b.src} alt={b.alt} widths={[480, 960, 1440, 1920]} sizes={sizes} />;
  return b.href ? <a class="block-image" href={withBase(b.href)}>{img}</a> : <div class="block-image">{img}</div>;
})()}
{b.type === 'gallery' && <Gallery items={b.items} layout={gallery} />}
{b.type === 'video' && (b.controls
  ? <Player src={b.src} poster={b.poster} label={label} />
  : <BgVideo src={b.src} poster={b.poster} class="block-video" />)}
{b.type === 'embed' && <Embed provider={b.provider} id={b.id} title={label} />}
