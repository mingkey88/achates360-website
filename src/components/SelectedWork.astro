---
import type { CollectionEntry } from 'astro:content';
import MediaCard from './ui/MediaCard.astro';
import SelectedCover from './SelectedCover.astro';
import Pill from './ui/Pill.astro';
import T from './ui/T.astro';
import { withBase } from '../lib/paths';
import { firstYear } from '../lib/meta';
import type { UiString } from '../lib/strings';
type Slide = CollectionEntry<'home'>['data']['slides'][number];
type Project = CollectionEntry<'projects'>['data'];
// Direction B homepage: after the cover, each selected project gets its own composition, like the
// spreads of a printed portfolio (Batch 2, step 4). The four layouts, in order:
//   lead   - a large picture with a tinted panel overlapping its corner (after nationalgallery.sg)
//   spread - the picture across the page, client · discipline · year and the title on one caption line under it
//   type   - a tall picture to one side, the title set large across the rest, no panel
//   quiet  - a smaller picture off-centre in open paper, the details in a narrow column beside it
// More rows than layouts repeat the sequence. Videos play on hover (MediaCard).
// The first item is the cover (SelectedCover: paper-cut heading over its film); the rest follow as rows.
interface Props { items: { slide: Slide; project?: Project }[]; eyebrow: UiString; cta: UiString; total: number }
const { items, eyebrow, cta, total } = Astro.props;
const LAYOUTS = [
  { name: 'lead', ratio: '5 / 4', sizes: '(max-width: 899px) 100vw, 67vw', widths: [640, 960, 1280, 1600, 1900] },
  { name: 'spread', ratio: '16 / 7', sizes: '100vw', widths: [640, 960, 1280, 1600, 1920, 2400] },
  { name: 'type', ratio: '4 / 5', sizes: '(max-width: 899px) calc(100vw - 64px), 38vw', widths: [480, 720, 960, 1280] },
  { name: 'quiet', ratio: '3 / 2', sizes: '(max-width: 899px) 80vw, 42vw', widths: [480, 720, 960, 1280] },
] as const;
const all = items.map(({ slide, project }) => ({
  image: slide.media.type === 'video' ? slide.media.poster : slide.media.src,
  alt: slide.media.type === 'image' ? slide.media.alt : '',
  video: slide.media.type === 'video' ? slide.media.src : undefined,
  href: slide.cta?.href,
  label: slide.cta?.label,
  title: project?.title,
  meta: [project?.client, project?.categories[0], firstYear(project?.copyright)].filter(Boolean).join(' · '),
  media: slide.media,
}));
const [cover, ...rows] = all;
---
<section class="sw" aria-labelledby="sw-title">
  {cover && <SelectedCover id="sw-title" heading={eyebrow} media={cover.media} project={cover} />}
  <ol class="sw-list">
    {rows.map((r, i) => {
      const l = LAYOUTS[i % LAYOUTS.length];
      return (
        <li class={`sw-row sw-${l.name}`}>
          <div class="sw-media crop">
            <span class="sw-folio" aria-hidden="true">{String(i + 2).padStart(2, '0')}</span>
            <MediaCard image={r.image} alt={r.alt} href={r.href} previewVideo={r.video} ratio={l.ratio} sizes={l.sizes} widths={[...l.widths]} wipe duplicateLink={!!r.title} />
          </div>
          <div class="sw-text">
            {r.meta && <p class="sw-meta">{r.meta}</p>}
            {r.title && <h3 class="sw-title">{r.href ? <a href={withBase(r.href)}>{r.title}</a> : r.title}</h3>}
            {r.href && r.label && <Pill href={r.href}><span class="sc">{r.label}</span></Pill>}
          </div>
        </li>
      );
    })}
  </ol>
  <div class="sw-foot"><Pill href="/projects" variant="fill"><T s={cta} /> <span class="sw-count">({total})</span></Pill></div>
</section>
<style>
  /* No overflow clipping here: it would stop the cover's sticky film. */
  .sw { padding-bottom: var(--section-y); }
  .sw-list { list-style: none; margin: var(--section-y) 0 0; padding: 0; display: grid; gap: var(--s-9); }
  .sw-row { position: relative; display: grid; }
  .sw :global(.mc-media) { border-radius: 0; }
  .sw-text { position: relative; z-index: 1; display: grid; align-content: center; justify-items: start; gap: var(--s-4); padding: var(--s-7) var(--gutter) 0; }
  .sw-meta { margin: 0; font-size: var(--fs-small); color: var(--text-2); }
  .sw-title { margin: 0; max-width: 20ch; font: 400 var(--fs-h2)/1.2 var(--font-display); text-wrap: balance; }
  .sw-title a { color: inherit; text-decoration: none; }
  .sw-title a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .sw-text :global(.pill) { margin-top: var(--s-3); }
  .sw-foot { display: flex; justify-content: center; margin-top: var(--s-10); }
  .sw-count { font-variant-numeric: tabular-nums; }
  /* Folio: the project's place in the list, set beside the picture's crop marks. */
  .sw-folio {
    position: absolute; bottom: 100%; right: 0; margin-bottom: calc(var(--cm-len) + var(--cm-gap) + 4px);
    font: 500 var(--fs-small)/1 var(--font-text); font-variant-numeric: tabular-nums; letter-spacing: .08em; color: var(--text-2);
  }

  /* Phones and narrow tablets: every layout stacks picture then details. Full-width pictures have no
     corners to mark; the inset ones (type, quiet) keep their crop marks. */
  @media (max-width: 899px) {
    .sw-lead .sw-media.crop::before, .sw-spread .sw-media.crop::before { display: none; }
    .sw-folio { right: var(--gutter); }
    .sw-lead .sw-text { padding-block: var(--s-7); background: var(--blush); }
    .sw-type .sw-media, .sw-quiet .sw-media { margin-inline: var(--s-6); }
    .sw-type .sw-folio, .sw-quiet .sw-folio { right: 0; }
    .sw-quiet .sw-media { margin-right: 20vw; }
    .sw-type .sw-text { order: -1; padding: 0 var(--gutter) var(--s-8); }
    .sw-type .sw-title { font-size: var(--fs-mega); line-height: 1.05; }
  }

  @media (min-width: 900px) {
    .sw-row { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s-5); }
    .sw-media, .sw-text { grid-row: 1; }
    .sw-text { padding: 0; }

    /* lead: the tinted card overlaps the picture's edge and drops below it (after nationalgallery.sg). */
    .sw-lead { align-items: end; column-gap: 0; padding-bottom: var(--s-8); }
    .sw-lead .sw-media { grid-column: 1 / 9; }
    .sw-lead .sw-text { grid-column: 8 / 13; margin-bottom: calc(var(--s-8) * -1); padding: var(--s-8) clamp(var(--s-6), 4vw, var(--s-9)); background: var(--blush); }
    .sw-lead .sw-folio { bottom: auto; right: auto; top: 0; left: calc(100% + var(--cm-len) + var(--cm-gap) + 6px); translate: 0 -50%; margin: 0; }

    /* spread: the picture across the page inside the margins, one caption line under it. */
    .sw-spread { padding-inline: var(--gutter); row-gap: var(--s-6); }
    .sw-spread .sw-media { grid-column: 1 / 13; }
    .sw-spread .sw-text { grid-column: 1 / 13; grid-row: 2; grid-template-columns: subgrid; align-items: baseline; padding-top: var(--s-5); border-top: 1px solid var(--line); }
    .sw-spread .sw-meta { grid-column: 1 / 4; }
    .sw-spread .sw-title { grid-column: 4 / 10; max-width: none; }
    .sw-spread .sw-text :global(.pill) { grid-column: 10 / 13; justify-self: end; margin: 0; }

    /* type: a tall picture on the right, the title large across the left, no panel. */
    .sw-type { padding-inline: var(--gutter); align-items: end; }
    .sw-type .sw-media { grid-column: 8 / 13; }
    .sw-type .sw-text { grid-column: 1 / 8; align-content: end; padding-right: var(--s-7); }
    .sw-type .sw-title { max-width: 14ch; font-size: clamp(2.5rem, 1.2rem + 3.6vw, 5rem); line-height: 1.02; letter-spacing: -.01em; }
    .sw-type .sw-folio { right: auto; left: 0; }

    /* quiet: a smaller picture off-centre in open paper, details in a narrow column beside it. */
    .sw-quiet { padding-inline: var(--gutter); align-items: end; }
    .sw-quiet .sw-media { grid-column: 3 / 8; }
    .sw-quiet .sw-text { grid-column: 9 / 12; align-content: end; gap: var(--s-3); }
    .sw-quiet .sw-title { font-size: var(--fs-h3); }
    .sw-quiet .sw-folio { right: auto; left: 0; }
    .sw-list { gap: calc(var(--s-10) + var(--s-6)); }
  }
</style>
