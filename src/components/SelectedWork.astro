---
import type { CollectionEntry } from 'astro:content';
import MediaCard from './ui/MediaCard.astro';
import SelectedCover from './SelectedCover.astro';
import Pill from './ui/Pill.astro';
import T from './ui/T.astro';
import { withBase } from '../lib/paths';
import { firstYear } from '../lib/meta';
import type { UiString } from '../lib/strings';
type Slide = CollectionEntry<'home'>['data']['slides'][number];
type Project = CollectionEntry<'projects'>['data'];
// Direction B homepage: the first selected project is the cover (SelectedCover: paper-cut heading over
// its film); the other four follow as a magazine sets plates, changing scale: the first as a lead plate
// ('Building Memories': picture across seven columns, its caption beside it on the right, aligned to the picture's foot), the
// other three in a row on one baseline. Each picture sits in crop marks with its catalogue number (№, as
// on /projects) as its folio; then client · discipline · year and the title, linked.
// Videos play on hover (MediaCard). poster: a replacement still for a slide's film (by link).
interface Props { items: { slide: Slide; project?: Project; no?: number; poster?: ImageMetadata }[]; eyebrow: UiString; cta: UiString; total: number }
const { items, eyebrow, cta, total } = Astro.props;
const all = items.map(({ slide, project, no, poster }) => ({
  no,
  image: poster ?? (slide.media.type === 'video' ? slide.media.poster : slide.media.src),
  alt: slide.media.type === 'image' ? slide.media.alt : '',
  video: slide.media.type === 'video' ? slide.media.src : undefined,
  href: slide.cta?.href,
  label: slide.cta?.label,
  title: project?.title,
  meta: [project?.client, project?.categories[0], firstYear(project?.copyright)].filter(Boolean).join(' · '),
  media: slide.media,
}));
const [cover, ...rows] = all;
---
<section class="sw" aria-labelledby="sw-title">
  {cover && <SelectedCover id="sw-title" heading={eyebrow} media={cover.media} project={cover} count={total} />}
  <ol class="sw-list">
    {rows.map((r, i) => (
      <li class:list={['sw-item', { 'sw-lead': i === 0 }]}>
        <div class="sw-media crop">
          {r.no && <span class="sw-folio" aria-hidden="true">№ {String(r.no).padStart(3, '0')}</span>}
          <MediaCard image={r.image} alt={r.alt} href={r.href} previewVideo={r.video} ratio="4 / 3" sizes={i === 0 ? '(max-width: 767px) calc(100vw - 32px), 56vw' : '(max-width: 767px) calc(100vw - 32px), 31vw'} widths={[480, 720, 960, 1280, 1600]} duplicateLink={!!r.title} reveal={false} />
        </div>
        <div class="sw-text">
          {r.meta && <p class="sw-meta">{r.meta}</p>}
          {r.title && <h3 class="sw-title">{r.href ? <a href={withBase(r.href)}>{r.title}</a> : r.title}</h3>}
          {i === 0 && r.href && r.label && <a class="sw-more" href={withBase(r.href)} tabindex="-1" aria-hidden="true"><span class="sc">{r.label}</span> <span>→</span></a>}
        </div>
      </li>
    ))}
  </ol>
  <div class="sw-foot"><Pill href="/projects" variant="fill"><T s={cta} /> <span class="sw-count">({total})</span></Pill></div>
</section>
<style>
  /* No overflow clipping here: it would stop the cover's sticky film. */
  .sw { padding-bottom: var(--s-8); }
  .sw-list { list-style: none; margin: var(--s-9) 0 0; padding: 0 var(--gutter); display: grid; gap: var(--s-9) var(--s-7); }
  .sw-item { display: grid; align-content: start; gap: var(--s-4); }
  .sw-media { position: relative; }
  .sw :global(.mc-media) { border-radius: 0; }
  .sw-text { display: grid; justify-items: start; gap: var(--s-2); padding-top: var(--s-3); border-top: 1px solid var(--line); }
  .sw-meta { margin: 0; font-size: var(--fs-small); color: var(--text-2); }
  .sw-title { margin: 0; max-width: 28ch; font: 400 var(--fs-h3)/1.25 var(--font-display); text-wrap: balance; }
  .sw-title a { color: inherit; text-decoration: none; }
  .sw-title a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .sw-more { margin-top: var(--s-1); font-size: var(--fs-small); color: inherit; text-decoration: none; }
  .sw-more:hover { text-decoration: underline; text-underline-offset: .2em; }
  .sw-foot { display: flex; justify-content: center; margin-top: var(--s-8); }
  .sw-count { font-variant-numeric: tabular-nums; }
  /* Folio: the project's catalogue number, set above the picture's crop marks at the right. */
  .sw-folio {
    position: absolute; bottom: 100%; right: 0; margin-bottom: calc(var(--cm-len) + var(--cm-gap) + 4px);
    font: 500 var(--fs-small)/1 var(--font-text); font-variant-numeric: tabular-nums; letter-spacing: .08em; color: var(--text-2);
  }
  @media (max-width: 767px) {
    .sw-media { --cm-len: 8px; --cm-gap: 4px; }
    /* Phones: one project per row, its caption centred under the picture. */
    .sw-text { justify-items: center; text-align: center; }
    .sw-title { margin-inline: auto; }
    .sw-list { gap: var(--s-7); margin-top: var(--s-8); }
    .sw-more { display: none; }
  }
  @media (min-width: 768px) {
    /* The lead plate across the full measure, then three smaller plates on one baseline. */
    .sw-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sw-lead { grid-column: 1 / -1; }
    .sw-item:not(.sw-lead) .sw-title { font-size: var(--fs-lead); }
  }
  @media (min-width: 1024px) {
    .sw-lead { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s-5); align-items: end; }
    .sw-lead .sw-media { grid-column: 1 / 8; }
    .sw-lead .sw-text { grid-column: 9 / 13; }
    .sw-lead .sw-title { font-size: var(--fs-h2); }
  }
</style>
