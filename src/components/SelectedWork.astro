---
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import MediaCard from './ui/MediaCard.astro';
import DraftTag from './ui/DraftTag.astro';
import Pill from './ui/Pill.astro';
import T from './ui/T.astro';
import { withBase } from '../lib/paths';
import { firstYear } from '../lib/meta';
import type { UiString } from '../lib/strings';
type Slide = CollectionEntry<'home'>['data']['slides'][number];
type Project = CollectionEntry<'projects'>['data'];
// Direction B homepage (after Aesop): each selected project as a split composition, the image on one
// half and a tinted panel with its name, client · discipline · year and a link on the other,
// alternating sides. Videos play on hover (MediaCard).
interface Props { items: { slide: Slide; project?: Project }[]; eyebrow: UiString; cta: UiString; total: number }
const { items, eyebrow, cta, total } = Astro.props;
const TINTS = ['var(--stone)', 'var(--blush)', 'var(--sage)', 'var(--stone)'];
// The cut-out heading is filled with the second project's picture (after nationalgallery.sg), so it never
// sits on the same image as the first row beneath it.
const first = (items[1] ?? items[0])?.slide.media;
const fill = first ? (await getImage({ src: first.type === 'video' ? first.poster : first.src, width: 1600, format: 'webp' })).src : undefined;
const rows = items.map(({ slide, project }, i) => ({
  image: slide.media.type === 'video' ? slide.media.poster : slide.media.src,
  alt: slide.media.type === 'image' ? slide.media.alt : '',
  video: slide.media.type === 'video' ? slide.media.src : undefined,
  href: slide.cta?.href,
  label: slide.cta?.label,
  title: project?.title,
  meta: [project?.client, project?.categories[0], firstYear(project?.copyright)].filter(Boolean).join(' · '),
  tint: TINTS[i % TINTS.length],
}));
---
<section class="sw" aria-labelledby="sw-title">
  <div class="wrap sw-head">
    <h2 id="sw-title" class="sw-cut" data-placeholder={eyebrow.placeholder ? '' : undefined}><span class="cut" style={fill ? `--fill: url(${fill})` : undefined}>{eyebrow.text}</span><DraftTag when={eyebrow.placeholder} /></h2>
  </div>
  <ol class="sw-list">
    {rows.map((r, i) => (
      <li class:list={['sw-row', { flip: i % 2 === 1 }]} style={`--tint: ${r.tint}`}>
        <div class="sw-media">
          <MediaCard image={r.image} alt={r.alt} href={r.href} previewVideo={r.video} ratio="5 / 4" sizes="(max-width: 767px) 100vw, 50vw" widths={[640, 960, 1280, 1600]} wipe />
        </div>
        <div class="sw-text">
          {r.meta && <p class="sw-meta">{r.meta}</p>}
          {r.title && <h3 class="sw-title">{r.href ? <a href={withBase(r.href)}>{r.title}</a> : r.title}</h3>}
          {r.href && r.label && <Pill href={r.href}><span class="sc">{r.label}</span></Pill>}
        </div>
      </li>
    ))}
  </ol>
  <div class="sw-foot"><Pill href="/projects" variant="fill"><T s={cta} /> <span class="sw-count">({total})</span></Pill></div>
</section>
<style>
  .sw { padding-block: var(--section-y); overflow: hidden; }
  /* Cut-out lettering: very heavy type with a photograph showing through, overlapping the first row. */
  .sw-head { position: relative; z-index: 2; margin-bottom: calc(clamp(3.5rem, 2rem + 9vw, 11rem) * -.1); } /* the letters just touch the first picture */
  .sw-cut { margin: 0; line-height: .82; }
  .cut {
    display: inline-block; font: 800 clamp(3.5rem, 2rem + 9vw, 11rem)/.82 var(--font-display); letter-spacing: -.045em;
    color: var(--ink); background: var(--fill, none) center 45% / 120% auto, var(--ink); -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; padding-bottom: .04em;
  }
  .sw-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-8); }
  .sw-row { position: relative; display: grid; }
  .sw :global(.mc-media) { border-radius: 0; }
  .sw-text { position: relative; z-index: 1; display: grid; align-content: center; justify-items: start; gap: var(--s-4); padding: var(--s-7) var(--gutter); background: var(--tint); }
  .sw-meta { margin: 0; font-size: var(--fs-small); color: var(--text-2); }
  .sw-title { margin: 0; max-width: 20ch; font: 400 var(--fs-h2)/1.2 var(--font-display); text-wrap: balance; }
  .sw-title a { color: inherit; text-decoration: none; }
  .sw-title a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .sw-text :global(.pill) { margin-top: var(--s-3); }
  .sw-foot { display: flex; justify-content: center; margin-top: var(--s-9); }
  .sw-count { font-variant-numeric: tabular-nums; }
  /* Desktop: the tinted card overlaps the picture's edge and drops below it (after nationalgallery.sg). */
  @media (min-width: 900px) {
    .sw-row { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: end; }
    .sw-media { grid-column: 1 / 9; grid-row: 1; }
    .sw-text { grid-column: 8 / 13; grid-row: 1; margin-bottom: calc(var(--s-8) * -1); padding: var(--s-8) clamp(var(--s-6), 4vw, var(--s-9)); box-shadow: 0 30px 60px -40px rgb(0 0 0 / .35); }
    .sw-row.flip .sw-media { grid-column: 5 / 13; }
    .sw-row.flip .sw-text { grid-column: 1 / 6; }
    .sw-list { gap: calc(var(--s-10) + var(--s-6)); padding-bottom: var(--s-8); }
  }
</style>
