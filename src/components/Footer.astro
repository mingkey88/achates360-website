---
import { renderMd } from '../lib/markdown';
import { withBase, linkAttrs } from '../lib/paths';
import Logo from './ui/Logo.astro';
import SocialIcon from './ui/SocialIcon.astro';
interface Props { blocks: any[] }
const { blocks } = Astro.props;
// site.md footer blocks, verbatim: the intro line, then the legal lines; each "###### Label" text
// block (Contact, Social) opens a column. Social icons become text links named by their alt text.
const isLabel = (b: any) => b.type === 'text' && /^#{6}\s/.test(b.md);
const columns: any[][] = [[]];
for (const b of blocks) {
  if (isLabel(b)) columns.push([]);
  columns.at(-1)!.push(b);
}
const [[intro, ...legal], ...rest] = columns;
// The export's footer copy uses ##### / ###### for styling, which skips heading levels on every
// page. Keep the words, render those two as styled paragraphs (the copy itself is unchanged).
const md = (s: string, opts?: any) => renderMd(s, undefined, opts).replace(/<(\/?)h([56])\b([^>]*)>/g, (_m, close, n, attrs) => close ? '</p>' : `<p class="fh${n}"${attrs}>`);
---
<footer class="site-footer">
  <div class="wrap grid">
    {intro && <div class="intro" set:html={md(intro.md)} />}
    {rest.map((col) => (
      <div class="col">
        {col.filter((b) => b.type === 'text').map((b) => <div class="md" set:html={md(b.md)} />)}
        {col.some((b) => b.type === 'image') && (
          <ul class="social">
            {col.filter((b) => b.type === 'image').map((b) => (
              <li>{b.href ? <a href={withBase(b.href)} {...linkAttrs(b.href)}><SocialIcon name={b.alt} /><span class="social-name">{b.alt}</span></a> : <span>{b.alt}</span>}</li>
            ))}
          </ul>
        )}
      </div>
    ))}
    <div class="legal">{legal.map((b) => <div class="md" set:html={md(b.md)} />)}</div>
  </div>
  <div class="mega-mark"><Logo /></div>
</footer>
<style>
  .site-footer { background: var(--teal-ink); color: var(--on-dark); padding-top: var(--section-y); overflow: hidden; }
  .site-footer :focus-visible { outline-color: var(--turquoise); }
  .grid { display: grid; gap: var(--s-7); grid-template-columns: minmax(0, 1fr); }
  .intro :global(:is(h1, h2, h3, h4, h5, h6, .fh5, .fh6)) { margin: 0; font: 400 var(--fs-lead)/1.5 var(--font-display); max-width: 30ch; }
  .col { display: grid; gap: var(--s-3); align-content: start; font-size: var(--fs-small); }
  .md :global(.fh6) { margin: 0 0 var(--s-3); padding-bottom: var(--s-3); border-bottom: 1px solid rgb(255 254 242 / .35); font: 400 var(--fs-small)/1 var(--font-text); color: var(--on-dark); }
  .md :global(.fh5) { margin: 0; font: 400 var(--fs-small)/1.6 var(--font-text); }
  .md :global(p) { margin: 0; }
  .md :global(a), .social a { display: inline-block; padding-block: 6px; text-decoration-color: rgb(255 254 242 / .45); text-underline-offset: 3px; }
  /* After nationalgallery.sg: square outlined marks, the network's name beside each. */
  .social { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-2); }
  .social a { display: inline-flex; align-items: center; gap: var(--s-3); padding-block: 4px; text-decoration: none; }
  .social :global(.social-icon) { flex: none; width: 40px; height: 40px; padding: 10px; border: 1px solid rgb(255 254 242 / .45); fill: currentColor; transition: background-color .25s, color .25s; }
  .social a:hover :global(.social-icon) { background: var(--on-dark); color: var(--teal-ink); }
  .social a:hover .social-name { text-decoration: underline; text-underline-offset: 3px; }
  .legal { font-size: var(--fs-label); color: var(--on-dark-2); }
  .mega-mark {
    margin: var(--s-8) auto 0; padding-inline: var(--gutter); max-width: 560px; color: var(--on-dark); opacity: .9;
    -webkit-mask-image: linear-gradient(180deg, #000 10%, transparent 95%); mask-image: linear-gradient(180deg, #000 10%, transparent 95%);
  }
  .mega-mark :global(.logo) { display: block; width: 100%; height: auto; margin-bottom: -2%; }
  @media (min-width: 768px) {
    .grid { grid-template-columns: minmax(0, 2fr) repeat(2, minmax(160px, 1fr)); }
    .legal { grid-column: 1 / -1; }
  }
</style>
