---
import { withBase } from '../lib/paths';
import type { UiString } from '../lib/strings';
import T from './ui/T.astro';
import Pic from './ui/Pic.astro';
import { morphName } from '../lib/morph';
import { getImage } from 'astro:assets';
import HeroMedia from './ui/HeroMedia.astro';
// The end of a case study: the next project's picture, wide, with "Next project" and its name beneath,
// and beside them the way to start one like this. The picture and name are one link; the picture drifts
// larger on hover. (The paper-cut lettering over the picture was removed with the print devices,
// 21 Oct 2026; the paper cut stays only on the 404 page.)
// The curtain (10 Nov 2026, the homepage's opening run the other way): the block is one screen high and
// waits at the foot of the window behind the case study, which lifts away at its end like a sheet
// (Project.astro .p-sheet) to uncover it; its picture then grows into the next case study's hero as that
// page opens (lib/morph). The picture is cut 16:9 (4:5 on phones) so it fills that screen-high frame
// without being enlarged; it was 21:9 and 4:3. The curtain itself is CSS (position: sticky); under reduced
// motion, and on very short windows, it is the plain band it was. One small script: the block's links can
// take the keyboard's focus while the page still covers them, so it is then brought fully into view.
// The picture's cross-page name is not in the markup: under the curtain the block sits inside the window
// from the start, hidden behind the case study, and the browser lifts every named element above the page
// during a page transition, so the next project's picture flashed over a case study as it opened
// (client, 11 Nov 2026). The script names the picture only while at least half of it is uncovered.
// Fetching ahead (client, 11 Nov 2026: "a slight pause (black screen) before going into the entire
// image"): the next case study's hero sits on a dark ground until its picture arrives. Its hero is kept
// here in a <template> (the same HeroMedia its page renders, so the browser picks the very same file), and
// the script puts it in a hidden, inert box once the reader is within a screen of this block, so the file
// is already in the cache when the next page opens. Not under Save-Data.
type Media = { type: 'image'; src: ImageMetadata; alt: string } | { type: 'video'; src: string; poster: ImageMetadata };
interface Props { href: string; title: string | UiString; label: UiString; image: ImageMetadata; position?: string; preload?: Media; discuss?: { label: UiString; href: string } }
const { href, title, label, image, position, preload, discuss } = Astro.props;
// A film hero shows its poster on wide screens (BgVideo sets it by script, from this same file).
const posterUrl = preload?.type === 'video' ? (await getImage({ src: preload.poster, width: 1920, format: 'webp' })).src : undefined;
const morph = morphName(href);
---
<section class="next-project">
  <div class="np-band wrap">
    <a class="np" href={withBase(href)}>
      <span class="np-pic" data-morph={morph}><Pic src={image} alt="" crop={16 / 9} mobileCrop={4 / 5} widths={[640, 960, 1280, 1920]} mobileWidths={[400, 600, 800, 1080]} sizes="(max-width: 767px) calc(100vw - 32px), min(1320px, 100vw - 120px)" mobileSizes="calc(100vw - 32px)" position={position} loading="lazy" /></span>
      <span class="np-meta">
        <span class="label"><T s={label} /></span>
        <span class="np-title">{typeof title === 'string' ? title : <T s={title} />} <span class="np-arrow" aria-hidden="true">→</span></span>
      </span>
    </a>
    {discuss && (
      <a class="np-discuss" href={withBase(discuss.href)}><T s={discuss.label} /> <span aria-hidden="true">→</span></a>
    )}
  </div>
  {preload && (
    <template data-np-preload>
      <HeroMedia media={preload} />
      {posterUrl && <img src={posterUrl} alt="" data-wide />}
    </template>
  )}
</section>
<script>
  // Keyboard focus landing on a link the case study still covers: scroll the page clear of the block
  // (to its own place in the page, where it fills the window). Pointer presses are left alone.
  for (const np of document.querySelectorAll<HTMLElement>('.next-project')) {
    // The picture carries its cross-page name (data-morph, lib/morph) only while it can be seen: with no
    // curtain (the plain band) always; under the curtain once the case study has lifted off half of it.
    const pic = np.querySelector<HTMLElement>('.np-pic[data-morph]');
    const sheet = np.previousElementSibling;
    // Fetch the next case study's hero ahead, once, when the reader is within a screen of this block.
    const tpl = np.querySelector<HTMLTemplateElement>('template[data-np-preload]');
    let warmed = !tpl || !sheet;
    const warm = () => {
      if (warmed || sheet!.getBoundingClientRect().bottom > window.innerHeight * 2) return;
      warmed = true;
      if ((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData) return;
      const frag = tpl!.content.cloneNode(true) as DocumentFragment;
      if (!window.matchMedia('(min-width: 768px)').matches) frag.querySelectorAll('[data-wide]').forEach((el) => el.remove());
      const box = document.createElement('div');
      box.className = 'np-warm';
      box.inert = true;
      box.setAttribute('aria-hidden', 'true');
      box.append(frag);
      np.append(box);
    };
    warm();
    window.addEventListener('scroll', warm, { passive: true });
    if (pic) {
      const sync = () => {
        const r = pic.getBoundingClientRect();
        const covered = getComputedStyle(np).position === 'sticky' && !!sheet && sheet.getBoundingClientRect().bottom > r.top + r.height / 2;
        pic.style.viewTransitionName = covered ? '' : pic.dataset.morph!;
      };
      sync();
      window.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
    }
    np.addEventListener('focusin', (e) => {
      if (getComputedStyle(np).position !== 'sticky' || !(e.target as Element).matches(':focus-visible')) return;
      const cover = np.previousElementSibling?.getBoundingClientRect().bottom ?? 0;
      if (cover > 0) window.scrollBy({ top: cover, behavior: 'instant' });
    });
  }
</script>
<style>
  /* A stone band ending on a hairline, so it no longer runs into the charcoal footer. */
  .next-project { position: relative; background: var(--stone); color: var(--ink); border-bottom: 1px solid var(--line); }
  /* The next hero fetched ahead (the script's box): present so its picture loads, never seen or reached. */
  .next-project :global(.np-warm) { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: hidden; opacity: 0; pointer-events: none; }
  .np-band { display: grid; gap: var(--s-6); padding-block: var(--section-y); }
  .np { display: grid; gap: var(--s-5); text-decoration: none; color: inherit; }
  .np-meta { display: grid; gap: var(--s-2); }
  .label { font-size: var(--fs-small); color: var(--text-2); }
  .np-title { font: 400 var(--fs-h3)/1.2 var(--font-display); color: var(--ink); overflow-wrap: anywhere; text-wrap: balance; }
  .np-arrow { display: inline-block; color: var(--accent-text); transition: transform .3s var(--ease-out); }
  .np:hover .np-arrow { transform: translateX(12px); }
  .np-pic { display: block; overflow: hidden; background: var(--paper); }
  .np-pic :global(img) { display: block; width: 100%; height: auto; transition: scale 1.4s var(--ease-out); }
  .np:hover .np-pic :global(img) { scale: 1.04; }
  /* The second action: a framed link, like the header's Contact. */
  .np-discuss {
    justify-self: start; display: inline-flex; gap: 10px; padding: 12px 20px; border: 1px solid var(--ink);
    color: var(--ink); font-size: var(--fs-small); text-decoration: none; transition: background-color .25s, color .25s;
  }
  .np-discuss:hover { background: var(--ink); color: var(--paper); }
  /* Wide screens: the second action at the right, on the name's line. */
  @media (min-width: 900px) {
    .np-band { position: relative; }
    .np-meta { padding-right: 320px; }
    .np-discuss { position: absolute; right: 0; bottom: var(--section-y); }
  }
  /* The curtain: one screen high, held at the window's foot while the case study above lifts off it.
     It must fit the window to work (a taller block would hide its own top), so the picture takes whatever
     height the words leave, and short windows keep the plain band. */
  @media (prefers-reduced-motion: no-preference) and (min-height: 600px) {
    .next-project { position: sticky; bottom: 0; z-index: 0; height: 100svh; padding-top: var(--header-h); border-bottom: 0; }
    .np-band { --np-pad: clamp(var(--s-5), 5svh, var(--s-8)); height: 100%; padding-block: var(--np-pad); grid-template-rows: minmax(0, 1fr); grid-auto-rows: auto; }
    .np { grid-template-rows: minmax(0, 1fr) auto; min-height: 0; }
    .np-pic { min-height: 0; }
    .np-pic :global(img) { height: 100%; object-fit: cover; }
  }
  @media (prefers-reduced-motion: no-preference) and (min-height: 600px) and (min-width: 900px) { .np-discuss { bottom: var(--np-pad); } }
  @media (prefers-reduced-motion: reduce) { .np-arrow, .np-discuss, .np-pic :global(img) { transition: none; } }
</style>
