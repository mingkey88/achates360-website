---
import BgVideo from './BgVideo.astro';
import FilmDialog from './ui/FilmDialog.astro';
import Pill from './ui/Pill.astro';
import T from './ui/T.astro';
import { loadExtras } from '../lib/extras';
import type { UiString } from '../lib/strings';
// The homepage hero, after aesop.com (client, 21 Oct 2026): the studio's showreel, a silent loop, fills
// most of the first screen under the solid header (client, 26 Oct 2026), with no words over it (client:
// "the words preferably don't overlap the video… keep it small at the bottom"); only Play with sound
// sits on the film, at its lower left, as a control for it (client, 26 Oct 2026), the pause key at its
// lower right. A slim band beneath, on the paper, closes the first screen: the tagline (the page's h1,
// named with the studio), the studio's description and Discuss your project (to /contact; View all
// projects follows the work tiles below). The loop is the studio's 15 s hero cut (23 Oct 2026); phones
// load a smaller copy (phonePreview). Under reduced motion the loop holds on its poster (BgVideo).
interface Props {
  name: UiString; tagline: UiString; blurb: string; label: UiString; playLabel: UiString; closeLabel: string;
  contact: UiString; src: string; preview: string; phonePreview: string; poster: ImageMetadata;
}
const { name, tagline, blurb, label, playLabel, closeLabel, contact, src, preview, phonePreview, poster } = Astro.props;
const { text: t } = await loadExtras();
---
<section class="vh" aria-labelledby="vh-title">
  <div class="vh-stage">
    <BgVideo src={preview} phoneSrc={phonePreview} desktopOnly eager poster={poster} class="vh-video" pauseLabel={t('video-pause').text} playLabel={t('video-play').text} draft={t('video-pause').placeholder} />
    <button class="vh-play" type="button" data-film="hero-film">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg>
      <T s={playLabel} />
    </button>
  </div>
  <div class="vh-bar">
    <h1 id="vh-title" class="vh-tagline"><span class="sr-only">{name.text}: </span>{tagline.text.replace(/ •/g, ' •')}</h1>
    <p class="vh-blurb">{blurb}</p>
    <div class="vh-actions">
      <Pill href="/contact"><T s={contact} /></Pill>
    </div>
  </div>
  <FilmDialog id="hero-film" label={label.text} closeLabel={closeLabel} src={src} poster={poster} />
</section>
<style>
  /* The film and the band together fill the first screen under the header; the film takes whatever the
     band leaves. */
  .vh { display: grid; grid-template-rows: minmax(0, 1fr) auto; min-height: max(calc(100svh - var(--header-h) - env(safe-area-inset-top, 0px)), 520px); }
  .vh-stage { position: relative; min-height: 320px; background: var(--ink); overflow: clip; }
  .vh-stage :global(.vh-video) { position: absolute; inset: 0; }
  .vh-stage :global(.vh-video :is(video, .bv-noscript)) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vh-stage :global(.bv-toggle) { z-index: 2; }
  /* Play with sound: a solid paper key on the film, so it reads on any frame. */
  .vh-play {
    position: absolute; left: var(--gutter); bottom: var(--s-4); z-index: 2; display: inline-flex; align-items: center; gap: 10px;
    min-height: 44px; padding: 12px 20px 12px 16px; border: 0; background: var(--paper); color: var(--ink); cursor: pointer;
    font: 400 var(--fs-small)/1 var(--font-text); transition: background-color .25s, color .25s;
  }
  .vh-play:hover { background: var(--ink); color: var(--paper); }
  .vh-play:focus-visible { outline: 2px solid var(--ink); outline-offset: -5px; }
  .vh-play svg { width: 14px; height: 14px; fill: currentColor; }

  .vh-bar {
    display: grid; gap: var(--s-3) var(--s-6); align-items: center;
    padding: var(--s-5) var(--gutter); border-bottom: 1px solid var(--line);
  }
  .vh-tagline { margin: 0; font: 400 clamp(1.25rem, 1rem + .8vw, 1.75rem)/1.15 var(--font-display); letter-spacing: -.01em; text-wrap: balance; }
  .vh-blurb { margin: 0; max-width: 62ch; min-width: 0; font-size: var(--fs-small); line-height: 1.5; color: var(--text-2); }
  .vh-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-5); }
  /* Wide screens: one row, tagline | description | actions. */
  @media (min-width: 1024px) {
    .vh-bar { grid-template-columns: auto minmax(0, 1fr) auto; }
    .vh-tagline { max-width: 14ch; }
  }
  @media (prefers-reduced-motion: reduce) { .vh-play { transition: none; } }
</style>
