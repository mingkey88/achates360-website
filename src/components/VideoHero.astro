---
import BgVideo from './BgVideo.astro';
import FilmDialog from './ui/FilmDialog.astro';
import Pill from './ui/Pill.astro';
import T from './ui/T.astro';
import { loadExtras } from '../lib/extras';
import type { UiString } from '../lib/strings';
// The homepage hero, after aesop.com (client, 21 Oct 2026): the studio's showreel fills the first screen
// as a silent loop behind the transparent header. At its foot, centred: what is playing, the tagline
// (the page's h1, named with the studio), the studio's description, the way to all the work and the
// full film with sound. A scrim darkens the top (for the header) and the foot (for the words).
// Under reduced motion the loop holds on its poster with a Play button (BgVideo).
interface Props {
  name: UiString; tagline: UiString; blurb: string; label: UiString; playLabel: UiString; closeLabel: string;
  cta: UiString; count: number; src: string; preview: string; poster: ImageMetadata;
}
const { name, tagline, blurb, label, playLabel, closeLabel, cta, count, src, preview, poster } = Astro.props;
const { text: t } = await loadExtras();
---
<section class="vh" aria-labelledby="vh-title">
  <BgVideo src={preview} poster={poster} class="vh-video" pauseLabel={t('video-pause').text} playLabel={t('video-play').text} draft={t('video-pause').placeholder} />
  <div class="vh-copy">
    <p class="vh-label"><T s={label} /></p>
    <h1 id="vh-title" class="vh-tagline"><span class="sr-only">{name.text}: </span>{tagline.text.replace(/ •/g, ' •')}</h1>
    <p class="vh-blurb">{blurb}</p>
    <div class="vh-actions">
      <Pill href="/projects" variant="light"><T s={cta} /><span class="vh-count">({count})</span></Pill>
      <button class="vh-play" type="button" data-film="hero-film">
        <span class="vh-ring"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z" /></svg></span>
        <T s={playLabel} />
      </button>
    </div>
  </div>
  <FilmDialog id="hero-film" label={label.text} closeLabel={closeLabel} src={src} poster={poster} />
</section>
<style>
  .vh {
    position: relative; display: grid; align-items: end; min-height: max(100svh, 560px);
    background: var(--ink); color: var(--white); overflow: clip;
  }
  .vh :global(.vh-video) { position: absolute; inset: 0; }
  .vh :global(.vh-video video) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vh::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgb(13 13 13 / .45) 0, rgb(13 13 13 / 0) 24%, rgb(13 13 13 / 0) 36%, rgb(13 13 13 / .8) 100%);
  }
  .vh :global(.bv-toggle) { z-index: 3; }
  .vh-copy {
    position: relative; z-index: 2; display: grid; justify-items: center; gap: var(--s-4);
    width: 100%; max-width: 60rem; margin-inline: auto; padding: 0 var(--gutter) var(--s-9); text-align: center;
  }
  .vh-label { margin: 0; font-size: var(--fs-small); letter-spacing: .02em; }
  .vh-tagline { margin: 0; font: 400 clamp(2.25rem, 1.3rem + 3.2vw, 4.75rem)/1.04 var(--font-display); letter-spacing: -.025em; text-wrap: balance; }
  .vh-blurb { margin: 0; max-width: 56ch; font: 400 var(--fs-lead)/1.5 var(--font-text); color: rgb(255 255 255 / .88); }
  .vh-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--s-4) var(--s-6); margin-top: var(--s-4); }
  .vh-count { font-variant-numeric: tabular-nums; }
  .vh-play {
    display: inline-flex; align-items: center; gap: 12px; min-height: 52px; padding: 0; border: 0;
    background: none; color: inherit; cursor: pointer; font: 400 var(--fs-body)/1 var(--font-text);
  }
  .vh-ring {
    display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid currentColor; border-radius: 50%;
    transition: background-color .3s, color .3s;
  }
  .vh-ring svg { width: 14px; height: 14px; margin-left: 2px; fill: currentColor; }
  .vh-play:is(:hover, :focus-visible) .vh-ring { background: var(--white); color: var(--ink); }
  .vh :focus-visible { outline-color: var(--white); }
  @media (max-width: 767px) {
    .vh-copy { padding-bottom: var(--s-8); gap: var(--s-3); }
    .vh-blurb { font-size: var(--fs-body); }
    .vh :global(.bv-toggle) { top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + var(--s-3)); bottom: auto; right: var(--s-3); }
  }
  @media (prefers-reduced-motion: reduce) { .vh-ring { transition: none; } }
</style>
