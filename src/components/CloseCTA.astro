---
import Pill from './ui/Pill.astro';
import T from './ui/T.astro';
import type { UiString } from '../lib/strings';
// The inner pages' quiet close (direction B): one line and one button to the contact page, centred in
// open space. A leader line runs in from the page's left edge to the heading, ending in a short thick bar
// of the brand orange (after nationalgallery.sg's section heads). The homepage closes with the scattering
// pictures (ScatterCTA) instead.
interface Props { heading: UiString; cta: UiString; href: string }
const { heading, cta, href } = Astro.props;
---
<section class="close wrap" aria-labelledby="close-title">
  <div class="close-head">
    <span class="close-lead" aria-hidden="true"></span>
    <h2 id="close-title" class="display" data-split><T s={heading} /></h2>
  </div>
  <Pill href={href} variant="fill"><T s={cta} /></Pill>
</section>
<style>
  .close { display: grid; justify-items: center; gap: var(--s-7); padding-block: calc(var(--section-y) * 1.4); text-align: center; }
  /* The heading sits at the centre; the leader fills the left half of the row and runs out to the page edge. */
  .close-head { justify-self: stretch; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; column-gap: var(--s-5); }
  .close-lead { position: relative; height: 1px; margin-left: calc(-1 * max(var(--gutter), (100vw - var(--max)) / 2)); background: var(--ink); }
  .close-lead::after { content: ''; position: absolute; right: 0; top: -2px; width: 48px; height: 5px; background: var(--accent); }
  .close h2 { margin: 0; font: 400 var(--fs-h1)/1.15 var(--font-display); }
</style>
