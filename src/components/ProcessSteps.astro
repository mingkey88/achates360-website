---
import T from './ui/T.astro';
import DraftTag from './ui/DraftTag.astro';
import logo from '../assets/logo-stacked-parts.svg?raw';
import { loadExtras } from '../lib/extras';
import type { UiString } from '../lib/strings';
// How we work (direction B), as a press run: one sheet goes through the studio's four steps.
//   1 Brief    a blank sheet in its crop marks, the job's lines ruled in;
//   2 Concept  the pencil layout: column guides and an empty picture frame;
//   3 Design   the proof: black keyline, registration targets and colour bar, and three plates sliding in
//              from off register to land in register, each printing some of the logo's figures in a brand
//              colour (1495 orange, turquoise, lime);
//   4 Deliver  trimmed: everything outside the trim (marks, targets, colour bar) and the working lines are
//              cut away, the figures settle into the full logo lockup with its tagline (the corporate
//              sheet's, as in the hero), and the sheet lies on a stack of the run.
// Wide screens with motion (motion/press.ts): the section holds still, the sheet at the left, while the
// steps rise in one by one to fill the right side, two by two; the sheet takes each step's stage as it
// arrives. Phones, reduced motion and no JS: the finished sheet, then the steps in a column.
// Step words (body, and the points the client receives) are drafts in process.yaml for the studio to approve.
interface Props { steps: { id: string; step: number; title: string; body: string; points?: string[]; placeholder: boolean }[]; heading: UiString; stepLabel: UiString }
const { steps, heading, stepLabel } = Astro.props;
const tagline = (await loadExtras()).text('hero-tagline');
const figs = [...(logo.match(/<g class="lg-mark">(.*?)<\/g><g class="lg-word">/)?.[1] ?? '').matchAll(/<g class="lg-fig"[^>]*>(.*?)<\/g>/g)].map((m) => m[1]);
const word = logo.slice(logo.indexOf('<g class="lg-word">'), logo.lastIndexOf('</svg>')).replace('class="lg-word"', 'class="pr-word"').replaceAll('lg-ch', 'pr-ch');
const PLATES = [
  { k: 'orange', c: 'var(--accent)', figs: [0, 4], dx: -18, dy: 0 },
  { k: 'teal', c: '#7fcfcf', figs: [1, 3], dx: 0, dy: -18 },
  { k: 'lime', c: '#c3e070', figs: [2], dx: 18, dy: 0 },
];
// The picture frame on the proof, and the figures' place in it (logo units → sheet units).
const F = { x: 78, y: 150, w: 244, h: 190 };
const fig = `translate(${F.x + 40} ${F.y + 12}) scale(${(F.h - 24) / 103}) translate(-50 3)`;
---
<section class="process wrap" aria-labelledby="process-title" data-press>
  <h2 id="process-title" class="display h2" data-split><T s={heading} /></h2>
  <div class="press">
    <figure class="press-fig" aria-hidden="true">
      <svg class="pr" viewBox="0 0 400 500" data-s1 data-s2 data-s3 data-s4 focusable="false">
        {/* The rest of the run, stacked under the sheet once it is delivered. */}
        <g class="l-stack">
          <rect x="56" y="54" width="320" height="420" class="sheet-under" transform="rotate(1.2 216 264)" />
          <rect x="48" y="47" width="320" height="420" class="sheet-under" transform="rotate(-.8 208 257)" />
        </g>
        <rect class="sheet" x="40" y="40" width="320" height="420" />
        <g class="l-crop"><path d="M40 22v12M22 40h12M360 22v12M378 40h-12M40 478v-12M22 460h12M360 478v-12M378 460h-12" /></g>
        {/* 1 Brief: the job's lines, ruled in. */}
        <g class="l-brief">
          <rect x="78" y="78" width="120" height="7" /><rect x="78" y="94" width="186" height="3" /><rect x="78" y="103" width="162" height="3" /><rect x="78" y="112" width="174" height="3" />
          <rect x="296" y="78" width="26" height="26" class="ticket" />
        </g>
        {/* 2 Concept: column guides and the empty frame, in pencil; the text lines under the frame. */}
        <g class="l-sketch">
          <path class="guide" d="M78 64v372M200 64v372M322 64v372" />
          <rect x={F.x} y={F.y} width={F.w} height={F.h} class="frame" />
          <path class="frame" d={`M${F.x} ${F.y}L${F.x + F.w} ${F.y + F.h}M${F.x + F.w} ${F.y}L${F.x} ${F.y + F.h}`} />
        </g>
        <g class="l-lines">
          <rect x="78" y="362" width="104" height="3" /><rect x="78" y="371" width="96" height="3" /><rect x="218" y="362" width="104" height="3" /><rect x="218" y="371" width="88" height="3" />
        </g>
        {/* 3 Design: the proof's keyline, registration targets and colour bar (outside the finished piece). */}
        <g class="l-key">
          <rect x={F.x} y={F.y} width={F.w} height={F.h} class="keyline" />
          <circle cx="58" cy={F.y + F.h / 2} r="6" class="reg" /><path class="reg" d={`M50 ${F.y + F.h / 2}h16M58 ${F.y + F.h / 2 - 8}v16`} />
          <circle cx="342" cy={F.y + F.h / 2} r="6" class="reg" /><path class="reg" d={`M334 ${F.y + F.h / 2}h16M342 ${F.y + F.h / 2 - 8}v16`} />
          <rect x="78" y="414" width="12" height="12" style="fill: #00a0e3" /><rect x="92" y="414" width="12" height="12" style="fill: #e5007e" /><rect x="106" y="414" width="12" height="12" style="fill: #ffed00" /><rect x="120" y="414" width="12" height="12" style="fill: #1d1d1b" /><rect x="134" y="414" width="12" height="12" style="fill: var(--accent)" />
        </g>
        {/* The artwork: the plates and (delivered) the logo's wordmark under them; on delivery the whole
            lockup settles smaller and centred on the trimmed sheet. */}
        <g class="artwork">
          {PLATES.map((p, i) => (
            <g class={`plate plate-${p.k}`} style={`--dx: ${p.dx}px; --dy: ${p.dy}px; --i: ${i}; fill: ${p.c}`}>
              <g transform={fig} set:html={p.figs.map((f) => figs[f]).join('')} />
            </g>
          ))}
          <g class="l-word" transform={fig} set:html={word} />
        </g>
        {/* 4 Deliver: the tagline under the lockup, between hairlines. */}
        <g class="l-final">
          <path class="rule" d="M170 318h60M170 352h60" />
          <text x="200" y="339" text-anchor="middle">{tagline.text}</text>
        </g>
      </svg>
    </figure>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step" data-step={i + 1} data-placeholder={s.placeholder ? '' : undefined}>
          <span class="num"><span class="sr-only">{stepLabel.text} </span>{String(s.step).padStart(2, '0')}</span>
          <h3 class="step-title">{s.title}<DraftTag when={s.placeholder} /></h3>
          <p>{s.body}</p>
          {s.points?.length && <ul class="points">{s.points.map((pt) => <li>{pt}</li>)}</ul>}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { padding-block: var(--section-y); }
  .process h2 { margin: 0; }
  .press { display: grid; gap: var(--s-7); margin-top: var(--s-7); }
  .press-fig { margin: 0; justify-self: center; width: min(100%, 420px); }
  .pr { display: block; width: 100%; height: auto; overflow: visible; }
  /* The sheet is a separate piece of paper, so it casts a shadow (photos printed on the page do not). */
  .sheet { fill: #fffef6; filter: drop-shadow(0 6px 10px rgb(0 0 0 / .14)); }
  .sheet-under { fill: #fbf9ee; stroke: rgb(51 51 51 / .12); stroke-width: 1; }
  .l-crop path { fill: none; stroke: var(--ink); stroke-width: 1; }
  .l-brief rect, .l-lines rect { fill: rgb(51 51 51 / .2); }
  .l-brief .ticket { fill: none; stroke: rgb(51 51 51 / .4); stroke-width: 1; }
  .l-sketch .guide { fill: none; stroke: #7aa2c9; stroke-width: .8; stroke-dasharray: 3 4; opacity: .6; }
  .l-sketch .frame { fill: none; stroke: rgb(51 51 51 / .45); stroke-width: 1; stroke-dasharray: 5 4; }
  .l-key .keyline { fill: none; stroke: var(--ink); stroke-width: 1.4; }
  .l-key .reg { fill: none; stroke: var(--ink); stroke-width: .9; }
  .plate { mix-blend-mode: multiply; }
  .l-word { fill: var(--ink); }
  .l-final .rule { fill: none; stroke: var(--ink); stroke-width: .8; }
  .l-final text { font: 500 11.5px var(--font-text); letter-spacing: .08em; fill: var(--ink); }
  /* The finished lockup: the design-stage artwork scaled to .708 and moved to sit centred on the sheet
     (the logo's 193 units across 220 of the sheet's, its top at 150). */
  .pr[data-s4] .artwork { transform: matrix(.708, 0, 0, .708, 63.45, 35.29); }

  /* Each layer belongs to its stages (attributes on the svg). Without JS all are set: the finished sheet. */
  .l-brief, .l-sketch, .l-lines, .l-key, .plate, .l-word, .l-final, .l-stack { opacity: 0; }
  .pr[data-s1] .l-brief, .pr[data-s2] .l-sketch, .pr[data-s2] .l-lines, .pr[data-s3] .l-key, .pr[data-s3] .plate { opacity: 1; }
  .pr[data-s3] .l-sketch { opacity: 0; }
  /* Delivered: trimmed, so whatever lay outside the finished piece goes; the lockup and tagline stay. */
  .pr[data-s4] :is(.l-brief, .l-sketch, .l-lines, .l-key, .l-crop) { opacity: 0; }
  .pr[data-s4] :is(.l-word, .l-final, .l-stack) { opacity: 1; }

  .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .step { display: grid; gap: var(--s-3); align-content: start; padding: var(--s-6) 0; border-bottom: 1px solid var(--line); }
  .num { font-size: var(--fs-small); color: var(--text-2); font-variant-numeric: tabular-nums; }
  .step-title { margin: 0; font: 400 var(--fs-h2)/1.15 var(--font-display); }
  .step p { margin: 0; max-width: 52ch; font-size: var(--fs-body, 1rem); line-height: 1.6; color: var(--text-2); }
  /* What the client receives at the step: a short list under a hairline. */
  .points { list-style: none; margin: var(--s-1) 0 0; padding: var(--s-3) 0 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); max-width: 60ch; border-top: 1px solid var(--line); font-size: var(--fs-small); }
  .points li { display: flex; gap: var(--s-2); }
  .points li::before { content: '—'; color: var(--text-2); }

  @media (min-width: 1024px) {
    .press { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--s-8); align-items: start; }
    .press-fig { width: 100%; }
    /* Held (motion/press.ts): one screen, the heading over the sheet and the steps; the steps fill the
       right side two by two as they rise in. */
    .process.is-pinned { height: 100svh; padding-block: calc(var(--header-h) + var(--s-5)) var(--s-6); display: grid; grid-template-rows: auto minmax(0, 1fr); }
    .is-pinned .press { min-height: 0; margin-top: var(--s-6); align-items: stretch; }
    .is-pinned .press-fig { display: grid; place-items: start center; min-height: 0; }
    .is-pinned .pr { width: auto; height: 100%; max-width: 100%; max-height: 100%; }
    .is-pinned .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-content: start; column-gap: var(--s-6); border-top: 0; }
    .is-pinned .step { border-bottom: 0; border-top: 1px solid var(--ink); padding: var(--s-4) 0 var(--s-5); gap: var(--s-2); }
    .is-pinned .step-title { font-size: var(--fs-h3); }
    .is-pinned .step p { font-size: var(--fs-small); }
    .is-pinned .points { font-size: .8125rem; gap: var(--s-1) var(--s-4); }
    /* The plates arrive one after another from off register and land; the lockup settles on delivery. */
    .is-pinned .pr :is(.l-stack, .l-crop, .l-brief, .l-sketch, .l-lines, .l-key, .l-word, .l-final) { transition: opacity .6s var(--ease-out); }
    .is-pinned .plate { transform: translate(var(--dx), var(--dy)); transition: opacity .5s var(--ease-out) calc(var(--i) * .18s), transform .9s var(--ease-out) calc(var(--i) * .18s); }
    .is-pinned .pr[data-s3] .plate { transform: none; }
    .is-pinned .artwork { transition: transform 1s var(--ease-out); }
  }
  @media (prefers-reduced-motion: reduce) { .plate, .artwork, .pr * { transition: none !important; } }
</style>
