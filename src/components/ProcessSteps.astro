---
import T from './ui/T.astro';
import DraftTag from './ui/DraftTag.astro';
import type { UiString } from '../lib/strings';
// How we work (direction B): four columns between hairlines, like the homepage's service index:
// a small step number, the step in the heading size, its sentence. No boxes, all text visible.
interface Props { steps: { id: string; step: number; title: string; body: string; placeholder: boolean }[]; heading: UiString; stepLabel: UiString }
const { steps, heading, stepLabel } = Astro.props;
---
<section class="process wrap" aria-labelledby="process-title">
  <h2 id="process-title" class="display h2" data-split><T s={heading} /></h2>
  <ol class="steps">
    {steps.map((s) => (
      <li class="step" data-placeholder={s.placeholder ? '' : undefined} data-reveal>
        <span class="num"><span class="sr-only">{stepLabel.text} </span>{String(s.step).padStart(2, '0')}</span>
        <h3 class="step-title">{s.title}<DraftTag when={s.placeholder} /></h3>
        <p>{s.body}</p>
      </li>
    ))}
  </ol>
</section>
<style>
  .process { padding-block: var(--section-y); }
  .process h2 { margin: 0; }
  .steps { list-style: none; margin: var(--s-7) 0 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1px solid var(--line); }
  .step { display: grid; gap: var(--s-3); align-content: start; padding: var(--s-6) 0; border-bottom: 1px solid var(--line); }
  .num { font-size: var(--fs-small); color: var(--text-2); font-variant-numeric: tabular-nums; }
  .step-title { margin: 0; font: 400 var(--fs-h3)/1.2 var(--font-display); }
  .step p { margin: 0; max-width: 34ch; font-size: var(--fs-small); line-height: 1.6; color: var(--text-2); }
  @media (min-width: 768px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .step { padding-right: var(--s-6); }
  }
  @media (min-width: 1024px) {
    .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
    .step { border-bottom: 0; padding: var(--s-6) var(--s-5) var(--s-7) 0; }
    .step + .step { padding-left: var(--s-5); border-left: 1px solid var(--line); }
  }
</style>
