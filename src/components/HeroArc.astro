---
import Pic from './ui/Pic.astro';
import MarqueeToggle from './ui/MarqueeToggle.astro';
import Pill from './ui/Pill.astro';
import T from './ui/T.astro';
import type { UiString } from '../lib/strings';
import logo from '../assets/logo-stacked-parts.svg?raw';
import { lensPose, lensOpacity, LENS_DESKTOP, LENS_PHONE } from '../lib/lens';
// Direction B homepage hero (after kitpro-croma): a quiet white stage. Project images sit on the
// inside of a cylinder, a lens view: the centre card is furthest away, the side cards come nearer,
// turn toward the viewer and blur into white at the edges. Wide cards on desktop, tall on phones.
// The five logo figures gather above a calm title; the tagline (corporate sheet) and site
// description (Wix SEO text) sit in the bottom corners, both verbatim. hero.ts drifts the cards;
// without motion they render at the composed angles computed here.
interface Item { thumb: ImageMetadata; alt: string; title: string; description: string }
interface Props { items: Item[]; name: UiString; tagline: UiString; blurb: string; cta: UiString }
const { items, name, tagline, blurb, cta } = Astro.props;
// Each card's place on the lens curve (lib/lens.ts), for wide screens (--x/--z/--ry/--o) and phones
// (--mx/--mz/--mry/--mo); CSS picks one set per breakpoint. hero.ts then drifts the strip and writes
// the live values (--cx/--cz/--cry/--co) for the current breakpoint.
const mid = Math.floor(items.length / 2);
// Depth of field, as hero.ts computes it: sharp near the centre, softening and losing a little colour outward.
const dof = (u: number) => { const d = Math.max(0, Math.abs(u) - .55); return `--blur: ${(Math.min(d * 1.6, 5)).toFixed(2)}px; --sat: ${(1 - Math.min(d * .18, .35)).toFixed(2)}`; };
const f = (n: number) => n.toFixed(3);
const pose = (u: number) => {
  const d = lensPose(u, LENS_DESKTOP), m = lensPose(u, LENS_PHONE);
  return `--u: ${u}; ${dof(u)}; --x: ${f(d.x)}; --z: ${f(d.z)}; --ry: ${f(d.ry)}; --o: ${f(lensOpacity(d, LENS_DESKTOP))}; --mx: ${f(m.x)}; --mz: ${f(m.z)}; --mry: ${f(m.ry)}; --mo: ${f(lensOpacity(m, LENS_PHONE))}`;
};
// The full stacked logo (figures over the lowercase wordmark) is the page's h1, named by the wordmark.
const mark = logo.replace('<svg ', `<svg class="ha-mark-svg" role="img" aria-label="${name.text.replace(/"/g, '&quot;')}" `);
---
<section class="ha" data-hero data-mq-scope aria-labelledby="hero-title">
  <div class="ha-arc" data-arc aria-hidden="true">
    {items.map((it, i) => (
      <div class="ha-card" style={pose(i - mid)}>
        <Pic src={it.thumb} alt="" crop={4 / 3} mobileCrop={3 / 4} widths={[320, 480, 640, 960]} mobileWidths={[240, 360, 480, 640]} sizes="24vw" mobileSizes="41vw" loading={Math.abs(i - mid) <= 1 ? 'eager' : 'lazy'} fetchpriority={i === mid ? 'high' : 'low'} draggable="false" />
        <span class="ha-cap"><span class="ha-cap-t">{it.title}</span><span class="ha-cap-d">{it.description}</span></span>
      </div>
    ))}
  </div>
  <div class="ha-copy">
    <h1 id="hero-title" class="ha-mark"><Fragment set:html={mark} /></h1>
    <p class="ha-tagline" data-placeholder={tagline.placeholder ? '' : undefined}>{tagline.text}</p>
    <p class="ha-blurb">{blurb}</p>
    <Pill href="/projects"><T s={cta} /></Pill>
  </div>
  <MarqueeToggle />
</section>
<style>
  .ha {
    /* The header is solid here (no overHero), so the hero fills the screen below it. */
    position: relative; height: max(calc(100svh - var(--header-h)), 560px); overflow: hidden; isolation: isolate;
    display: grid; grid-template-rows: minmax(0, 1fr) auto; padding: var(--s-5) var(--gutter) var(--s-6);
    color: var(--ink); /* transparent: the page's paper and grid show through */
  }
  /* The lens (after kitpro-croma): cards stand edge to edge along a curve that stays almost flat in
     the middle and swings toward the viewer at the edges (lib/lens.ts); a wide-angle camera (short
     perspective) exaggerates the turn, so the outer cards' outer sides stand tall. Each card is placed
     at its curve point (--cx, --cz in vw) and turned to it (--cry degrees). The strip spans the full
     width: two places out a card is already near the screen's edge. */
  .ha { --card-w: 16vw; --card-ratio: 4 / 3; --P: 48vw; } /* --P matches lib/lens.ts */
  .ha-arc {
    position: relative; min-height: 0; perspective: var(--P); perspective-origin: 50% 50%;
    cursor: grab; touch-action: pan-y; user-select: none;
  }
  .ha-arc:active { cursor: grabbing; }
  .ha-card {
    position: absolute; left: 50%; top: 50%; width: var(--card-w); aspect-ratio: var(--card-ratio);
    translate: -50% calc(-50% + var(--rise, 0) * 1px); border-radius: 0; overflow: hidden; background: var(--panel);
    --cx: var(--x, 0); --cz: var(--z, 0); --cry: var(--ry, 0); --co: var(--o, 1);
    transform: translate3d(calc(var(--cx) * 1vw), 0, calc(var(--cz) * 1vw)) rotateY(calc(var(--cry) * -1deg));
    opacity: calc(var(--co) * var(--in, 1));
    /* Depth of field: like a wide-open lens, the cards soften gradually toward the edges. */
    filter: blur(var(--blur, 0px)) saturate(var(--sat, 1));
  }
  /* Lens edges: the outer cards fade out into the page. A mask, not a paper-coloured overlay, so the
     page's grid runs on unbroken behind them; a small square over the pause button (top: --s-5, right:
     --gutter, 44px) keeps it opaque, and so does the lower 44% where the logo and text sit (the cards end
     above it), so on phones the full-width text is never faded. The
     softening itself is per card (depth of field). */
  .ha {
    --fade: 12%;
    -webkit-mask: linear-gradient(90deg, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent), linear-gradient(#000, #000) calc(100% - var(--gutter) + 8px) var(--s-4) / 60px 60px no-repeat, linear-gradient(#000, #000) 0 100% / 100% 44% no-repeat;
    mask: linear-gradient(90deg, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent), linear-gradient(#000, #000) calc(100% - var(--gutter) + 8px) var(--s-4) / 60px 60px no-repeat, linear-gradient(#000, #000) 0 100% / 100% 44% no-repeat;
  }
  .ha-card :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  /* After terrot: the project name and client written on the card, over a soft shade. */
  /* Film grain over each photograph, under the caption. */
  .ha-card::before { content: ''; position: absolute; inset: 0; z-index: 1; background: var(--grain); opacity: .16; mix-blend-mode: overlay; pointer-events: none; }
  .ha-card::after { content: ''; position: absolute; inset: 45% 0 0; background: linear-gradient(transparent, rgb(0 0 0 / .55)); pointer-events: none; }
  .ha-cap { position: absolute; inset: auto 0 0; z-index: 2; display: grid; gap: 4px; padding: 6% 7%; color: var(--white); text-align: center; pointer-events: none; }
  .ha-cap-t { font: 500 clamp(.875rem, .5rem + .9vw, 1.5rem)/1.05 var(--font-title); letter-spacing: -.02em; text-wrap: balance; }
  .ha-cap-d { font: 500 clamp(.5625rem, .5rem + .2vw, .6875rem)/1.2 var(--font-text); letter-spacing: 0; opacity: .85; }

  /* After Aesop: one centred stack (logo, tagline, a short paragraph, one button). */
  .ha-copy { display: grid; justify-items: center; gap: var(--s-3); padding-top: var(--s-5); text-align: center; }
  .ha-mark { margin: 0 0 var(--s-2); width: clamp(120px, 11vw, 168px); color: var(--ink); }
  .ha-mark :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
  .ha-tagline { margin: 0; font: 400 var(--fs-lead)/1.4 var(--font-text); }
  .ha-blurb { margin: 0 0 var(--s-4); max-width: 52ch; font: 400 var(--fs-small)/1.6 var(--font-text); color: var(--text-2); }
  .ha :global(.mq-toggle) { top: var(--s-5); bottom: auto; translate: none; background: var(--paper); border-color: var(--ink); color: var(--ink); }

  @media (max-width: 767px) {
    /* Phones: tall cards, same lens. */
    .ha { --card-w: 40.8vw; --card-ratio: 3 / 4; --P: 74.4vw; }
    .ha-card { --cx: var(--mx, 0); --cz: var(--mz, 0); --cry: var(--mry, 0); --co: var(--mo, 1); }
    .ha { --fade: 16%; }
  }
</style>
