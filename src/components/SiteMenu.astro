---
/*
 * Desktop site menu, as observed on the live site (Playwright, 1440x900 and 1920x900).
 *
 * A hamburger pinned top right (35x35 box, 60px from the right edge, 52px down, white 3-bar icon
 * 25.56:22 fitted to its width) opens a full-window lightbox: rgba(47,46,46,.95) over the page,
 * a 980x585 box centred in the window. The close "X" (white, 35x35) sits where the hamburger is.
 * In the box: the menu row 267px down, centred, items Helvetica Bold 28px/50px with 25px either
 * side (15px item padding + 10px label padding), white; the current page (or the item holding it in its sub-menu) and hovered items are
 * #adadac. Hovering PROJECTS drops its sub-menu 7px below the row: a list centred under the item,
 * rgba(47,46,46,.2), rows 43px of Helvetica Bold 28px/43px with 19px either side, as long as it
 * needs (the lightbox scrolls). The social bar is 402px down at x=413: 25px icons 28px apart.
 * Escape and the close button close the lightbox; so does a click on the overlay.
 *
 * Accessibility: the lightbox is a modal <dialog> (focus stays inside; Escape closes); focus
 * returns to the hamburger. Sub-menus open on hover or with their toggle button ("More X pages",
 * Wix's own label), which keyboard users reach after the item.
 * Wix's mobile layout has its own menu (MobileMenu.astro): this one is desktop only.
 */
import { Image } from 'astro:assets';
import { withBase, menuCurrent } from '../lib/paths';
interface Link { label: string; href: string }
interface Props { menu: (Link & { items?: Link[] })[]; social?: { src: ImageMetadata; alt: string; href: string }[]; path: string }
const { menu, social = [], path } = Astro.props;
const external = (href: string) => /^https?:\/\//.test(href);
---
<button class="menu-open" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
  <svg viewBox="0 0 25.56 22" aria-hidden="true"><path d="M25.56 0v2H0V0h25.56zM25.56 10v2H0v-2h25.56zM25.56 20v2H0v-2h25.56z" /></svg>
</button>
<dialog id="site-menu" class="site-menu" aria-label="Menu">
  <div class="box">
    <nav aria-label="Site">
      <ul class="items">
        {menu.map((it, i) => {
          const current = menuCurrent(it, path);
          return (
            <li class:list={['item', { current, 'has-sub': it.items }]}>
              <a href={withBase(it.href)} aria-current={current === 'page' ? 'page' : undefined}>{it.label}</a>
              {it.items && (
                <>
                  <button class="sub-toggle" type="button" aria-expanded="false" aria-controls={`site-menu-sub-${i}`} aria-label={`More ${it.label} pages`}>
                    <svg viewBox="0 0 10 6.3" aria-hidden="true"><path d="M0 0l5 5 5-5" /></svg>
                  </button>
                  <div class="sub" id={`site-menu-sub-${i}`}>
                    <ul>
                      {it.items.map((s) => (
                        <li><a href={withBase(s.href)} aria-current={s.href === path ? 'page' : undefined}>{s.label}</a></li>
                      ))}
                    </ul>
                  </div>
                </>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
    {social.length > 0 && (
      <ul class="social">
        {social.map((s) => (
          <li>
            <a href={withBase(s.href)} aria-label={s.alt} {...(external(s.href) ? { target: '_blank', rel: 'noreferrer noopener' } : {})}>
              <Image src={s.src} alt="" width={25} height={25} densities={[1, 2]} />
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
  <button class="menu-close" type="button" aria-label="Back to site">
    <svg viewBox="25.975 25.975 148.05 148.05" aria-hidden="true"><path d="M172.9 167.6L105.3 100l67.6-67.6c1.5-1.5 1.5-3.8 0-5.3s-3.8-1.5-5.3 0L100 94.7 32.4 27.1c-1.5-1.5-3.8-1.5-5.3 0s-1.5 3.8 0 5.3L94.7 100l-67.6 67.6c-1.5 1.5-1.5 3.8 0 5.3s3.8 1.5 5.3 0l67.6-67.6 67.6 67.6c1.5 1.5 3.8 1.5 5.3 0s1.5-3.8 0-5.3z" /></svg>
  </button>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#site-menu');
  const opener = document.querySelector<HTMLButtonElement>('.menu-open');
  if (dialog && opener) {
    opener.addEventListener('click', () => {
      dialog.showModal();
      opener.setAttribute('aria-expanded', 'true');
    });
    dialog.querySelector('.menu-close')!.addEventListener('click', () => dialog.close());
    // A click on the overlay itself (not on the menu) closes, as on Wix.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => {
      opener.setAttribute('aria-expanded', 'false');
      for (const t of dialog.querySelectorAll('.sub-toggle')) setOpen(t as HTMLButtonElement, false);
      opener.focus();
    });
    const setOpen = (toggle: HTMLButtonElement, open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.closest('.item')!.classList.toggle('open', open);
    };
    for (const t of dialog.querySelectorAll<HTMLButtonElement>('.sub-toggle')) {
      t.addEventListener('click', () => setOpen(t, t.getAttribute('aria-expanded') !== 'true'));
    }
  }
</script>
<style>
  .menu-open {
    position: fixed; top: 52px; right: 60px; z-index: 60;
    width: 35px; height: 35px; padding: 0; border: 0; background: none; cursor: pointer;
  }
  .menu-open svg { display: block; width: 100%; height: 100%; fill: #fff; }
  .menu-open:focus-visible, .site-menu :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  .site-menu {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0; overflow-y: auto; overscroll-behavior: contain;
    background: rgb(47 46 46 / 0.95); color: #fff;
  }
  .site-menu::backdrop { background: transparent; }
  .box { position: relative; width: 980px; height: 585px; margin: max(0px, calc(50vh - 292.5px)) auto 0; }

  nav { position: absolute; top: 267px; left: 0; right: 0; }
  .items { display: flex; justify-content: center; margin: 0; padding: 0; list-style: none; }
  .item { position: relative; }
  .item > a {
    display: block; padding: 0 25px; color: #fff; text-decoration: none; white-space: nowrap;
    font: 700 28px / 50px var(--font-heading);
  }
  .item.current > a, .item > a:hover, .sub a:hover, .sub a[aria-current] { color: var(--color-muted); }

  /* Wix's toggle sits at the item's right edge and shows only to keyboard users. */
  .sub-toggle {
    position: absolute; top: 0; right: -12px; z-index: 1; width: 24px; height: 24px; padding: 7px;
    border: 0; background: none; opacity: 0; cursor: pointer;
  }
  .sub-toggle:focus-visible { opacity: 1; }
  .sub-toggle svg { display: block; width: 100%; height: 100%; fill: none; stroke: #fff; stroke-width: 1.5; }
  .sub {
    display: none; position: absolute; top: 50px; left: 50%; z-index: 2; transform: translateX(-50%);
    padding-top: 7px;
  }
  .item.has-sub:hover .sub, .item.open .sub { display: block; }
  .sub ul { margin: 0; padding: 0 5px; list-style: none; background: rgb(47 46 46 / 0.2); }
  .sub a {
    display: block; padding: 0 14px; color: #fff; text-align: center; text-decoration: none; white-space: nowrap;
    font: 700 28px / 43px var(--font-heading);
  }

  .social { position: absolute; top: 402px; left: 413px; display: flex; gap: 28px; margin: 0; padding: 0; list-style: none; }
  .social li, .social a { display: block; line-height: 0; }
  .social :global(img) { width: 25px; height: 25px; }

  .menu-close {
    position: fixed; top: 53px; right: 61px; z-index: 3;
    width: 35px; height: 35px; padding: 0; border: 0; background: none; cursor: pointer;
  }
  .menu-close svg { display: block; width: 100%; height: 100%; fill: #fff; }

  @media (max-width: 767px) {
    .menu-open, .site-menu { display: none; }
  }
</style>
