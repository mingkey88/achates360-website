---
import Eyebrow from './ui/Eyebrow.astro';
import StatCounter from './ui/StatCounter.astro';
import T from './ui/T.astro';
import DraftTag from './ui/DraftTag.astro';
import { statValue } from '../lib/meta';
import { splitLastWord } from '../lib/copy';
import type { UiString } from '../lib/strings';
// Direction B homepage: the imprint page, straight after the selected work. The clients as a ruled roster
// (the persuasion a bank or hotel looks for), the awards line as a ruled list, one award per row, and the
// figures small beneath, as a book's imprint sets its particulars. All wording verbatim: the awards are
// the supplied line split at its " · " separators. One Draft mark per list, as each is one approval.
// On the homepage the section heading ("Trusted by") heads the roster and the figures close the page; on
// About the heading ("In numbers") heads the figures, which come first, and the roster gets its own label.
interface Props {
  stats: { id: string; value: number | 'listed-projects'; suffix?: string; label: string; placeholder: boolean }[];
  listedCount: number;
  clients: { id: string; name: string; placeholder: boolean }[];
  eyebrow: UiString;
  awards: UiString;
  awardsLabel: UiString;
  clientsLabel?: UiString;
}
const { stats, listedCount, clients, eyebrow, awards, awardsLabel, clientsLabel } = Astro.props;
const clientsDraft = clients.some((c) => c.placeholder);
const awardList = awards.text.split(' · ').map((a) => a.trim()).filter(Boolean);
---
<section class="cr section" aria-labelledby="cr-title">
  <div class="wrap cr-grid">
    {clientsLabel && <Eyebrow as="h2" id="cr-title"><T s={eyebrow} /></Eyebrow>}
    {/* The figures: first (in reading order too) on About, under its "In numbers" heading; last on Home. */}
    {clientsLabel && <div class="cr-stats">
      {stats.map((s) => <StatCounter value={statValue(s, listedCount)} suffix={s.suffix} label={s.label} placeholder={s.placeholder} />)}
    </div>}
    <div class="cr-roster">
      {clientsLabel ? <Eyebrow as="h3"><T s={clientsLabel} /></Eyebrow> : <Eyebrow as="h2" id="cr-title"><T s={eyebrow} /></Eyebrow>}
      <ul class="cr-list cr-clients" data-placeholder={clientsDraft ? '' : undefined}>
        {clients.map((c, i) => <li>{i < clients.length - 1 ? c.name : <>{splitLastWord(c.name)[0]}<span class="nw">{splitLastWord(c.name)[1]}<DraftTag when={clientsDraft} /></span></>}</li>)}
      </ul>
    </div>
    <div class="cr-honours">
      <Eyebrow as="h3"><T s={awardsLabel} /></Eyebrow>
      <ul class="cr-list cr-awards" data-placeholder={awards.placeholder ? '' : undefined}>
        {awardList.map((a, i) => <li>{i < awardList.length - 1 ? a : <>{splitLastWord(a)[0]}<span class="nw">{splitLastWord(a)[1]}<DraftTag when={awards.placeholder} /></span></>}</li>)}
      </ul>
    </div>
    {!clientsLabel && <div class="cr-stats">
      {stats.map((s) => <StatCounter value={statValue(s, listedCount)} suffix={s.suffix} label={s.label} placeholder={s.placeholder} />)}
    </div>}
  </div>
</section>
<style>
  .cr { --stat-color: var(--ink); background: var(--sage); }
  .cr-grid { display: grid; gap: var(--s-8); }
  .cr-grid :global(.eyebrow) { margin: 0 0 var(--s-4); }
  .cr-grid > :global(.eyebrow) { margin-bottom: calc(var(--s-4) - var(--s-8)); }
  .cr-list { margin: 0; padding: 0; list-style: none; display: grid; border-bottom: 1px solid var(--line); }
  .cr-list li { padding: var(--s-3) 0; border-top: 1px solid var(--line); }
  .nw { white-space: nowrap; } /* the last word keeps its Draft mark */
  /* The roster: names in the practical sans, two to a row from small phones up; rows share one line. */
  .cr-clients { column-gap: var(--s-5); font: 400 clamp(1rem, .9rem + .4vw, 1.25rem)/1.3 var(--font-text); letter-spacing: -.005em; }
  .cr-awards { font-size: var(--fs-small); line-height: 1.45; color: var(--text-2); }
  /* The figures, small and secondary, on a hairline. */
  .cr-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); padding-top: var(--s-5); border-top: 1px solid var(--ink); }
  .cr-stats :global(.stat-num) { font-size: clamp(1.5rem, 1.25rem + .8vw, 2rem); }
  .cr-stats :global(.stat-label) { margin-top: var(--s-1); }
  @media (min-width: 360px) { .cr-clients { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Phones: a tighter page, so the imprint stays about a screen tall. */
  @media (max-width: 767px) {
    .cr-grid { gap: var(--s-7); }
    .cr-list li { padding: var(--s-2) 0; }
    .cr-clients { font-size: .9375rem; }
  }
  @media (min-width: 1024px) {
    .cr-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s-5); row-gap: var(--s-8); }
    .cr-roster { grid-column: 1 / 8; }
    .cr-honours { grid-column: 9 / 13; }
    .cr-stats, .cr-grid > :global(.eyebrow) { grid-column: 1 / 13; }
    .cr-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (min-width: 1280px) { .cr-clients { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
