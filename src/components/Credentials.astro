---
import Eyebrow from './ui/Eyebrow.astro';
import StatCounter from './ui/StatCounter.astro';
import T from './ui/T.astro';
import DraftTag from './ui/DraftTag.astro';
import { statValue } from '../lib/meta';
import type { UiString } from '../lib/strings';
// Direction B homepage: one quiet proof band (numbers, a line of clients as text, a line of awards)
// in place of the dark stats band and the logo marquee.
interface Props {
  stats: { id: string; value: number | 'listed-projects'; suffix?: string; label: string; placeholder: boolean }[];
  listedCount: number;
  clients: { id: string; name: string; placeholder: boolean }[];
  eyebrow: UiString;
  awards: UiString;
}
const { stats, listedCount, clients, eyebrow, awards } = Astro.props;
const clientsDraft = clients.some((c) => c.placeholder);
// After nationalgallery.sg's outlined "1926": the founding year (from the stats data), drawn large behind.
const founded = stats.find((s) => s.id === 'founded' && typeof s.value === 'number')?.value;
---
<section class="cr section" aria-labelledby="cr-title">
  {founded && <p class="cr-year" aria-hidden="true">{founded}</p>}
  <div class="wrap">
    <Eyebrow as="h2" id="cr-title"><T s={eyebrow} /></Eyebrow>
    <div class="cr-stats">
      {stats.map((s) => <StatCounter value={statValue(s, listedCount)} suffix={s.suffix} label={s.label} placeholder={s.placeholder} />)}
    </div>
    <p class="cr-clients" data-placeholder={clientsDraft ? '' : undefined}>{clients.map((c) => c.name).join(' · ')}<DraftTag when={clientsDraft} /></p>
    <p class="cr-awards"><T s={awards} /></p>
  </div>
</section>
<style>
  .cr { --stat-color: var(--ink); position: relative; overflow: hidden; background: var(--sage); }
  .cr > .wrap { position: relative; }
  .cr-year { position: absolute; right: -.04em; bottom: -.18em; margin: 0; font: 800 clamp(8rem, 4rem + 22vw, 26rem)/1 var(--font-display); letter-spacing: -.05em; color: transparent; -webkit-text-stroke: 1.5px rgb(51 51 51 / .28); pointer-events: none; user-select: none; }
  .cr-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-7) var(--s-6); margin: var(--s-7) 0 var(--s-9); }
  .cr-clients { margin: 0; max-width: 62ch; font: 400 var(--fs-lead)/1.6 var(--font-text); }
  .cr-awards { margin: var(--s-6) 0 0; max-width: 70ch; font-size: var(--fs-label); line-height: 1.8; letter-spacing: 0; color: var(--text-2); }
  @media (min-width: 1024px) { .cr-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
