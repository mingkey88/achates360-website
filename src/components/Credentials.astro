---
import Eyebrow from './ui/Eyebrow.astro';
import StatCounter from './ui/StatCounter.astro';
import T from './ui/T.astro';
import RunningHead from './ui/RunningHead.astro';
import DraftTag from './ui/DraftTag.astro';
import { statValue } from '../lib/meta';
import { withBase } from '../lib/paths';
import { Image } from 'astro:assets';
import { AWARDS } from '../lib/awards';
import type { UiString } from '../lib/strings';
// Direction B homepage: the imprint page, straight after the selected work. The clients as a wall of their
// logos (the persuasion a bank or hotel looks for; the studio's own logo set, one ink colour, each named
// for screen readers), the awards as a wall of their seals (lib/awards), and the figures small beneath,
// as a book's imprint sets its particulars. All wording verbatim: the awards are
// the supplied line split at its " · " separators. One Draft mark per list, as each is one approval.
// On the homepage the section heading ("Trusted by") is the section head over the page and
// the figures close it; on About the heading ("In numbers") heads the figures, which come first, and the
// roster gets its own label.
interface Props {
  stats: { id: string; value: number | 'listed-projects'; suffix?: string; label: string; placeholder: boolean }[];
  listedCount: number;
  clients: { id: string; name: string; logo: string; ratio: number; placeholder: boolean }[];
  eyebrow: UiString;
  awards: UiString;
  awardsLabel: UiString;
  clientsLabel?: UiString;
  orangeFigures?: boolean; // the figures in the text orange (About)
}
const { stats, listedCount, clients, eyebrow, awards, awardsLabel, clientsLabel, orangeFigures = false } = Astro.props;
const clientsDraft = clients.some((c) => c.placeholder);
const awardList = awards.text.split(' · ').map((a) => a.trim()).filter(Boolean);
// The awards as their seals (lib/awards): only the awards that have one are shown.
const seals = awardList.flatMap((name) => { const badge = AWARDS[name]?.badge; return badge ? [{ name, badge }] : []; });
// Each logo (trimmed to its artwork; ratio = its width over height) gets the same visual weight: the same
// area in its cell, so a wordmark runs wide and low and a crest stands small and square, within limits (no
// wider than 80% of the cell, no taller than 58% of it). Width as a share of the cell's width.
const CELL_H = .62; // the cell's height over its width
const logoWidth = (r: number) => Math.min(Math.sqrt(.12 * r), .8, .58 * CELL_H * r);
---
<section class:list={['cr', 'section', { 'cr-orange': orangeFigures }]} aria-labelledby="cr-title">
  <div class="wrap cr-grid">
    {clientsLabel ? <Eyebrow as="h2" id="cr-title"><T s={eyebrow} /></Eyebrow> : <RunningHead id="cr-title" s={eyebrow} />}
    {/* The figures: first (in reading order too) on About, under its "In numbers" heading; last on Home. */}
    {clientsLabel && <div class="cr-stats">
      {stats.map((s) => <StatCounter value={statValue(s, listedCount)} suffix={s.suffix} label={s.label} placeholder={s.placeholder} />)}
    </div>}
    <div class:list={['cr-roster', { 'no-label': !clientsLabel }]}>
      {clientsLabel && <Eyebrow as="h3"><T s={clientsLabel} /></Eyebrow>}
      <ul class="cr-logos" data-placeholder={clientsDraft ? '' : undefined}>
        {clients.map((c) => <li><span class="cr-logo" role="img" aria-label={c.name} style={`--logo: url("${withBase(`/clients/${c.logo}`)}"); --w: ${(logoWidth(c.ratio) * 100).toFixed(1)}%; --ar: ${c.ratio}`}></span></li>)}
      </ul>
      {clientsDraft && <p class="cr-draft"><DraftTag when /></p>}
    </div>
    <div class="cr-honours">
      <Eyebrow as="h3"><T s={awardsLabel} /></Eyebrow>
      <ul class="aw-seals" data-placeholder={awards.placeholder ? '' : undefined}>
        {seals.map((a) => <li><Image src={a.badge} alt={a.name} title={a.name} width={a.badge.width} /></li>)}
      </ul>
      <DraftTag when={awards.placeholder} />
    </div>
    {!clientsLabel && <div class="cr-stats">
      {stats.map((s) => <StatCounter value={statValue(s, listedCount)} suffix={s.suffix} label={s.label} placeholder={s.placeholder} />)}
    </div>}
  </div>
</section>
<script>
  for (const wall of document.querySelectorAll<HTMLElement>('.cr-logos')) {
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { wall.classList.add('is-near'); io.disconnect(); } }, { rootMargin: '100% 0px' });
    io.observe(wall);
  }
</script>
<style>
  .cr { --stat-color: var(--ink); background: var(--sage); }
  /* About's figures were orange; on the sage ground orange measures 2.6:1, under the 3:1 even large type
     needs, so they are ink like the homepage's (review, 24 Oct 2026; CONTENT-QUERIES 66). */
  .cr-orange { --stat-color: var(--ink); }
  .cr-grid { display: grid; gap: var(--s-8); }
  .cr-grid :global(.eyebrow) { margin: 0 0 var(--s-4); }
  .cr-grid > :global(.eyebrow) { margin-bottom: calc(var(--s-4) - var(--s-8)); }
  .cr-grid > :global(.rh) { margin-bottom: calc(var(--s-2) - var(--s-8)); }
  .nw { white-space: nowrap; } /* the last word keeps its Draft mark */
  /* The logo wall: each logo's white artwork used as a mask over the ink, so every brand is set in the one
     colour, centred in its cell at its balanced size (logoWidth). Three to
     a row on phones (eleven rows), six on tablets, eleven on wide screens (three rows); a short last row is
     centred. */
  .cr-logos { --n: 3; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; border-bottom: 1px solid var(--line); }
  .cr-logos li { flex: 0 0 calc(100% / var(--n)); display: grid; place-items: center; aspect-ratio: 1 / .62; }
  .cr-logo {
    display: block; width: var(--w); aspect-ratio: var(--ar); background: var(--ink); opacity: .82;
    -webkit-mask: var(--logo) center / 100% 100% no-repeat; mask: var(--logo) center / 100% 100% no-repeat;
  }
  .cr-draft { margin: var(--s-2) 0 0; text-align: right; }
  /* The wall is far down the page: its 33 logo files load only when it nears the screen (the script below
     adds .is-near), so they do not compete with the hero film. The cells keep their size meanwhile, so
     nothing moves; without JavaScript the logos load at once. */
  @media (min-width: 640px) { .cr-logos { --n: 6; } }
  @media (min-width: 1200px) { .cr-logos { --n: 11; } }
  :global(html.js) .cr-logos:not(.is-near) .cr-logo { -webkit-mask: none; mask: none; background: transparent; }
  /* The awards as a row of seals, each on a white card (the seals were made for white). The seal files
     are about 200px tall, so a seal is shown at no more than about 100px, where it stays sharp. */
  .aw-seals { --n: 2; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--s-3); }
  .aw-seals li { display: flex; align-items: center; justify-content: center; aspect-ratio: 1; max-height: 124px; padding: 12%; overflow: hidden; background: var(--white); }
  .aw-seals :global(img) { display: block; width: auto; height: auto; max-width: 100%; max-height: 100%; min-width: 0; object-fit: contain; }
  @media (min-width: 640px) { .aw-seals { --n: 5; } }
  @media (min-width: 1200px) { .aw-seals { --n: 10; } }
  /* The figures, small and secondary, on a hairline. */
  .cr-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); padding-top: var(--s-5); border-top: 1px solid var(--ink); }
  .cr-stats :global(.stat-num) { font-size: clamp(1.5rem, 1.25rem + .8vw, 2rem); }
  .cr-stats :global(.stat-label) { margin-top: var(--s-1); }
  /* Phones: a tighter page, so the imprint stays about a screen tall. */
  @media (max-width: 767px) {
    .cr-grid { gap: var(--s-7); }
    .cr-grid > :global(.rh) { margin-bottom: calc(var(--s-2) - var(--s-7)); }
  }
  @media (min-width: 1024px) {
    .cr-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s-5); row-gap: var(--s-8); }
    .cr-roster, .cr-honours { grid-column: 1 / 13; }
    .cr-stats, .cr-grid > :global(.eyebrow), .cr-grid > :global(.rh) { grid-column: 1 / 13; }
    .cr-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
