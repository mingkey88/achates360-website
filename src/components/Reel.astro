---
import Player from './Player.astro';
// The showreel (direction B): full width like the homepage's cover film, no words beside it. It keeps
// its player controls (a reel with sound, started by the visitor).
interface Props { src: string; poster: ImageMetadata; label: string }
const { src, poster, label } = Astro.props;
---
<section class="reel" aria-label={label}>
  <div class="reel-video" data-reveal><Player src={src} poster={poster} label={label} /></div>
</section>
<style>
  .reel { padding-block: var(--section-y); }
  .reel-video :global(:is(video, img)) { display: block; width: 100%; height: auto; border-radius: 0; }
</style>
