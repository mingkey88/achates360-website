---
import { withBase, menuCurrent } from '../lib/paths';
import type { UiString } from '../lib/strings';
import Logo from './ui/Logo.astro';
interface Link { label: string; href: string }
interface Props { menu: (Link & { items?: Link[] })[]; path: string; overHero: boolean; wordmark: UiString; menuLabel: UiString; navLabel: UiString; subLabel: UiString }
const { menu, path, overHero, wordmark, menuLabel, navLabel, subLabel } = Astro.props;
// Wide screens: one masthead row. The logo (which links home) is centred; the site's sections sit to
// its left in their menu order; Contact stands alone at the right as the one action. Home is left out
// of the bar (the logo is the way home) but stays in the full menu (Menu.astro).
const contact = menu.find((it) => it.href === '/contact');
const sections = menu.filter((it) => it.href !== '/' && it !== contact);
---
<header class="site-header" data-over-hero={overHero ? '' : undefined}>
  <div class="bar">
    <a class="wordmark" href={withBase('/')}><Logo label={wordmark.text} /></a>
    <nav class="primary" aria-label={navLabel.text}>
      <ul>
        {sections.map((it, i) => {
          const current = menuCurrent(it, path);
          const sub = it.items && it.items.length > 0;
          return (
            <li class:list={{ 'has-sub': sub }}>
              <a href={withBase(it.href)} aria-current={current === 'page' ? 'page' : undefined} data-current={current ?? undefined}>{it.label}</a>
              {sub && (
                <>
                  {/* A disclosure, not an ARIA menu: the button opens a plain list of links. Hover opens it too. */}
                  <button class="sub-toggle" type="button" aria-expanded="false" aria-controls={`nav-sub-${i}`} aria-label={`${subLabel.text}: ${it.label}`} data-placeholder={subLabel.placeholder ? '' : undefined}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                  </button>
                  <ul class="sub" id={`nav-sub-${i}`}>
                    {it.items!.map((s) => <li><a href={withBase(s.href)} aria-current={s.href === path ? 'page' : undefined}>{s.label}</a></li>)}
                  </ul>
                </>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
    <div class="actions">
      {contact && <a class="contact" href={withBase(contact.href)} aria-current={path === contact.href ? 'page' : undefined}>{contact.label}</a>}
      <button class="menu-open" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="site-menu">
        <span class="sr-only">{menuLabel.text}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9h18M9 15h12" /></svg>
      </button>
    </div>
  </div>
</header>
<script>
  // Solid after 80px of scroll (or always, without a hero), and condensed to a running head on wide
  // screens; hides while scrolling down, returns on scroll up or when anything in it takes keyboard focus.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    // A page can hold its content still for a stretch of scroll while a cover slides away (motion/cover.ts
    // sets html[data-scroll-hold] to "start:end" in scroll pixels); the header leaves that stretch out.
    const held = () => {
      const [s = 0, e = 0] = (document.documentElement.dataset.scrollHold ?? '').split(':').map(Number);
      return { s, e };
    };
    const scrolled = () => { const y = window.scrollY, { s, e } = held(); return Math.max(0, y - Math.min(Math.max(y - s, 0), Math.max(e - s, 0))); };
    let last = scrolled();
    const update = () => {
      const y = scrolled();
      header.classList.toggle('is-solid', y > 80 || !header.hasAttribute('data-over-hero'));
      header.classList.toggle('is-condensed', y > 80);
      header.classList.toggle('is-hidden', y > last && y > 240 && !header.contains(document.activeElement));
      last = y;
    };
    window.addEventListener('scroll', update, { passive: true });
    header.addEventListener('focusin', () => header.classList.remove('is-hidden'));
    update();
  }

  // Category dropdowns: the toggle opens/closes; Escape or a click elsewhere closes.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.sub-toggle')) {
    const li = btn.closest('li')!;
    const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); li.classList.toggle('is-open', open); };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    li.addEventListener('keydown', (e) => { if (e.key === 'Escape' && li.classList.contains('is-open')) { set(false); btn.focus(); } });
    // A menu opened by hovering closes on Escape too, and stays shut until the pointer leaves.
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && li.matches(':hover')) li.classList.add('is-dismissed'); });
    li.addEventListener('mouseleave', () => li.classList.remove('is-dismissed'));
    document.addEventListener('click', (e) => { if (!li.contains(e.target as Node)) set(false); });
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) set(false); });
  }
</script>
<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 50; padding-top: env(safe-area-inset-top, 0px);
    color: var(--ink); transition: transform .35s var(--ease-out), background-color .25s, color .25s, box-shadow .25s;
  }
  .site-header[data-over-hero]:not(.is-solid) { color: var(--white); }
  .site-header.is-solid { background: var(--paper); box-shadow: 0 1px 0 var(--line); }
  .site-header.is-hidden { transform: translateY(-100%); }
  .bar { display: flex; align-items: center; gap: var(--s-5); height: var(--header-h); padding-inline: var(--gutter); transition: height .4s var(--ease-out); }
  .wordmark { flex: none; margin-right: auto; display: flex; padding-block: 4px; }
  /* The wordmark's letters are fine strokes: at 46px they were ~9px tall and anti-aliased soft on
     standard screens. Larger, in the deeper ink, they stay crisp. */
  .wordmark :global(.logo) { display: block; height: 44px; width: auto; shape-rendering: geometricPrecision; transition: height .4s var(--ease-out); }
  .site-header:is(:not([data-over-hero]), .is-solid) .wordmark { color: var(--teal-ink); }
  @media (min-width: 768px) { .wordmark :global(.logo) { height: 48px; } }

  .primary ul { display: none; list-style: none; margin: 0; padding: 0; }
  /* site.md's labels are capitals (verbatim); Aesop sets navigation in sentence case, so they display as such. */
  .primary a, .contact {
    position: relative; display: inline-block; padding-block: 8px; font-size: var(--fs-small); font-weight: 400;
    letter-spacing: .02em; text-decoration: none; text-transform: lowercase; color: inherit;
  }
  .primary a::first-letter, .contact::first-letter { text-transform: uppercase; }
  /* A hairline draws in from the left on hover; the current section keeps it. */
  .primary > ul > li > a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: right; transition: transform .45s var(--ease-out);
  }
  .primary > ul > li > a:is(:hover, :focus-visible, [data-current])::after { transform: scaleX(1); transform-origin: left; }
  /* The current section: a thick bar of the brand orange, as a selected tab's marker (after nationalgallery.sg). */
  .primary > ul > li > a[data-current]::after { height: 3px; bottom: 1px; background: var(--accent); }

  .actions { display: flex; align-items: center; gap: var(--s-3); }
  /* Contact: the one framed action, a hairline box like the site's buttons. */
  .contact { display: none; padding: 9px 18px; border: 1px solid currentColor; transition: background-color .25s, color .25s; }
  .contact:hover, .contact[aria-current] { background: var(--ink); color: var(--paper); }
  .site-header[data-over-hero]:not(.is-solid) .contact:hover { background: var(--white); color: var(--ink); }
  .menu-open { display: grid; place-items: center; width: 44px; height: 44px; margin-right: -10px; padding: 0; border: 0; background: none; color: inherit; cursor: pointer; }
  .menu-open svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.4; }
  .menu-open path { transition: d .35s var(--ease-out); }
  .menu-open:hover path { d: path('M3 9h18M3 15h18'); }
  .site-header[data-over-hero]:not(.is-solid) :focus-visible { outline-color: var(--white); }

  /* Wide screens: one masthead row, sections | logo | contact. Every page is already in the bar (the
     logo is Home, the footer has the social links), so the full menu is for narrower screens only.
     Once scrolled it condenses to a running head: the bar and the logo shrink. */
  @media (min-width: 1024px) {
    .bar { display: grid; grid-template-columns: 1fr auto 1fr; column-gap: var(--s-6); }
    .wordmark { grid-column: 2; grid-row: 1; margin: 0; justify-self: center; }
    .wordmark :global(.logo) { height: 56px; }
    .primary { grid-column: 1; grid-row: 1; justify-self: start; }
    .primary > ul { display: flex; align-items: center; gap: var(--s-6); }
    .primary .sub { display: block; }
    .actions { grid-column: 3; grid-row: 1; justify-self: end; gap: var(--s-4); }
    .contact { display: inline-block; }
    .menu-open { display: none; }
    .is-condensed .bar { height: 64px; }
    .is-condensed .wordmark :global(.logo) { height: 48px; } /* not smaller: the wordmark softens below ~46px */
  }

  .has-sub { position: relative; display: flex; align-items: center; gap: 0; }
  .sub-toggle { display: grid; place-items: center; width: 24px; height: 32px; padding: 0; border: 0; background: none; color: inherit; cursor: pointer; }
  .sub-toggle svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.4; transition: rotate .3s var(--ease-out); }
  .is-open .sub-toggle svg, .has-sub:hover .sub-toggle svg { rotate: 180deg; }
  /* The dropdown: a sheet of the same paper, framed by a hairline (no soft shadow), set left under its label. */
  .sub {
    position: absolute; left: 0; top: calc(100% + 10px); z-index: 2; min-width: 280px; max-height: min(70vh, 560px); overflow-y: auto;
    margin: 0; padding: var(--s-3) 0; list-style: none;
    background: var(--paper); border: 1px solid var(--line); color: var(--ink);
    opacity: 0; visibility: hidden; translate: 0 -4px; transition: opacity .25s, translate .35s var(--ease-out), visibility 0s .25s;
  }
  /* Bridges the gap between the label and the sheet so hovering across it keeps the menu open. */
  .sub::before { content: ''; position: absolute; inset: -11px 0 auto; height: 11px; }
  .has-sub:hover .sub, .has-sub.is-open .sub { opacity: 1; visibility: visible; translate: none; transition-delay: 0s; }
  .has-sub.is-dismissed:hover:not(.is-open) .sub { opacity: 0; visibility: hidden; }
  .sub a { display: block; padding: 9px var(--s-5); font-size: var(--fs-small); letter-spacing: 0; text-decoration: none; text-transform: none; white-space: nowrap; transition: padding-left .3s var(--ease-out), color .2s; color: var(--text-2); }
  .sub a::first-letter { text-transform: none; }
  .sub a:is(:hover, :focus-visible, [aria-current]) { padding-left: calc(var(--s-5) + 6px); color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { .site-header, .bar, .sub, .sub a, .sub-toggle svg, .wordmark :global(.logo), .primary a::after, .menu-open path { transition: none; } }
</style>
