---
import Pic from './ui/Pic.astro';
import DraftTag from './ui/DraftTag.astro';
import T from './ui/T.astro';
import Amp from './ui/Amp.astro';
import { withBase } from '../lib/paths';
import type { UiString } from '../lib/strings';
// One service as an open book's spread (direction B, Services page). The left page carries the words:
// the number, the service's name, its description and what it covers (its project categories, each a
// link to the category page with its count). The right page carries one picture from a project in
// it, captioned like a plate. A hairline down the middle is the fold. Spreads alternate as a book's
// pages do: every second one (a verso) mirrors, the picture on the left page and the words on the
// right; pictures sit against the page's outer edge, and the folio at the outer corner.
// Under the categories, three more of its projects as small plates (more). Words lead and the work
// supports: the full work lives on the Projects pages.
interface Props {
  index: number; total: number; coversLabel: UiString; moreLabel: UiString;
  more: { no: number; title: string; href: string; thumb: ImageMetadata; position?: string }[];
  service: { id: string; title: string; body: string; placeholder: boolean };
  covers: { heading: string; href: string; count: number }[];
  plate: { image: ImageMetadata; title: string; client: string; href: string };
}
const { index, total, coversLabel, moreLabel, more, service, covers, plate } = Astro.props;
const no = (n: number) => String(n).padStart(2, '0');
---
<section class:list={['spread', 'wrap', { verso: index % 2 === 1 }]} id={service.id} aria-labelledby={`${service.id}-t`}>
  <div class="sp-pages">
    <div class="sp-left">
      <p class="sp-no" aria-hidden="true">{no(index + 1)}</p>
      <h2 class="sp-title" id={`${service.id}-t`} data-placeholder={service.placeholder ? '' : undefined}><Amp text={service.title} /></h2>
      <p class="sp-body" data-placeholder={service.placeholder ? '' : undefined}>{service.body}<DraftTag when={service.placeholder} /></p>
      <div class="sp-covers">
        <p class="sp-label"><T s={coversLabel} /></p>
        <ul>
          {covers.map((c) => <li><a href={withBase(c.href)}><span>{c.heading}</span><span class="sp-n">{c.count}</span></a></li>)}
        </ul>
      </div>
      {more.length > 0 && (
        <div class="sp-more">
          <p class="sp-label"><T s={moreLabel} /></p>
          <ul>
            {more.map((m) => (
              <li><a href={withBase(m.href)}>
                <span class="sp-thumb"><Pic src={m.thumb} alt="" crop={4 / 3} widths={[240, 360, 480]} sizes="(max-width: 899px) 30vw, 12vw" position={m.position} loading="lazy" /></span>
                <span class="sp-mt">{m.title.trim()}</span>
                <span class="sp-mn" aria-hidden="true">№ {String(m.no).padStart(3, '0')}</span>
              </a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
    <figure class="sp-right">
      <a class="sp-pic" href={withBase(plate.href)} tabindex="-1" aria-hidden="true"><Pic src={plate.image} alt="" crop={4 / 5} mobileCrop={4 / 3} widths={[480, 720, 960, 1280]} mobileWidths={[400, 600, 800]} sizes="40vw" mobileSizes="calc(100vw - 32px)" /></a>
      <figcaption><a href={withBase(plate.href)}>{plate.title}</a><span>{plate.client}</span></figcaption>
    </figure>
  </div>
  <p class="sp-folio" aria-hidden="true">{no(index + 1)} / {no(total)}</p>
</section>
<style>
  .spread { padding-block: var(--s-6) var(--s-5); }
  .sp-pages { display: grid; gap: var(--s-7); border-top: 1px solid var(--ink); padding-top: var(--s-6); }
  .sp-no { margin: 0 0 var(--s-4); font: 400 clamp(3rem, 2rem + 4vw, 6.5rem)/.9 var(--font-display); letter-spacing: -.04em; color: var(--accent); font-variant-numeric: tabular-nums; }
  .sp-title { margin: 0 0 var(--s-4); font: 400 var(--fs-h1)/1.1 var(--font-display); letter-spacing: -.02em; text-wrap: balance; }
  .sp-body { margin: 0 0 var(--s-6); max-width: 38ch; font-size: var(--fs-lead); line-height: 1.5; color: var(--text-2); }
  .sp-label { margin: 0 0 var(--s-2); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--text-2); }
  .sp-covers ul { list-style: none; margin: 0; padding: 0; max-width: 480px; border-top: 1px solid var(--line); }
  .sp-covers a { display: flex; justify-content: space-between; gap: var(--s-4); padding-block: 10px; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; transition: padding-left .3s var(--ease-out); }
  .sp-covers a:hover { padding-left: 6px; }
  .sp-covers a:hover span:first-child { text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px; }
  .sp-n { font-size: var(--fs-small); color: var(--text-2); font-variant-numeric: tabular-nums; }
  /* More in this service: three small plates in a row, each with its title and catalogue number. */
  .sp-more { margin-top: var(--s-7); max-width: 480px; }
  .sp-more ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); }
  .sp-more a { display: grid; gap: var(--s-2); color: inherit; text-decoration: none; }
  .sp-thumb { display: block; overflow: hidden; background: var(--stone); }
  .sp-thumb :global(img) { display: block; width: 100%; height: auto; transition: scale 1.2s var(--ease-out); }
  .sp-more a:hover :global(img) { scale: 1.04; }
  .sp-mt { font-size: .8125rem; line-height: 1.35; overflow-wrap: anywhere; }
  .sp-more a:hover .sp-mt { text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px; }
  .sp-mn { font-size: .6875rem; color: var(--text-2); font-variant-numeric: tabular-nums; }
  .sp-right { margin: 0; }
  .sp-pic { display: block; overflow: hidden; background: var(--stone); }
  .sp-pic :global(img) { display: block; width: 100%; height: auto; transition: scale 1.2s var(--ease-out); }
  .sp-pic:hover :global(img) { scale: 1.03; }
  figcaption { display: flex; justify-content: space-between; gap: var(--s-4); padding-top: var(--s-2); font-size: var(--fs-small); }
  figcaption a { color: inherit; text-decoration: none; }
  figcaption a:hover { text-decoration: underline; text-underline-offset: .2em; }
  figcaption span { color: var(--text-2); text-align: right; }
  .sp-folio { margin: var(--s-5) 0 0; text-align: center; font-size: .75rem; letter-spacing: .08em; color: var(--text-2); font-variant-numeric: tabular-nums; }
  /* Tablets (one column): the picture held to a plate's size, not the full width. */
  @media (min-width: 768px) and (max-width: 899px) { .sp-right { width: min(100%, 460px); } }
  /* Wide screens: two pages with the fold between them. */
  @media (min-width: 900px) {
    .sp-pages { grid-template-columns: 1fr 1fr; gap: 0; background: linear-gradient(var(--line), var(--line)) 50% 0 / 1px 100% no-repeat; }
    .sp-left { grid-column: 1; grid-row: 1; padding-right: var(--s-8); }
    /* The picture is held to the screen's height (less the header and caption), so a spread fits one
       screen, and set against the page's outer edge. */
    .sp-right { grid-column: 2; grid-row: 1; justify-self: end; align-self: start; width: min(calc(100% - var(--s-8)), calc((100svh - var(--header-h) - 200px) * .8)); }
    .sp-folio { text-align: right; }
    /* Verso: mirrored. */
    .verso .sp-left { grid-column: 2; padding-right: 0; padding-left: var(--s-8); }
    .verso .sp-right { grid-column: 1; justify-self: start; }
    .verso .sp-folio { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) { .sp-pic :global(img), .sp-thumb :global(img), .sp-covers a { transition: none; } }
</style>
