---
import { splitLastWord } from '../lib/copy';
import RunningHead from './ui/RunningHead.astro';
import Pill from './ui/Pill.astro';
import Amp from './ui/Amp.astro';
import T from './ui/T.astro';
import DraftTag from './ui/DraftTag.astro';
import { withBase } from '../lib/paths';
import type { UiString } from '../lib/strings';
// Direction B homepage: the service groups as the Services book's contents page (ServicesContents):
// each a numbered line, its name, a dotted leader to the number of listed projects it covers, linking to
// its spread on /services. The same typographic system on both pages; no pictures here.
interface Service { id: string; title: string; placeholder: boolean; count: number }
interface Props { services: Service[]; eyebrow: UiString; cta: UiString; countLabel: UiString; folio: string }
const { services, eyebrow, cta, countLabel, folio } = Astro.props;
---
<section class="si section" aria-labelledby="si-title">
  <div class="wrap">
    <RunningHead id="si-title" s={eyebrow} folio={folio} />
    <ol class="si-list">
      {services.map((s, i) => (
        <li data-placeholder={s.placeholder ? '' : undefined}>
          <a class="si-link" href={withBase(`/services#${s.id}`)}>
            <span class="si-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {/* The title's last word and its Draft mark stay together, so the mark never wraps alone. */}
            <span class="si-title"><Amp text={splitLastWord(s.title)[0]} /><span class="si-last">{splitLastWord(s.title)[1]}<DraftTag when={s.placeholder} /></span></span>
            <span class="si-dots" aria-hidden="true"></span>
            <span class="si-n">{s.count}<span class="sr-only"> {countLabel.text.toLowerCase()}</span></span>
          </a>
        </li>
      ))}
    </ol>
    <Pill href="/services"><T s={cta} /></Pill>
  </div>
</section>
<style>
  .si { background: var(--stone); }
  .si-list { list-style: none; margin: 0 0 var(--s-8); padding: 0; }
  .si-link {
    display: grid; grid-template-columns: 3.5rem auto minmax(2rem, 1fr) 3rem; align-items: baseline; column-gap: var(--s-3);
    padding-block: var(--s-5); border-bottom: 1px solid var(--line); color: inherit; text-decoration: none;
  }
  .si-num { font-size: var(--fs-small); font-variant-numeric: tabular-nums; color: var(--text-2); }
  .si-last { white-space: nowrap; }
  .si-title { font: 400 clamp(1.5rem, 1rem + 2vw, 2.75rem)/1.1 var(--font-display); letter-spacing: -.02em; transition: translate .4s var(--ease-out); }
  /* Dot leaders, as on the Services contents page. */
  .si-dots { align-self: end; height: 1px; margin-bottom: .55em; background: radial-gradient(circle, var(--text-2) .9px, transparent 1.1px) 0 50% / 8px 2px repeat-x; opacity: .7; }
  .si-n { justify-self: end; font: 400 var(--fs-lead)/1 var(--font-display); font-variant-numeric: tabular-nums; }
  .si-link:hover .si-title, .si-link:focus-visible .si-title { translate: 10px 0; }
  .si-link:hover .si-n { color: var(--accent-deep); }
  @media (max-width: 767px) {
    .si-link { grid-template-columns: 2rem minmax(0, 1fr) 2.5rem; }
    .si-dots { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .si-title { transition: none; } }
</style>
