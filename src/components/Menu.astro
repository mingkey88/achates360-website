---
import SocialIcon from './ui/SocialIcon.astro';
import { withBase, linkAttrs, menuCurrent } from '../lib/paths';
import type { UiString } from '../lib/strings';
interface Link { label: string; href: string }
interface Props { menu: (Link & { items?: Link[] })[]; social: { alt: string; href: string }[]; path: string; menuLabel: UiString; closeLabel: UiString; navLabel: UiString }
const { menu, social, path, menuLabel, closeLabel, navLabel } = Astro.props;
---
<dialog id="site-menu" class="site-menu on-dark" aria-label={menuLabel.text}>
  <div class="inner wrap">
    <button class="menu-close" type="button">
      <span class="sr-only">{closeLabel.text}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
    </button>
    <nav aria-label={navLabel.text}>
      <ul class="top">
        {/* The main pages only: the project categories are the tabs on /projects (client, 26 Oct 2026). */}
        {menu.map((it) => <li><a class="big" href={withBase(it.href)} aria-current={menuCurrent(it, path) === 'page' ? 'page' : undefined}>{it.label}</a></li>)}
      </ul>
    </nav>
    {social.length > 0 && (
      <ul class="social">{social.map((s) => <li><a href={withBase(s.href)} {...linkAttrs(s.href)} aria-label={s.alt} title={s.alt}><SocialIcon name={s.alt} /></a></li>)}</ul>
    )}
  </div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#site-menu');
  const opener = document.querySelector<HTMLButtonElement>('.menu-open');
  if (dialog && opener) {
    opener.addEventListener('click', () => { dialog.showModal(); opener.setAttribute('aria-expanded', 'true'); });
    dialog.querySelector('.menu-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => { opener.setAttribute('aria-expanded', 'false'); opener.focus(); });
    // An in-page link (e.g. /#contact while on the homepage) must close the menu too.
    dialog.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) dialog.close(); });
  }
</script>
<style>
  .site-menu {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0; overflow-y: auto; overscroll-behavior: contain;
  }
  .site-menu::backdrop { background: rgb(13 13 13 / .6); }
  .inner { display: grid; gap: var(--s-7); padding-block: calc(var(--header-h) + var(--s-6)) var(--s-8); }
  .menu-close {
    position: fixed; top: calc(10px + env(safe-area-inset-top, 0px)); right: var(--gutter);
    width: 44px; height: 44px; display: grid; place-items: center; padding: 0;
    border: 1.5px solid currentColor; border-radius: 50%; background: none; color: inherit; cursor: pointer;
  }
  .menu-close svg { width: 20px; height: 20px; stroke: currentColor; stroke-width: 1.8; }
  ul { list-style: none; margin: 0; padding: 0; }
  .top { display: grid; gap: var(--s-3); }
  /* The main links stand 44px tall at the smallest size (the type alone is about 34px). */
  .big { display: inline-block; min-height: 44px; padding-block: 5px; font: 400 clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem)/1.2 var(--font-display); text-decoration: none; overflow-wrap: anywhere; text-transform: lowercase; }
  .big::first-letter { text-transform: uppercase; }
  .big:hover, .big[aria-current] { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 8px; }
  /* The current page: a thick orange underline, the selected-tab marker of the header and the tabs. */
  .big[aria-current] { text-decoration-color: var(--accent); text-decoration-thickness: 4px; }
  /* Follow links as framed marks, as in the footer; each named for screen readers. */
  .social { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .social a { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid currentColor; color: inherit; transition: background-color .25s, color .25s; }
  .social a:hover, .social a:focus-visible { background: var(--paper); border-color: var(--paper); color: var(--ink); }
  .social :global(.social-icon) { width: 18px; height: 18px; fill: currentColor; }
</style>
