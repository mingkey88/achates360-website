---
import { withBase } from '../lib/paths';
import T from './ui/T.astro';
import type { UiString } from '../lib/strings';
// The projects' category dropdown (direction B): a disclosure button showing where you are, opening a
// plain list of links to every category page and the overview. Without JS the list shows open.
interface Props { label: UiString; current: string; all: { label: UiString; href: string }; categories: { heading: string; href: string; count: number }[]; path: string }
const { label, current, all, categories, path } = Astro.props;
---
<div class="picker" data-picker>
  <p class="picker-label" id="picker-label"><T s={label} /></p>
  <button class="picker-btn" type="button" aria-expanded="false" aria-controls="picker-list" aria-describedby="picker-label">
    <span>{current}</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
  </button>
  <ul class="picker-list" id="picker-list">
    <li><a href={withBase(all.href)} aria-current={all.href === path ? 'page' : undefined}><T s={all.label} /></a></li>
    {categories.map((c) => (
      <li><a href={withBase(c.href)} aria-current={c.href === path ? 'page' : undefined}><span>{c.heading}</span><span class="count">{c.count}</span></a></li>
    ))}
  </ul>
</div>
<script>
  for (const picker of document.querySelectorAll<HTMLElement>('[data-picker]')) {
    const btn = picker.querySelector<HTMLButtonElement>('.picker-btn')!;
    picker.classList.add('is-ready');
    const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); picker.classList.toggle('is-open', open); };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    picker.addEventListener('keydown', (e) => { if (e.key === 'Escape' && picker.classList.contains('is-open')) { set(false); btn.focus(); } });
    document.addEventListener('click', (e) => { if (!picker.contains(e.target as Node)) set(false); });
    picker.addEventListener('focusout', (e) => { if (!picker.contains(e.relatedTarget as Node)) set(false); });
  }
</script>
<style>
  .picker { position: relative; display: grid; gap: var(--s-2); width: min(100%, 380px); }
  .picker-label { margin: 0; font-size: var(--fs-small); color: var(--text-2); }
  .picker-btn {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); width: 100%; min-height: 52px; padding: 0 16px;
    border: 1px solid rgb(51 51 51 / .45); border-radius: 0; background: var(--paper); color: var(--ink); cursor: pointer;
    font: 400 var(--fs-body)/1.2 var(--font-text); text-align: left;
  }
  .picker-btn:hover { border-color: var(--ink); }
  .picker-btn svg { flex: none; width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; transition: rotate .3s var(--ease-out); }
  .is-open .picker-btn svg { rotate: 180deg; }
  .picker-list { margin: 0; padding: var(--s-2) 0; list-style: none; background: var(--paper); border: 1px solid var(--line); }
  /* With JS: a floating panel below the button. Without it the list simply shows. */
  .picker:not(.is-ready) .picker-btn { display: none; }
  .is-ready .picker-list {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 20; box-shadow: 0 18px 40px -18px rgb(0 0 0 / .25);
    opacity: 0; visibility: hidden; translate: 0 6px; transition: opacity .25s, translate .3s var(--ease-out), visibility 0s .25s;
  }
  .is-open .picker-list { opacity: 1; visibility: visible; translate: 0 0; transition-delay: 0s; }
  .picker-list a { display: flex; justify-content: space-between; gap: var(--s-4); padding: 11px 16px; color: inherit; text-decoration: none; font-size: var(--fs-small); }
  .picker-list a:hover, .picker-list a[aria-current] { background: var(--stone); }
  .picker-list a[aria-current] { font-weight: 500; }
  .count { color: var(--text-2); font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: reduce) { .picker-btn svg, .picker-list { transition: none; } }
</style>
