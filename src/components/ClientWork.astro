---
import Pic from './ui/Pic.astro';
import Pill from './ui/Pill.astro';
import T from './ui/T.astro';
import DraftTag from './ui/DraftTag.astro';
import RunningHead from './ui/RunningHead.astro';
import { withBase } from '../lib/paths';
import { morphName } from '../lib/morph';
import type { UiString } from '../lib/strings';
// The homepage's selected work, by client (client, 11 Nov 2026: "the site should be quieter in a way
// where every element has to mean something. less noise is better"; it replaces the stacked work cards
// and the sliding service cards). Each client is one picture and a ruled list of what the studio made
// for them: the project's name, its year and its disciplines, each row to its case study. The years show
// the "faithful friend"; the rows show the range of work, so there is no separate "what we do" section.
// The picture alternates sides down the page, left then right (client, 11 Nov 2026: "stagger the
// arrangement abit. left and right"). Nothing moves: no pin, no stack, no slide. The picture is the lead project's card picture and grows into
// that case study's hero as it opens (lib/morph).
interface Row { href: string; title: string; year: string; categories: string[] }
interface Group { name: string; draft: boolean; years: string; lead: { href: string; thumb: ImageMetadata; position?: string }; rows: Row[] }
interface Props { groups: Group[]; eyebrow: UiString; cta: UiString; count: number }
const { groups, eyebrow, cta, count } = Astro.props;
---
<section class="cw section" aria-labelledby="cw-title">
  <div class="wrap cw-in">
    <RunningHead s={eyebrow} id="cw-title" />
    {groups.map((g) => (
      <article class="cw-group">
        {/* The same page as its row below, so the picture link stays out of the tab order and the tree. */}
        <a class="cw-pic" href={withBase(g.lead.href)} tabindex="-1" aria-hidden="true" style={`view-transition-name: ${morphName(g.lead.href)}`}>
          <Pic src={g.lead.thumb} alt="" crop={3 / 2} widths={[640, 960, 1280, 1600]} sizes="(max-width: 1023px) calc(100vw - 32px), min(760px, 56vw)" position={g.lead.position} loading="lazy" />
        </a>
        <div class="cw-text">
          <header class="cw-head">
            <h3 class="cw-client">{g.name}<DraftTag when={g.draft} /></h3>
            <p class="cw-years">{g.years}</p>
          </header>
          <ul class="cw-list">
            {g.rows.map((r) => (
              <li>
                <a class="cw-row" href={withBase(r.href)}>
                  <span class="cw-line"><span class="cw-title">{r.title}</span><span class="cw-year">{r.year}</span></span>
                  <span class="cw-cats">{r.categories.join(', ')}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
    <div class="cw-cta"><Pill href="/projects"><T s={cta} /><span class="cw-count">({count})</span></Pill></div>
  </div>
</section>
<style>
  /* Above the hero the page holds beneath the studio's sentence (motion/curtain.ts), and on the paper,
     so the fading hero never shows through or over the work. */
  .cw { position: relative; z-index: 1; background: var(--paper); }
  .cw-in { display: grid; gap: var(--s-8); }
  .cw-group { display: grid; gap: var(--s-5); align-items: start; }
  .cw-pic { display: block; overflow: hidden; background: var(--stone); }
  .cw-pic :global(img) { display: block; width: 100%; height: auto; transition: scale 1.2s var(--ease-out); }
  .cw-group:has(a:hover) .cw-pic :global(img) { scale: 1.02; }
  .cw-text { display: grid; gap: var(--s-5); min-width: 0; }
  .cw-head { display: grid; gap: var(--s-1); }
  .cw-client { margin: 0; font: 400 var(--fs-h2)/1.1 var(--font-display); letter-spacing: -.02em; }
  .cw-years { margin: 0; font-size: var(--fs-small); color: var(--text-2); font-variant-numeric: tabular-nums; }
  .cw-list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .cw-row { display: grid; gap: 2px; padding-block: var(--s-3); border-top: 1px solid var(--line); color: inherit; text-decoration: none; }
  .cw-line { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-4); }
  .cw-title { font-size: clamp(1rem, .95rem + .25vw, 1.125rem); line-height: 1.3; overflow-wrap: anywhere; }
  .cw-year { flex: none; font-size: var(--fs-small); color: var(--text-2); font-variant-numeric: tabular-nums; }
  .cw-cats { font-size: var(--fs-small); line-height: 1.4; color: var(--text-2); }
  .cw-row:hover .cw-title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .cw-row:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .cw-cta { display: flex; justify-content: flex-start; }
  .cw-count { font-variant-numeric: tabular-nums; }
  @media (min-width: 1024px) {
    .cw-in { gap: var(--s-9); }
    .cw-in > :global(.rh) { margin-bottom: calc(var(--s-7) - var(--s-9)); }
    .cw-group { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--s-7); }
    /* Every second client mirrored: the list at the left, the picture at the right. */
    .cw-group:nth-of-type(even) { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .cw-group:nth-of-type(even) .cw-pic { order: 2; }
    .cw-cta { margin-top: calc(var(--s-7) - var(--s-9)); }
  }
  @media (prefers-reduced-motion: reduce) { .cw-pic :global(img) { transition: none; } }
</style>
