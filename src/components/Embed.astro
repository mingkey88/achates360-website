---
import { embedSrc } from '../lib/embed';
// A Vimeo or YouTube film. It plays muted and loops as soon as it loads (the iframe loads lazily, as it
// nears the screen), so the provider's end screen ("More from Achates 360") never appears; the player's
// own controls pause it or turn the sound on. Under reduced motion it is swapped, before it loads, for
// the plain player that waits for the play button.
interface Props { provider: 'vimeo' | 'youtube'; id: string; title?: string }
const { provider, id, title = 'Video' } = Astro.props;
---
<div class="embed">
  <iframe src={embedSrc(provider, id, true)} data-still={embedSrc(provider, id, false)} title={title} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
</div>
<script>
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const f of document.querySelectorAll<HTMLIFrameElement>('.embed iframe[data-still]')) f.src = f.dataset.still!;
  }
</script>
<style>
  .embed { position: relative; aspect-ratio: 16 / 9; background: var(--ink); border-radius: var(--r-card); overflow: hidden; }
  .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
