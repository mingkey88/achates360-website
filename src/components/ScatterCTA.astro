---
import Pic from './ui/Pic.astro';
import Pill from './ui/Pill.astro';
import T from './ui/T.astro';
import type { UiString } from '../lib/strings';
import { withBase } from '../lib/paths';
import { loadExtras } from '../lib/extras';
// The homepage's closing section (after kitpro-croma): project pictures start as one stacked pile in
// the middle and spread out to the edges as you scroll, revealing the call to action in the space they
// leave. A short run (130svh, phones 120): the pile starts already loosened, so no frame is empty paper,
// and the message arrives early. Motion: scripts/motion/scatter.ts (scrubbed to scroll inside a sticky stage). Without motion
// the pictures simply sit in their spread-out places with the message visible.
// Each picture links to its project; on desktop it can also be dragged around (scripts/pile.ts): a
// pencilled "Drag me" proof mark points at the first print, picked-up prints lift and settle at a tilt,
// and "Put them back" returns them.
interface Item { thumb: ImageMetadata; title: string; href?: string }
interface Props { items: Item[]; heading: UiString; blurb: string; cta: UiString; href: string }
const { items, heading, blurb, cta, href } = Astro.props;
// Spread-out places: x / y = centre in % of the stage, w = width in vw (desktop); m* the same for phones,
// where only the first six are used, above and below the message.
// The middle (about 30-70% across, 26-76% down) stays clear for the message; the pictures sit small
// around the edges and corners (desktop) or above and below it (phones).
const PLACES = [
  { x: 12, y: 22, w: 12, mx: 20, my: 11, mw: 28 },
  { x: 33, y: 12, w: 10, mx: 70, my: 8, mw: 24 },
  { x: 62, y: 11, w: 13, mx: 84, my: 23, mw: 20 },
  { x: 88, y: 24, w: 12, mx: 22, my: 88, mw: 26 },
  { x: 90, y: 60, w: 10, mx: 74, my: 90, mw: 28 },
  { x: 10, y: 64, w: 11, mx: 50, my: 80, mw: 18 },
  { x: 25, y: 88, w: 13 },
  { x: 58, y: 90, w: 11 },
  { x: 83, y: 87, w: 14 },
];
const pics = items.slice(0, PLACES.length).map((it, i) => ({ ...it, p: PLACES[i] }));
// The proof-mark note on the first print, and the link that puts moved prints back (pile.ts shows it).
const { text } = await loadExtras();
const hint = text('drag-hint');
const reset = text('drag-reset');
---
<section class="scta" aria-labelledby="scta-title" data-scatter>
  <div class="scta-stage">
    <ul class="scta-pics">
      {pics.map(({ thumb, title, href: to, p }, i) => (
        <li class:list={['pic crop', { 'desk-only': p.mx === undefined, 'cap-end': p.x > 60 }]} style={`--x: ${p.x}; --y: ${p.y}; --w: ${p.w}; --mx: ${p.mx ?? p.x}; --my: ${p.my ?? p.y}; --mw: ${p.mw ?? p.w}; --z: ${i}`}>
          {to ? (
            <a class="pic-link" href={withBase(to)} draggable="false">
              <Pic src={thumb} alt="" crop={4 / 3} widths={[320, 480, 640, 860]} sizes="(max-width: 767px) 28vw, 14vw" draggable="false" />
              <span class="pic-cap">{title} <span aria-hidden="true">&rarr;</span></span>
            </a>
          ) : (
            <Pic src={thumb} alt="" crop={4 / 3} widths={[320, 480, 640, 860]} sizes="(max-width: 767px) 28vw, 14vw" />
          )}
          {i === 0 && (
            <span class="drag-hint" aria-hidden="true">
              <svg viewBox="0 0 120 70" focusable="false"><path d="M112 58C96 62 78 58 66 46 56 36 60 22 70 20c10-2 14 10 6 18-10 10-32 14-52 6L8 38" /><path d="M8 38l11-2M8 38l6 9" /></svg>
              <span class="drag-hint-t"><T s={hint} /></span>
            </span>
          )}
        </li>
      ))}
    </ul>
    <div class="scta-msg" data-scatter-msg>
      <h2 id="scta-title"><T s={heading} /></h2>
      <p>{blurb}</p>
      <Pill href={href} variant="fill"><T s={cta} /></Pill>
      <button class="scta-reset" type="button" data-pile-reset hidden><T s={reset} /> <span aria-hidden="true">↺</span></button>
    </div>
  </div>
</section>
<style>
  /* Scroll room: the stage stays stuck for the section's extra height while the pile spreads. Only
     when the motion runs (motion-live): without it (reduced motion, or the script arriving after the
     3s fallback) there is nothing to scrub, so the section is one screen. */
  .scta { position: relative; }
  :global(html.motion-live) .scta { height: 130svh; }
  .scta-stage { position: sticky; top: var(--header-h); height: calc(100svh - var(--header-h)); overflow: hidden; }
  .scta-pics { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .pic {
    position: absolute; left: calc(var(--x) * 1% + var(--dx, 0px)); top: calc(var(--y) * 1% + var(--dy, 0px)); width: calc(var(--w) * 1vw);
    translate: -50% -50%; z-index: var(--z); background: var(--stone); --cm-len: 9px; --cm-gap: 5px;
  }
  .pic:is(:hover, :focus-within) { z-index: 30; }
  /* Loose prints: a picked-up print lifts off the table (a separate sheet, so it casts a shadow), and a
     dropped one settles at a slight tilt (--tilt, set by pile.ts). */
  .pic { rotate: var(--tilt, 0deg); transition: rotate .35s var(--ease-out), scale .25s var(--ease-out), filter .25s; }
  .pic.is-dragging { scale: 1.05; rotate: calc(var(--tilt, 0deg) - 1.5deg); filter: drop-shadow(0 14px 18px rgb(0 0 0 / .22)); transition: rotate .2s, scale .2s, filter .2s; }
  .scta.is-resetting .pic { transition: left .7s var(--ease-out), top .7s var(--ease-out), rotate .7s var(--ease-out); }
  /* The proof-mark note: pencilled in an editor's red beside the first print, pointing at it. Fine
     pointers only (touch scrolls the page, so its prints are not dragged); gone once anything is moved. */
  .drag-hint { position: absolute; left: calc(100% + 10px); top: 55%; display: flex; align-items: flex-end; gap: 2px; color: #c4361b; pointer-events: none; transition: opacity .4s; }
  .drag-hint svg { flex: none; width: 64px; max-width: none; height: auto; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .drag-hint-t { display: inline-block; margin-bottom: 30px; font: italic 500 1rem/1 var(--font-text); letter-spacing: .01em; rotate: -6deg; white-space: nowrap; }
  .drag-hint-t :global(.draft-tag) { font-style: normal; }
  .scta.was-moved .drag-hint { opacity: 0; }
  @media (hover: none), (pointer: coarse) { .drag-hint { display: none; } }
  /* Put them back: a small text link under the button, once a print has been moved. */
  .scta-reset { margin-top: calc(var(--s-2) - var(--s-6)); padding: var(--s-2) var(--s-3); border: 0; background: none; font: 400 var(--fs-small)/1 var(--font-text); color: var(--text-2); text-decoration: underline; text-underline-offset: .25em; cursor: pointer; }
  .scta-reset:hover { color: var(--ink); }
  .pic-link { display: block; color: inherit; text-decoration: none; cursor: grab; user-select: none; -webkit-user-drag: none; }
  .pic.is-dragging .pic-link { cursor: grabbing; }
  /* The project's name under the picture, below the crop marks, on hover or keyboard focus. */
  .pic-cap {
    position: absolute; top: calc(100% + var(--cm-len) + var(--cm-gap) + 6px); left: 0; width: max-content; max-width: 22ch;
    font: 500 var(--fs-small)/1.35 var(--font-text); color: var(--ink); opacity: 0; translate: 0 -4px; transition: opacity .25s, translate .25s var(--ease-out);
  }
  .cap-end .pic-cap { left: auto; right: 0; text-align: right; }
  .pic-link:is(:hover, :focus-visible) .pic-cap, .pic.is-dragging .pic-cap { opacity: 1; translate: none; }
  @media (hover: none) { .pic-cap { display: none; } }
  .pic :global(img) { display: block; width: 100%; aspect-ratio: 4 / 3; height: auto; object-fit: cover; }
  .pic::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: var(--grain); opacity: .14; mix-blend-mode: overlay; }
  /* The message stays above every picture, even one dragged over it, so the button is always reachable;
     only its text and button take the pointer, so pictures underneath can still be picked up. */
  .scta-msg {
    position: absolute; left: 50%; top: 50%; z-index: 10000; translate: -50% -50%; width: min(86vw, 560px);
    display: grid; justify-items: center; gap: var(--s-6); text-align: center; pointer-events: none;
  }
  .scta-msg > * { pointer-events: auto; }
  .scta-msg h2 { margin: 0; font: 400 var(--fs-h1)/1.15 var(--font-display); }
  .scta-msg p { margin: 0 0 var(--s-4); max-width: 44ch; font-size: var(--fs-lead); line-height: 1.6; color: var(--text-2); text-wrap: balance; }
  @media (max-width: 767px) {
    :global(html.motion-live) .scta { height: 120svh; }
    .pic { left: calc(var(--mx) * 1% + var(--dx, 0px)); top: calc(var(--my) * 1% + var(--dy, 0px)); width: calc(var(--mw) * 1vw); }
    .pic.desk-only { display: none; }
  }
</style>
<script>
  import { pile } from '../scripts/pile';
  pile();
</script>
